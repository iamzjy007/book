{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cVPU",
  "source_sha256": "7a29def7d0ca7162de1ca0dac80de31948f07453febca3fdbaecca7a14eca088",
  "reviewed": false,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第十二卷"
    },
    {
      "id": "p0002",
      "zh": "〔引言，1—2行；最初的几位凯撒，3—46行；强大的战士，47—61行；诡诈的王，62—87行；统辖广土的王，88—100行；可怕而卑鄙的王，101—125行；三王，126—130行；毁灭敬虔人的君王，131—153行；以孝敬著称的王子，154—161行；带来和平的王，162—183行；受尊崇的王，184—189行；另一位善战的王，190—204行；凯尔特战士，205—210行；以海为名的王，211—227行；三位统治者，228—242行；智慧而敬虔的王，243—270行；企图与赫拉克勒斯争胜的王，271—289行；罗马掌权的时期，290—303行；第二十位王，303—314行；短命的王，315—320行；来自东方的统治者，321—328行；来自西方的狡诈统治者，329—344行；年轻的凯撒，345—354行；灾祸之时，356—368行；惟有尊荣神的人得享福乐，369—373行；西卜的祷告，374—382行。〕"
    },
    {
      "id": "p0003",
      "zh": "如今来吧，听我述说那悲哀的时代，"
    },
    {
      "id": "p0004",
      "zh": "就是拉丁子孙的时代。首先，"
    },
    {
      "id": "p0005",
      "zh": "埃及诸王被毁灭以后，"
    },
    {
      "id": "p0006",
      "zh": "同一片大地将他们全都收在地下以后，"
    },
    {
      "id": "p0007",
      "zh": "又在那出身佩拉的人以后——在他手下，"
    },
    {
      "id": "p0008",
      "zh": "全东方和富庶的西方都被征服；"
    },
    {
      "id": "p0009",
      "zh": "巴比伦使他蒙羞，将一具尸首"
    },
    {
      "id": "p0010",
      "zh": "交还腓力；至于他属宙斯、"
    },
    {
      "id": "p0011",
      "zh": "属阿蒙的预言，并不真实——"
    },
    {
      "id": "p0012",
      "zh": "又在那出自亚萨拉古王血脉、"
    },
    {
      "id": "p0013",
      "zh": "从特洛伊而来的人以后，"
    },
    {
      "id": "p0014",
      "zh": "就是那冲破烈火威势的人以后，"
    },
    {
      "id": "p0015",
      "zh": "又在许多君主以后，在那些"
    },
    {
      "id": "p0016",
      "zh": "为阿瑞斯所喜爱的人以后，在那些婴孩以后，"
    },
    {
      "id": "p0017",
      "zh": "就是那吞吃羊群的野兽所养育的孩子以后，"
    },
    {
      "id": "p0018",
      "zh": "又在罗马独裁统治的六百年"
    },
    {
      "id": "p0019",
      "zh": "加上二十年过去以后，"
    },
    {
      "id": "p0020",
      "zh": "第一位君主必从西海而来，"
    },
    {
      "id": "p0021",
      "zh": "作罗马的统治者，极其强大，"
    },
    {
      "id": "p0022",
      "zh": "又善争战；他名字的首字母，"
    },
    {
      "id": "p0023",
      "zh": "正是字母表的开头。他必将你牢牢捆住，"
    },
    {
      "id": "p0024",
      "zh": "哦，出产丰饶之地；他必充满"
    },
    {
      "id": "p0025",
      "zh": "杀人的阿瑞斯之力。你必偿还"
    },
    {
      "id": "p0026",
      "zh": "你甘心强加于人的暴行；"
    },
    {
      "id": "p0027",
      "zh": "因为他心志刚强，争战无人能及；"
    },
    {
      "id": "p0028",
      "zh": "色雷斯和西西里必俯伏在他面前，"
    },
    {
      "id": "p0029",
      "zh": "孟斐斯也必如此；孟斐斯必被摔落在地，"
    },
    {
      "id": "p0030",
      "zh": "因着统治者的邪恶，"
    },
    {
      "id": "p0031",
      "zh": "又因着一个不肯屈服、却倒在"
    },
    {
      "id": "p0032",
      "zh": "长矛下的妇人。他必颁布律法"
    },
    {
      "id": "p0033",
      "zh": "给万民，使万物都服在他以下；"
    },
    {
      "id": "p0034",
      "zh": "他必大有名声，长久执掌王杖；"
    },
    {
      "id": "p0035",
      "zh": "他存留的日子并不短少，"
    },
    {
      "id": "p0036",
      "zh": "此后再没有执掌王杖的王"
    },
    {
      "id": "p0037",
      "zh": "能在罗马人中胜过他，连一刻也没有，"
    },
    {
      "id": "p0038",
      "zh": "因为神将万物丰丰富富地赐给了他；"
    },
    {
      "id": "p0039",
      "zh": "又在这美好的大地上，显明"
    },
    {
      "id": "p0040",
      "zh": "伟大奇妙的时节，并随之显明兆头。"
    },
    {
      "id": "p0041",
      "zh": "但当一颗灿烂的星，如同太阳一般，"
    },
    {
      "id": "p0042",
      "zh": "在正午从天上照耀，"
    },
    {
      "id": "p0043",
      "zh": "至高者隐秘的道就必"
    },
    {
      "id": "p0044",
      "zh": "披戴肉身，如同凡人而来；与他一同，"
    },
    {
      "id": "p0045",
      "zh": "罗马和显赫拉丁人的权势"
    },
    {
      "id": "p0046",
      "zh": "必增长。但那大有能力的王自己"
    },
    {
      "id": "p0047",
      "zh": "必按所定的命数死去，"
    },
    {
      "id": "p0048",
      "zh": "将王权传给另一个人。"
    },
    {
      "id": "p0049",
      "zh": "在他以后，必有一个人，强大的战士，"
    },
    {
      "id": "p0050",
      "zh": "肩披紫袍，"
    },
    {
      "id": "p0051",
      "zh": "起来掌权；他名字的首字母"
    },
    {
      "id": "p0052",
      "zh": "数值为三百。他必毁灭"
    },
    {
      "id": "p0053",
      "zh": "玛代人和发箭的帕提亚人；"
    },
    {
      "id": "p0054",
      "zh": "他必以自己的能力倾覆"
    },
    {
      "id": "p0055",
      "zh": "城门高耸的城；灾祸又必临到"
    },
    {
      "id": "p0056",
      "zh": "埃及和亚述人，"
    },
    {
      "id": "p0057",
      "zh": "临到科尔基斯的赫尼奥基人，"
    },
    {
      "id": "p0058",
      "zh": "又临到莱茵河水旁、"
    },
    {
      "id": "p0059",
      "zh": "居住在沙岸之外的日耳曼人。"
    },
    {
      "id": "p0060",
      "zh": "此后，他又必蹂躏"
    },
    {
      "id": "p0061",
      "zh": "埃里达努斯河旁那城门高耸的城，"
    },
    {
      "id": "p0062",
      "zh": "就是图谋恶事的城。随后他"
    },
    {
      "id": "p0063",
      "zh": "必很快倒下，被闪亮的铁器击中。"
    },
    {
      "id": "p0064",
      "zh": "以后，另一个人必起来掌权，"
    },
    {
      "id": "p0065",
      "zh": "编织诡计；他名字的首字母"
    },
    {
      "id": "p0066",
      "zh": "必显出数值三。他必积聚"
    },
    {
      "id": "p0067",
      "zh": "许多黄金；他对财富"
    },
    {
      "id": "p0068",
      "zh": "永不知足，反而更加肆无忌惮地掠夺，"
    },
    {
      "id": "p0069",
      "zh": "把一切都埋藏在地里。"
    },
    {
      "id": "p0070",
      "zh": "然而和平必临到，阿瑞斯必止息"
    },
    {
      "id": "p0071",
      "zh": "战争。他必藉占卜"
    },
    {
      "id": "p0072",
      "zh": "显明许多极大的事，"
    },
    {
      "id": "p0073",
      "zh": "为生计而求问；"
    },
    {
      "id": "p0074",
      "zh": "然而有一个极大的兆头必临到他："
    },
    {
      "id": "p0075",
      "zh": "当王将死之时，从天上"
    },
    {
      "id": "p0076",
      "zh": "必有许多细小的血滴落在他身上。"
    },
    {
      "id": "p0077",
      "zh": "他必行许多不法的事，"
    },
    {
      "id": "p0078",
      "zh": "将痛苦加在罗马人的颈项上，"
    },
    {
      "id": "p0079",
      "zh": "倚靠占卜；他也必杀死"
    },
    {
      "id": "p0080",
      "zh": "议会的首领。"
    },
    {
      "id": "p0081",
      "zh": "饥荒必临到加帕多家人，"
    },
    {
      "id": "p0082",
      "zh": "又临到色雷斯人、马其顿人和意大利人。"
    },
    {
      "id": "p0083",
      "zh": "惟有埃及必养活众多民族；"
    },
    {
      "id": "p0084",
      "zh": "王自己却必暗施欺骗，"
    },
    {
      "id": "p0085",
      "zh": "用诡计毁灭那贞洁的少女；"
    },
    {
      "id": "p0086",
      "zh": "百姓必悲伤流泪，"
    },
    {
      "id": "p0087",
      "zh": "将她埋葬。他们众人必向王"
    },
    {
      "id": "p0088",
      "zh": "怀怒，用诡计苦待他。"
    },
    {
      "id": "p0089",
      "zh": "强盛的罗马正兴旺时，那强者必灭亡。"
    },
    {
      "id": "p0090",
      "zh": "又有另一位君主必掌权，"
    },
    {
      "id": "p0091",
      "zh": "他的数值是两个十。那时"
    },
    {
      "id": "p0092",
      "zh": "战争与悲愁必临到萨乌罗马提亚人、色雷斯，"
    },
    {
      "id": "p0093",
      "zh": "以及以投掷标枪闻名的特里巴利人；"
    },
    {
      "id": "p0094",
      "zh": "罗马的阿瑞斯必将一切"
    },
    {
      "id": "p0095",
      "zh": "撕碎。当这人统治"
    },
    {
      "id": "p0096",
      "zh": "意大利人和潘诺尼亚人之地时，"
    },
    {
      "id": "p0097",
      "zh": "必有一个可怕的兆头："
    },
    {
      "id": "p0098",
      "zh": "在正午时分，"
    },
    {
      "id": "p0099",
      "zh": "黑夜必围绕他们，随后天上"
    },
    {
      "id": "p0100",
      "zh": "必降下石雨。此后，意大利人"
    },
    {
      "id": "p0101",
      "zh": "那强有力的君主和审判者"
    },
    {
      "id": "p0102",
      "zh": "必按自己的命数进入阴间的殿堂。"
    },
    {
      "id": "p0103",
      "zh": "又有另一个可怕的人必来到，"
    },
    {
      "id": "p0104",
      "zh": "令人惊惧，数值为五十；他必从各"
    },
    {
      "id": "p0105",
      "zh": "城中，将许多出身富贵的"
    },
    {
      "id": "p0106",
      "zh": "显要百姓全然除灭；"
    },
    {
      "id": "p0107",
      "zh": "他是一条可怕的蛇，吐出凶残的战争，"
    },
    {
      "id": "p0108",
      "zh": "有一天必伸出双手，"
    },
    {
      "id": "p0109",
      "zh": "灭绝自己的家族，搅动万事，"
    },
    {
      "id": "p0110",
      "zh": "扮作竞技者，驾驶战车，"
    },
    {
      "id": "p0111",
      "zh": "杀人，胆敢行无数的事；"
    },
    {
      "id": "p0112",
      "zh": "他必劈开两海之间的山，"
    },
    {
      "id": "p0113",
      "zh": "将血洒在其上。那毁灭者"
    },
    {
      "id": "p0114",
      "zh": "也必消失不见；"
    },
    {
      "id": "p0115",
      "zh": "随后他必自比为神，"
    },
    {
      "id": "p0116",
      "zh": "再度归来，神却必显明他算不得什么。"
    },
    {
      "id": "p0117",
      "zh": "他掌权时，必有深厚的太平，"
    },
    {
      "id": "p0118",
      "zh": "人也不惧怕；从大洋"
    },
    {
      "id": "p0119",
      "zh": "流出、穿过奥索尼亚的，"
    },
    {
      "id": "p0120",
      "zh": "必有无人涉足之水来到。他必四下"
    },
    {
      "id": "p0121",
      "zh": "察看，殷勤留意，为百姓设立"
    },
    {
      "id": "p0122",
      "zh": "极多的竞赛；"
    },
    {
      "id": "p0123",
      "zh": "他自己也必作表演者，以歌喉"
    },
    {
      "id": "p0124",
      "zh": "和七弦琴争胜，弹着琴弦"
    },
    {
      "id": "p0125",
      "zh": "歌唱；后来他必逃亡，"
    },
    {
      "id": "p0126",
      "zh": "舍弃王权；他灭亡时"
    },
    {
      "id": "p0127",
      "zh": "必为所作的恶偿还沉重的代价。"
    },
    {
      "id": "p0128",
      "zh": "他以后，必有三人掌权，其中两人"
    },
    {
      "id": "p0129",
      "zh": "名字的数值都是七十，"
    },
    {
      "id": "p0130",
      "zh": "此外还有一人，"
    },
    {
      "id": "p0131",
      "zh": "属第三个字母。他们一个在这里，一个在那里，"
    },
    {
      "id": "p0132",
      "zh": "必倒在强大阿瑞斯有力的手下。"
    },
    {
      "id": "p0133",
      "zh": "那时必有一位大能的统治者来到，"
    },
    {
      "id": "p0134",
      "zh": "毁灭敬虔人，心志刚强，"
    },
    {
      "id": "p0135",
      "zh": "如挥舞长矛的阿瑞斯；七个十"
    },
    {
      "id": "p0136",
      "zh": "必将他清楚指出。他必倾覆"
    },
    {
      "id": "p0137",
      "zh": "腓尼基，毁灭亚述。"
    },
    {
      "id": "p0138",
      "zh": "刀剑必临到所利玛的"
    },
    {
      "id": "p0139",
      "zh": "圣地，直达提比哩亚海"
    },
    {
      "id": "p0140",
      "zh": "最远的弯处。有祸了，有祸了，"
    },
    {
      "id": "p0141",
      "zh": "腓尼基，哦，你要忍受何等多的苦楚！"
    },
    {
      "id": "p0142",
      "zh": "你满载悲愁，你的战利品被紧紧捆住，"
    },
    {
      "id": "p0143",
      "zh": "列国都必践踏你。"
    },
    {
      "id": "p0144",
      "zh": "有祸了，有祸了！你必被带到亚述人"
    },
    {
      "id": "p0145",
      "zh": "那里，看见幼童"
    },
    {
      "id": "p0146",
      "zh": "和妇人一同在仇敌中服役，"
    },
    {
      "id": "p0147",
      "zh": "一切生计和财富都必消灭；"
    },
    {
      "id": "p0148",
      "zh": "因为神那带来深重灾祸的忿怒"
    },
    {
      "id": "p0149",
      "zh": "必临到你，因他们不遵守他的律法，"
    },
    {
      "id": "p0150",
      "zh": "反以污秽的法术事奉各样偶像。"
    },
    {
      "id": "p0151",
      "zh": "必有许多战争、争斗、凶杀，"
    },
    {
      "id": "p0152",
      "zh": "饥荒、瘟疫，以及"
    },
    {
      "id": "p0153",
      "zh": "城邑的纷乱。然而那受尊崇、"
    },
    {
      "id": "p0154",
      "zh": "心志刚强的王，到生命的尽头，"
    },
    {
      "id": "p0155",
      "zh": "自己必因无法抗拒的定命而倒下。"
    },
    {
      "id": "p0156",
      "zh": "随后，另有两位首领必掌权，"
    },
    {
      "id": "p0157",
      "zh": "珍念他们父亲那位大君王，"
    },
    {
      "id": "p0158",
      "zh": "在奋战的勇士中大享荣耀。"
    },
    {
      "id": "p0159",
      "zh": "他们之中〔有一人〕必尊贵，"
    },
    {
      "id": "p0160",
      "zh": "有君主的威仪，名字的数值为三百；"
    },
    {
      "id": "p0161",
      "zh": "然而他也必因诡计倒下，"
    },
    {
      "id": "p0162",
      "zh": "并非横卧在交战的军队中，"
    },
    {
      "id": "p0163",
      "zh": "而是在罗马的平原上被双刃铜器击中。"
    },
    {
      "id": "p0164",
      "zh": "在他以后，一个强大善战的人，"
    },
    {
      "id": "p0165",
      "zh": "名字首字母的数值为四，必治理大国；"
    },
    {
      "id": "p0166",
      "zh": "无边大地上的众人都必爱他，"
    },
    {
      "id": "p0167",
      "zh": "那时普天下"
    },
    {
      "id": "p0168",
      "zh": "必得安息，止息战争。然而从西到东，众人"
    },
    {
      "id": "p0169",
      "zh": "必甘心事奉他，并非出于勉强，"
    },
    {
      "id": "p0170",
      "zh": "各城都必在他掌管之下，"
    },
    {
      "id": "p0171",
      "zh": "自行归服。因为天上的万军"
    },
    {
      "id": "p0172",
      "zh": "必使他大得荣耀，"
    },
    {
      "id": "p0173",
      "zh": "就是住在高处、永不朽坏的神。"
    },
    {
      "id": "p0174",
      "zh": "那时饥荒必使潘诺尼亚荒废，"
    },
    {
      "id": "p0175",
      "zh": "也使凯尔特全地荒废，毁灭人，"
    },
    {
      "id": "p0176",
      "zh": "一个在这里，一个在那里。至于"
    },
    {
      "id": "p0177",
      "zh": "奥龙特斯河流过之地的亚述人，"
    },
    {
      "id": "p0178",
      "zh": "他们的建筑、装饰，以及所有可见之物，"
    },
    {
      "id": "p0179",
      "zh": "必比别处更显宏伟。那大君王"
    },
    {
      "id": "p0180",
      "zh": "必钟爱他们，喜悦他们，"
    },
    {
      "id": "p0181",
      "zh": "远超过其余众多的民族；"
    },
    {
      "id": "p0182",
      "zh": "然而他自己胸膛正中"
    },
    {
      "id": "p0183",
      "zh": "必受重创，到生命尽头，"
    },
    {
      "id": "p0184",
      "zh": "被朋友用诡计制伏，在大王宫"
    },
    {
      "id": "p0185",
      "zh": "神圣的屋宇中倒下，"
    },
    {
      "id": "p0186",
      "zh": "身负创伤。继他而起的统治者，"
    },
    {
      "id": "p0187",
      "zh": "数值为五十，是一位受尊敬的人，"
    },
    {
      "id": "p0188",
      "zh": "他必从罗马除灭"
    },
    {
      "id": "p0189",
      "zh": "多得无法计算的居民和百姓；"
    },
    {
      "id": "p0190",
      "zh": "他掌权却只有片时；为前王的缘故，"
    },
    {
      "id": "p0191",
      "zh": "他必带着创伤进入阴间的殿堂。"
    },
    {
      "id": "p0192",
      "zh": "那时另有一王，是强大的战士，"
    },
    {
      "id": "p0193",
      "zh": "以三百为首字母的记号，"
    },
    {
      "id": "p0194",
      "zh": "必掌权，蹂躏色雷斯人"
    },
    {
      "id": "p0195",
      "zh": "地貌纷繁的土地；他必毁灭"
    },
    {
      "id": "p0196",
      "zh": "住在莱茵河旁强大的日耳曼人，"
    },
    {
      "id": "p0197",
      "zh": "又毁灭善射的伊比利亚人。"
    },
    {
      "id": "p0198",
      "zh": "此外，又有一场极大的灾祸"
    },
    {
      "id": "p0199",
      "zh": "必临到犹太人；腓尼基也必与他们一同"
    },
    {
      "id": "p0200",
      "zh": "被杀戮沾湿，喝下这苦杯；"
    },
    {
      "id": "p0201",
      "zh": "亚述人的城墙必在众多"
    },
    {
      "id": "p0202",
      "zh": "战士面前倒塌。又有一个"
    },
    {
      "id": "p0203",
      "zh": "毁灭生命的人必将他们尽行荒废。"
    },
    {
      "id": "p0204",
      "zh": "那时，大能神的威吓、"
    },
    {
      "id": "p0205",
      "zh": "地震和大瘟疫必临到各地，"
    },
    {
      "id": "p0206",
      "zh": "还有失时的暴风雪和猛烈的雷击。"
    },
    {
      "id": "p0207",
      "zh": "随后，那大君王，漫游山岭的凯尔特人，"
    },
    {
      "id": "p0208",
      "zh": "虽急切地奔赴"
    },
    {
      "id": "p0209",
      "zh": "战斗争竞，仍不能因阿瑞斯的劳苦"
    },
    {
      "id": "p0210",
      "zh": "逃脱羞辱的命运；他必"
    },
    {
      "id": "p0211",
      "zh": "耗尽精力；异乡的尘土必掩盖他的尸首，"
    },
    {
      "id": "p0212",
      "zh": "那尘土之地以尼米亚之花为名。"
    },
    {
      "id": "p0213",
      "zh": "他以后，另有一人必兴起，"
    },
    {
      "id": "p0214",
      "zh": "满头银发，以海"
    },
    {
      "id": "p0215",
      "zh": "为名，共有四个音节，"
    },
    {
      "id": "p0216",
      "zh": "如阿瑞斯自己显出字母表"
    },
    {
      "id": "p0217",
      "zh": "最先的字母。他必在各城"
    },
    {
      "id": "p0218",
      "zh": "奉献殿宇，亲自步行"
    },
    {
      "id": "p0219",
      "zh": "巡视世界，带走礼物；"
    },
    {
      "id": "p0220",
      "zh": "他必给许多人供应"
    },
    {
      "id": "p0221",
      "zh": "黄金和大量琥珀；术士的一切奥秘，"
    },
    {
      "id": "p0222",
      "zh": "他必都从圣所排除；"
    },
    {
      "id": "p0223",
      "zh": "又必为人设立远为美好的事物，"
    },
    {
      "id": "p0224",
      "zh": "……掌权……雷电；"
    },
    {
      "id": "p0225",
      "zh": "他作主时，必有大太平；"
    },
    {
      "id": "p0226",
      "zh": "他必是声音丰美的歌者，"
    },
    {
      "id": "p0227",
      "zh": "参与合乎律法的事，"
    },
    {
      "id": "p0228",
      "zh": "公正地施行正道；"
    },
    {
      "id": "p0229",
      "zh": "然而他必倒下，放开自己的命数。"
    },
    {
      "id": "p0230",
      "zh": "他以后，必有三人掌权，第三人较晚"
    },
    {
      "id": "p0231",
      "zh": "掌权，保有三个十；此后，"
    },
    {
      "id": "p0232",
      "zh": "又有一位王属于第一数位，"
    },
    {
      "id": "p0233",
      "zh": "必起来掌权；他以后又有一人"
    },
    {
      "id": "p0234",
      "zh": "作统帅，数值为七个十；"
    },
    {
      "id": "p0235",
      "zh": "他们的名字必受尊荣；他们必"
    },
    {
      "id": "p0236",
      "zh": "亲自毁灭污点累累的人，"
    },
    {
      "id": "p0237",
      "zh": "不列颠人、强大的摩尔人、达契亚人，"
    },
    {
      "id": "p0238",
      "zh": "以及阿拉伯人。但当这些人中最后一位"
    },
    {
      "id": "p0239",
      "zh": "灭亡，那曾受伤的"
    },
    {
      "id": "p0240",
      "zh": "可怕阿瑞斯，必再度"
    },
    {
      "id": "p0241",
      "zh": "攻打帕提亚人，将他们"
    },
    {
      "id": "p0242",
      "zh": "彻底毁灭。随后王自己"
    },
    {
      "id": "p0243",
      "zh": "必倒在一头诡诈的野兽手下，"
    },
    {
      "id": "p0244",
      "zh": "那兽操练它的爪手——这便是所称的死因。"
    },
    {
      "id": "p0245",
      "zh": "在他以后，另有一人必掌权，"
    },
    {
      "id": "p0246",
      "zh": "精通许多智慧之事；他必"
    },
    {
      "id": "p0247",
      "zh": "以那第一位大能君王的名字"
    },
    {
      "id": "p0248",
      "zh": "为自己的名，属于第一数位；他必良善"
    },
    {
      "id": "p0249",
      "zh": "而有能力。为了记念父亲，"
    },
    {
      "id": "p0250",
      "zh": "这强者必为显赫的拉丁人"
    },
    {
      "id": "p0251",
      "zh": "成就许多事；他必立刻"
    },
    {
      "id": "p0252",
      "zh": "用黄金装饰罗马的城墙，"
    },
    {
      "id": "p0253",
      "zh": "又用白银和象牙；他必"
    },
    {
      "id": "p0254",
      "zh": "进入市集和殿宇，"
    },
    {
      "id": "p0255",
      "zh": "与一位强者同行。有一日，极惨重的创伤"
    },
    {
      "id": "p0256",
      "zh": "必在罗马的战争中如麦穗长出；"
    },
    {
      "id": "p0257",
      "zh": "他必劫掠日耳曼全地，"
    },
    {
      "id": "p0258",
      "zh": "那时神的一个大兆头必显明，"
    },
    {
      "id": "p0259",
      "zh": "从天而来，因王的敬虔"
    },
    {
      "id": "p0260",
      "zh": "拯救那些身披铜甲、陷在困苦中的人；"
    },
    {
      "id": "p0261",
      "zh": "因为天上那垂听一切的神，"
    },
    {
      "id": "p0262",
      "zh": "必在他祈求时，降下不合时节的雨，"
    },
    {
      "id": "p0263",
      "zh": "使他得着滋润。但当我所说的"
    },
    {
      "id": "p0264",
      "zh": "这些事应验，随着年岁流转，"
    },
    {
      "id": "p0265",
      "zh": "那伟大而敬虔的王"
    },
    {
      "id": "p0266",
      "zh": "显赫的统治也必止息；在他"
    },
    {
      "id": "p0267",
      "zh": "生命的尽头，他宣告自己的儿子"
    },
    {
      "id": "p0268",
      "zh": "继承王国以后，便必按"
    },
    {
      "id": "p0269",
      "zh": "自己的命数死去，将王权留给"
    },
    {
      "id": "p0270",
      "zh": "那金发的统治者；"
    },
    {
      "id": "p0271",
      "zh": "这人名字中有两个十，生来为王，"
    },
    {
      "id": "p0272",
      "zh": "出自他父亲的血脉，必领受"
    },
    {
      "id": "p0273",
      "zh": "统治权。这人凭着超群的"
    },
    {
      "id": "p0274",
      "zh": "心智，必掌握万事；他必与"
    },
    {
      "id": "p0275",
      "zh": "那心高气盛、刚强自负的赫拉克勒斯争胜，"
    },
    {
      "id": "p0276",
      "zh": "在强大的兵器上胜过众人，"
    },
    {
      "id": "p0277",
      "zh": "又在狩猎和骑术上极享盛名；"
    },
    {
      "id": "p0278",
      "zh": "他却必孤身活在危险之中。"
    },
    {
      "id": "p0279",
      "zh": "这人掌权时，必有"
    },
    {
      "id": "p0280",
      "zh": "一个可怕的兆头：罗马的平原上"
    },
    {
      "id": "p0281",
      "zh": "必有大雾，以致人"
    },
    {
      "id": "p0282",
      "zh": "不能辨认身旁的人。随后，战争"
    },
    {
      "id": "p0283",
      "zh": "必与哀愁一同来到，"
    },
    {
      "id": "p0284",
      "zh": "那时王自己因情欲而过度疯狂，"
    },
    {
      "id": "p0285",
      "zh": "又软弱无力，必进入婚床，"
    },
    {
      "id": "p0286",
      "zh": "羞辱自己年幼的后裔，因着"
    },
    {
      "id": "p0287",
      "zh": "鲁莽、污秽的婚歌而声名狼藉。"
    },
    {
      "id": "p0288",
      "zh": "随后，在无助的孤独中隐匿，"
    },
    {
      "id": "p0289",
      "zh": "那强大的祸患之人，被忿怒拘住，"
    },
    {
      "id": "p0290",
      "zh": "必在浴室遭祸，"
    },
    {
      "id": "p0291",
      "zh": "如杀人的阿瑞斯被诡诈的命运捆绑。"
    },
    {
      "id": "p0292",
      "zh": "你当知道，罗马灭亡的命数已经临近，"
    },
    {
      "id": "p0293",
      "zh": "因人热衷权势；在阿瑞斯手中，"
    },
    {
      "id": "p0294",
      "zh": "许多人必死在帕拉斯的殿堂里。"
    },
    {
      "id": "p0295",
      "zh": "那时罗马必丧失所有，"
    },
    {
      "id": "p0296",
      "zh": "为她从前独自藉着多次战争"
    },
    {
      "id": "p0297",
      "zh": "所行的一切，偿还代价。"
    },
    {
      "id": "p0298",
      "zh": "我的心悲叹，我的心在我里面哀哭；"
    },
    {
      "id": "p0299",
      "zh": "因为，骄傲的罗马，自你第一位王"
    },
    {
      "id": "p0300",
      "zh": "将美好的律法赐给你和地上的人，"
    },
    {
      "id": "p0301",
      "zh": "又自伟大永生神的道"
    },
    {
      "id": "p0302",
      "zh": "来到地上，直到第十九次统治"
    },
    {
      "id": "p0303",
      "zh": "结束，克罗诺斯必使年岁满了"
    },
    {
      "id": "p0304",
      "zh": "二百年，加两个二十，又加两个二，"
    },
    {
      "id": "p0305",
      "zh": "再加六个月。随后，第二十位王"
    },
    {
      "id": "p0306",
      "zh": "被锋利的铜器击中时，必用刀剑"
    },
    {
      "id": "p0307",
      "zh": "在你家中倾流鲜血，使"
    },
    {
      "id": "p0308",
      "zh": "你的族类成为寡妇；他名字中的"
    },
    {
      "id": "p0309",
      "zh": "字母，显出数值八十，"
    },
    {
      "id": "p0310",
      "zh": "他又被衰老压住；然而在短短时候，"
    },
    {
      "id": "p0311",
      "zh": "他便必使你成为寡妇，"
    },
    {
      "id": "p0312",
      "zh": "那时必有许多战士、许多倾覆，"
    },
    {
      "id": "p0313",
      "zh": "以及谋杀、凶杀、致命的仇争，"
    },
    {
      "id": "p0314",
      "zh": "和被征服的苦难；"
    },
    {
      "id": "p0315",
      "zh": "在混乱中，许多马匹和人"
    },
    {
      "id": "p0316",
      "zh": "必被强力的手劈开，倒在平原上。"
    },
    {
      "id": "p0317",
      "zh": "随后另有一人必掌权，"
    },
    {
      "id": "p0318",
      "zh": "他名字的记号在数值十中；"
    },
    {
      "id": "p0319",
      "zh": "他必带来许多忧伤"
    },
    {
      "id": "p0320",
      "zh": "和呻吟，掠夺许多人；"
    },
    {
      "id": "p0321",
      "zh": "他自己却必短命，倒在"
    },
    {
      "id": "p0322",
      "zh": "强大的阿瑞斯手下，被闪亮的铁器击中。"
    },
    {
      "id": "p0323",
      "zh": "随后又有一人数值为五十，必来到，"
    },
    {
      "id": "p0324",
      "zh": "是从东方兴起、要来掌权的战士；"
    },
    {
      "id": "p0325",
      "zh": "如善战的阿瑞斯，他必来到色雷斯；"
    },
    {
      "id": "p0326",
      "zh": "此后他必逃走，来到"
    },
    {
      "id": "p0327",
      "zh": "庇推尼人之地"
    },
    {
      "id": "p0328",
      "zh": "和基利家的平原；然而那铜甲的阿瑞斯，"
    },
    {
      "id": "p0329",
      "zh": "毁灭生命者，必迅速一击，"
    },
    {
      "id": "p0330",
      "zh": "在亚述的田野将他全然毁灭。"
    },
    {
      "id": "p0331",
      "zh": "那时又有一个深谙欺诈、"
    },
    {
      "id": "p0332",
      "zh": "满有各样诡计的人，必狡猾地掌权，"
    },
    {
      "id": "p0333",
      "zh": "从西方兴起，他名字的"
    },
    {
      "id": "p0334",
      "zh": "数值为二百。又有"
    },
    {
      "id": "p0335",
      "zh": "另一兆头：他必筹谋战争，"
    },
    {
      "id": "p0336",
      "zh": "为王权攻打亚述人，"
    },
    {
      "id": "p0337",
      "zh": "兴起全军，征服万物。"
    },
    {
      "id": "p0338",
      "zh": "他必以自己的权势统治罗马人；"
    },
    {
      "id": "p0339",
      "zh": "他心中却有许多计谋，"
    },
    {
      "id": "p0340",
      "zh": "受祸害人的阿瑞斯催动；一条可怕的蛇，"
    },
    {
      "id": "p0341",
      "zh": "在战争中凶暴，〔那时〕必毁灭"
    },
    {
      "id": "p0342",
      "zh": "地上所有出身高贵的人，"
    },
    {
      "id": "p0343",
      "zh": "为他们的财富杀死贵族，像强盗一般，"
    },
    {
      "id": "p0344",
      "zh": "趁人灭亡时剥尽全地，"
    },
    {
      "id": "p0345",
      "zh": "他必往东方去；一切诡诈"
    },
    {
      "id": "p0346",
      "zh": "都必归于他……"
    },
    {
      "id": "p0347",
      "zh": "随后，一位年轻的凯撒必与他一同作王，"
    },
    {
      "id": "p0348",
      "zh": "名字与马其顿一位大有能力的"
    },
    {
      "id": "p0349",
      "zh": "君主相同，凭首字母可知；"
    },
    {
      "id": "p0350",
      "zh": "他在周围引起纷争，却必逃入"
    },
    {
      "id": "p0351",
      "zh": "军中，躲避那将来的王"
    },
    {
      "id": "p0352",
      "zh": "严酷的诡计；然而那凭"
    },
    {
      "id": "p0353",
      "zh": "蛮族习俗掌权的守庙者，"
    },
    {
      "id": "p0354",
      "zh": "必忽然灭亡，"
    },
    {
      "id": "p0355",
      "zh": "被强大的阿瑞斯用闪亮的铁器杀死；"
    },
    {
      "id": "p0356",
      "zh": "即使他已经死了，众人仍必把他撕碎。"
    },
    {
      "id": "p0357",
      "zh": "随后，波斯诸王必兴起；"
    },
    {
      "id": "p0358",
      "zh": "……罗马的阿瑞斯，罗马的君主。"
    },
    {
      "id": "p0359",
      "zh": "弗吕家必再因地震呻吟，"
    },
    {
      "id": "p0360",
      "zh": "处境凄惨。有祸了，有祸了，老底嘉；"
    },
    {
      "id": "p0361",
      "zh": "有祸了，有祸了，悲惨的希拉波立；"
    },
    {
      "id": "p0362",
      "zh": "因为从前裂开的大地首先吞下了你。"
    },
    {
      "id": "p0363",
      "zh": "罗马的……浩大的奥斯……"
    },
    {
      "id": "p0364",
      "zh": "一切所有的……"
    },
    {
      "id": "p0365",
      "zh": "必哀号……当人死在"
    },
    {
      "id": "p0366",
      "zh": "阿瑞斯手中时；人的命分"
    },
    {
      "id": "p0367",
      "zh": "必是凶恶的。那时，他却必沿东方的路，"
    },
    {
      "id": "p0368",
      "zh": "急忙前来俯视意大利，"
    },
    {
      "id": "p0369",
      "zh": "被剥得赤裸，倒在闪亮的铁器下，"
    },
    {
      "id": "p0370",
      "zh": "为他母亲的缘故招来仇恨。"
    },
    {
      "id": "p0371",
      "zh": "因为时节各有不同，彼此牵制，"
    },
    {
      "id": "p0372",
      "zh": "……闪耀；并非众人都能立刻明白这事；"
    },
    {
      "id": "p0373",
      "zh": "因为并非万事都〔归〕众人，"
    },
    {
      "id": "p0374",
      "zh": "惟有那些尊荣神、"
    },
    {
      "id": "p0375",
      "zh": "远避偶像的人，才得享福乐。"
    },
    {
      "id": "p0376",
      "zh": "如今，世界的主，各国"
    },
    {
      "id": "p0377",
      "zh": "真实无伪、永生的王——因你已将"
    },
    {
      "id": "p0378",
      "zh": "神圣的默示放在我心里——"
    },
    {
      "id": "p0379",
      "zh": "求你使这话语止息；因为我不知道"
    },
    {
      "id": "p0380",
      "zh": "自己所说的是什么；是在我里面的你，"
    },
    {
      "id": "p0381",
      "zh": "述说这一切。如今容我歇息"
    },
    {
      "id": "p0382",
      "zh": "片刻，将这动人的诗歌"
    },
    {
      "id": "p0383",
      "zh": "从我心中挪开；因为我的心已疲乏，"
    },
    {
      "id": "p0384",
      "zh": "以神圣的言语预告王权。"
    }
  ],
  "references": [
    "中文参考总集旧约卷二第33章《西卜神谕篇》卷12，11314—11970行；逐段比对，英文控制诗行、数字和残缺。"
  ],
  "notes": [
    "阿瑞斯为希腊战神，诗中也用其名指战争和善战者。字母所对应的数值均照英文，不将隐语替换成具体皇帝名字。",
    "克罗诺斯为古典神名，此处用于年岁流逝的意象；二百加四十加四年另六个月依英文，未采用参考本的二百四十六年。",
    "“保有三个十”“那兽操练它的爪手”等处语义含混，依英文保留；原文断裂省略处均未补写。"
  ]
}
