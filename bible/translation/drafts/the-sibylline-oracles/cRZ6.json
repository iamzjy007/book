{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cRZ6",
  "source_sha256": "43be2ce0d8ecfb8f7d2ea3367edd92a2725bbe81ed22cea58eed3c434b8a4bbd",
  "reviewed": false,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第二卷"
    },
    {
      "id": "p0002",
      "zh": "〔引言，1—6行；灾祸与邪恶的时期，7—15行；第十代人，16—28行；和平的时期，29—36行；大异兆与竞赛，37—63行；箴言篇，64—188行；竞赛，189—195行；末代的灾祸，196—222行；末日的事，223—263行；复活与审判，264—312行；恶人的刑罚，313—383行；义人的福乐，384—403行；有人从火中得救，404—415行；西卜的哀叹，416—427行。〕"
    },
    {
      "id": "p0003",
      "zh": "我曾恳切祈求，神便约束了"
    },
    {
      "id": "p0004",
      "zh": "我智慧的歌；他又将"
    },
    {
      "id": "p0005",
      "zh": "神圣话语的美妙声音放进我胸中。"
    },
    {
      "id": "p0006",
      "zh": "我浑身战栗，跟随"
    },
    {
      "id": "p0007",
      "zh": "这些话语，因为我不知道自己说什么，"
    },
    {
      "id": "p0008",
      "zh": "乃是神催促我，逐一宣告。"
    },
    {
      "id": "p0009",
      "zh": "但当地上发生震动、猛烈的雷击、"
    },
    {
      "id": "p0010",
      "zh": "雷鸣闪电、风暴与有害的枯病，"
    },
    {
      "id": "p0011",
      "zh": "豺狼肆虐，人遭杀戮，"
    },
    {
      "id": "p0012",
      "zh": "世人和哞叫的牛群遭毁灭，"
    },
    {
      "id": "p0013",
      "zh": "四足的牲畜、劳作的骡子，"
    },
    {
      "id": "p0014",
      "zh": "山羊和绵羊也遭殃，那时广阔的田野"
    },
    {
      "id": "p0015",
      "zh": "必因荒废而不结果，出产也必断绝。"
    },
    {
      "id": "p0016",
      "zh": "许多人要出卖"
    },
    {
      "id": "p0017",
      "zh": "自己的自由，圣殿也遭抢掠。"
    },
    {
      "id": "p0018",
      "zh": "此后，人类的"
    },
    {
      "id": "p0019",
      "zh": "第十代将要出现，那发闪电、震动大地的主，"
    },
    {
      "id": "p0020",
      "zh": "要打破人对偶像的热心，震撼"
    },
    {
      "id": "p0021",
      "zh": "七丘之城罗马的百姓，庞大的财富"
    },
    {
      "id": "p0022",
      "zh": "必被武尔坎的烈焰焚烧而消亡。"
    },
    {
      "id": "p0023",
      "zh": "那时，血色的异兆要从天降下；"
    },
    {
      "id": "p0024",
      "zh": "然而，全世界无数的人"
    },
    {
      "id": "p0025",
      "zh": "仍要狂怒地彼此残杀；在动乱中，"
    },
    {
      "id": "p0026",
      "zh": "神要将饥荒、瘟疫和雷击降给"
    },
    {
      "id": "p0027",
      "zh": "那些裁定是非、却行不义的人。"
    },
    {
      "id": "p0028",
      "zh": "全世界都要缺少人，"
    },
    {
      "id": "p0029",
      "zh": "以致若有人在地上看见"
    },
    {
      "id": "p0030",
      "zh": "一个人的踪迹，就会惊奇。"
    },
    {
      "id": "p0031",
      "zh": "那时，住在天上的大神，"
    },
    {
      "id": "p0032",
      "zh": "必在万事上显为敬虔之人的救主。"
    },
    {
      "id": "p0033",
      "zh": "那时必有和平和深奥的智慧，"
    },
    {
      "id": "p0034",
      "zh": "结果实的大地又要生出"
    },
    {
      "id": "p0035",
      "zh": "丰盛的出产，不再被分割，"
    },
    {
      "id": "p0036",
      "zh": "也不再受奴役。一切港口、"
    },
    {
      "id": "p0037",
      "zh": "一切海湾，都要向众人开放，"
    },
    {
      "id": "p0038",
      "zh": "如同从前，无耻的行为要消失。"
    },
    {
      "id": "p0039",
      "zh": "那时，神要向世人显出大异兆："
    },
    {
      "id": "p0040",
      "zh": "有一颗星，如灿烂的冠冕发光，"
    },
    {
      "id": "p0041",
      "zh": "从辉煌的天空照耀，明亮夺目，"
    },
    {
      "id": "p0042",
      "zh": "持续许多日；随后，他要从天上显出"
    },
    {
      "id": "p0043",
      "zh": "赐给竞赛者的冠冕，"
    },
    {
      "id": "p0044",
      "zh": "赐给那些奋力较量的人。那时又要有"
    },
    {
      "id": "p0045",
      "zh": "一场伟大的竞赛，胜利者凯旋，"
    },
    {
      "id": "p0046",
      "zh": "进入天上的穹苍；这竞赛"
    },
    {
      "id": "p0047",
      "zh": "为世上一切人预备，并带着"
    },
    {
      "id": "p0048",
      "zh": "不朽的荣耀。各族"
    },
    {
      "id": "p0049",
      "zh": "都要在这不朽的竞赛中，"
    },
    {
      "id": "p0050",
      "zh": "争取辉煌的胜利。因为在那里，无人"
    },
    {
      "id": "p0051",
      "zh": "能厚颜用银钱买得冠冕。"
    },
    {
      "id": "p0052",
      "zh": "纯洁的基督必裁定，赐给他们"
    },
    {
      "id": "p0053",
      "zh": "当得的报偿，为蒙认可的人加冕，"
    },
    {
      "id": "p0054",
      "zh": "又将不朽的奖赏赐给他的殉道者，"
    },
    {
      "id": "p0055",
      "zh": "就是奋战直到死的人。"
    },
    {
      "id": "p0056",
      "zh": "那些贞洁、跑好自己路程的人，"
    },
    {
      "id": "p0057",
      "zh": "他必赐给他们不朽坏的"
    },
    {
      "id": "p0058",
      "zh": "奖赏，又将各人当得的"
    },
    {
      "id": "p0059",
      "zh": "分给他们；那些远方的民族，"
    },
    {
      "id": "p0060",
      "zh": "若过圣洁生活，认识独一的神，也必得着。"
    },
    {
      "id": "p0061",
      "zh": "那些尊重婚姻、"
    },
    {
      "id": "p0062",
      "zh": "远离奸淫的人，"
    },
    {
      "id": "p0063",
      "zh": "他必赐他们丰富的恩赏和永恒的盼望。"
    },
    {
      "id": "p0064",
      "zh": "因为每个人的灵魂，都是神白白的恩赐，"
    },
    {
      "id": "p0065",
      "zh": "人不应以卑污的行为玷污它。"
    },
    {
      "id": "p0066",
      "zh": "〔不要以不义致富，乃要过〕"
    },
    {
      "id": "p0067",
      "zh": "正直的生活。要知足于"
    },
    {
      "id": "p0068",
      "zh": "自己所有的，远离"
    },
    {
      "id": "p0069",
      "zh": "别人的财物。不要说虚谎的话，"
    },
    {
      "id": "p0070",
      "zh": "要顾念一切真实的事。"
    },
    {
      "id": "p0071",
      "zh": "不要徒然敬奉偶像；当始终首先"
    },
    {
      "id": "p0072",
      "zh": "尊崇那永不朽坏的神，"
    },
    {
      "id": "p0073",
      "zh": "其次孝敬父母。凡所当给的，都要给人，"
    },
    {
      "id": "p0074",
      "zh": "不要参与不义的审判。"
    },
    {
      "id": "p0075",
      "zh": "不要无理驱逐穷人，"
    },
    {
      "id": "p0076",
      "zh": "也不要凭外表判断；你若恶意"
    },
    {
      "id": "p0077",
      "zh": "审判人，神日后也要审判你。"
    },
    {
      "id": "p0078",
      "zh": "要远离假见证，说诚实话。"
    },
    {
      "id": "p0079",
      "zh": "要持守童贞的纯洁，维护"
    },
    {
      "id": "p0080",
      "zh": "众人之间的爱。量给人的要公道，"
    },
    {
      "id": "p0081",
      "zh": "因为分量充足，于众人都是美好的。"
    },
    {
      "id": "p0082",
      "zh": "不要使天平偏斜一边，要使两边平衡。"
    },
    {
      "id": "p0083",
      "zh": "不可无知地或故意地起假誓，"
    },
    {
      "id": "p0084",
      "zh": "神因假誓之人所起的誓而恨恶他。"
    },
    {
      "id": "p0085",
      "zh": "出自不义行为的礼物，"
    },
    {
      "id": "p0086",
      "zh": "切不可伸手收取。不要偷取种子，"
    },
    {
      "id": "p0087",
      "zh": "拿走它而使生命散失的人，"
    },
    {
      "id": "p0088",
      "zh": "必受咒诅，历经多代。"
    },
    {
      "id": "p0089",
      "zh": "不要放纵卑污的情欲，不要毁谤，也不要杀人。"
    },
    {
      "id": "p0090",
      "zh": "劳苦之人的工价，要给他；不要苦待"
    },
    {
      "id": "p0091",
      "zh": "穷人。要帮助孤儿，"
    },
    {
      "id": "p0092",
      "zh": "也帮助寡妇和困乏人。说话要明理，"
    },
    {
      "id": "p0093",
      "zh": "秘密要存守心中。不要愿意"
    },
    {
      "id": "p0094",
      "zh": "行不义，也不要容忍"
    },
    {
      "id": "p0095",
      "zh": "不义的人。周济穷人，要立刻去做，"
    },
    {
      "id": "p0096",
      "zh": "不要说“明天再来”。你当把自己的粮食，"
    },
    {
      "id": "p0097",
      "zh": "用流汗劳作的手分给贫乏的人。"
    },
    {
      "id": "p0098",
      "zh": "施舍的人，知道怎样借给神。"
    },
    {
      "id": "p0099",
      "zh": "审判来到时，怜悯能救人脱离死亡。"
    },
    {
      "id": "p0100",
      "zh": "神所要的不是祭祀，乃是怜悯，"
    },
    {
      "id": "p0101",
      "zh": "他喜爱怜悯，胜过祭祀。要给赤身的人衣服穿，"
    },
    {
      "id": "p0102",
      "zh": "将饼分给饥饿的人，在自己家里"
    },
    {
      "id": "p0103",
      "zh": "接待无处栖身的人，引导瞎子。"
    },
    {
      "id": "p0104",
      "zh": "要怜悯遭船难的人，因为航程"
    },
    {
      "id": "p0105",
      "zh": "难以预料。向跌倒的人伸手，"
    },
    {
      "id": "p0106",
      "zh": "救助孤立无援的人。"
    },
    {
      "id": "p0107",
      "zh": "人人都有苦难，人生如轮转，"
    },
    {
      "id": "p0108",
      "zh": "财富并不牢靠。有财物时，"
    },
    {
      "id": "p0109",
      "zh": "就当向穷人伸手。神赐给你的，"
    },
    {
      "id": "p0110",
      "zh": "你也当分给困乏的人。"
    },
    {
      "id": "p0111",
      "zh": "世人的整个生命本是共有的，"
    },
    {
      "id": "p0112",
      "zh": "结局却各不相同。你看见"
    },
    {
      "id": "p0113",
      "zh": "穷人，绝不要用言语嘲弄他，"
    },
    {
      "id": "p0114",
      "zh": "也不要严厉斥责一个可能有过失的人。"
    },
    {
      "id": "p0115",
      "zh": "人的一生，到死时才得检验；他所行的"
    },
    {
      "id": "p0116",
      "zh": "是违法还是公义，等他"
    },
    {
      "id": "p0117",
      "zh": "受审判时，就必判明。不要"
    },
    {
      "id": "p0118",
      "zh": "用酒损伤心智，也不要过量饮酒。"
    },
    {
      "id": "p0119",
      "zh": "不要吃血，也要禁戒"
    },
    {
      "id": "p0120",
      "zh": "祭偶像之物。佩剑不可为"
    },
    {
      "id": "p0121",
      "zh": "杀戮，只可为防卫；但愿你"
    },
    {
      "id": "p0122",
      "zh": "无论无理或有理，都不动用刀剑。"
    },
    {
      "id": "p0123",
      "zh": "因为即使杀了仇敌，你也"
    },
    {
      "id": "p0124",
      "zh": "玷污了自己的手。要远离邻舍的田地，"
    },
    {
      "id": "p0125",
      "zh": "不可越界；每一处地界都当尊重，"
    },
    {
      "id": "p0126",
      "zh": "侵占必使人痛苦。拥有"
    },
    {
      "id": "p0127",
      "zh": "合法的财产，是有益的；不义的所得"
    },
    {
      "id": "p0128",
      "zh": "却毫无价值。不要损害田间"
    },
    {
      "id": "p0129",
      "zh": "任何正在生长的果实。要让外来的人"
    },
    {
      "id": "p0130",
      "zh": "与本地人得到同等的尊重，"
    },
    {
      "id": "p0131",
      "zh": "因为人彼此作客，都要体会"
    },
    {
      "id": "p0132",
      "zh": "那恒久忍耐的款待。"
    },
    {
      "id": "p0133",
      "zh": "但在你们中间，不要把任何人看作外人，"
    },
    {
      "id": "p0134",
      "zh": "因为世人哪，你们全都"
    },
    {
      "id": "p0135",
      "zh": "出于同一血脉，地上没有一处"
    },
    {
      "id": "p0136",
      "zh": "能永远使人安稳。不要渴求财富，也不要求富；"
    },
    {
      "id": "p0137",
      "zh": "只要求凭少许所有的度日，"
    },
    {
      "id": "p0138",
      "zh": "绝不占有任何不义之物。贪财"
    },
    {
      "id": "p0139",
      "zh": "是万恶之母。不要贪求"
    },
    {
      "id": "p0140",
      "zh": "金银，因为其中藏着"
    },
    {
      "id": "p0141",
      "zh": "双刃的铁器，能毁灭灵魂。"
    },
    {
      "id": "p0142",
      "zh": "黄金和白银，常是"
    },
    {
      "id": "p0143",
      "zh": "人的网罗。黄金啊，你是邪恶的根源，"
    },
    {
      "id": "p0144",
      "zh": "毁灭生命，扰乱万事；但愿你"
    },
    {
      "id": "p0145",
      "zh": "不再是世人如此渴求的祸害！"
    },
    {
      "id": "p0146",
      "zh": "因为有你，争战、掠夺"
    },
    {
      "id": "p0147",
      "zh": "和杀戮就来到，儿女恨恶父亲，"
    },
    {
      "id": "p0148",
      "zh": "弟兄姊妹也恨自己的骨肉。"
    },
    {
      "id": "p0149",
      "zh": "不要设谋欺诈，也不要使心"
    },
    {
      "id": "p0150",
      "zh": "武装起来，敌对朋友。心里不要隐藏"
    },
    {
      "id": "p0151",
      "zh": "与口中所说不同的意念；"
    },
    {
      "id": "p0152",
      "zh": "不要像依附岩石的章鱼，随环境变色。"
    },
    {
      "id": "p0153",
      "zh": "要向众人坦诚，把心里的事"
    },
    {
      "id": "p0154",
      "zh": "真实说出。凡故意"
    },
    {
      "id": "p0155",
      "zh": "作恶的，就是恶人；"
    },
    {
      "id": "p0156",
      "zh": "若受胁迫而行，他的结局"
    },
    {
      "id": "p0157",
      "zh": "我不论断；但愿各人的意志正直。"
    },
    {
      "id": "p0158",
      "zh": "不要因智慧、能力或财富而自夸，"
    },
    {
      "id": "p0159",
      "zh": "惟独神有智慧，有大能，"
    },
    {
      "id": "p0160",
      "zh": "满有财富。不要让过去的恶事"
    },
    {
      "id": "p0161",
      "zh": "继续折磨你的心，因为已经发生的，"
    },
    {
      "id": "p0162",
      "zh": "永远不能变为未曾发生。你的手"
    },
    {
      "id": "p0163",
      "zh": "不要急躁，要约束凶暴的激情；"
    },
    {
      "id": "p0164",
      "zh": "因为屡次有人挥拳击打，"
    },
    {
      "id": "p0165",
      "zh": "却无意中杀了人。苦难"
    },
    {
      "id": "p0166",
      "zh": "应当共同承受，不要过大，也不要过多。"
    },
    {
      "id": "p0167",
      "zh": "过度的好处，并没有给人"
    },
    {
      "id": "p0168",
      "zh": "带来益处。太多奢华"
    },
    {
      "id": "p0169",
      "zh": "导致无度的情欲。过多财富使人骄傲，"
    },
    {
      "id": "p0170",
      "zh": "助长放纵的强暴。"
    },
    {
      "id": "p0171",
      "zh": "激烈的情绪渐渐侵入，造成"
    },
    {
      "id": "p0172",
      "zh": "毁灭性的狂乱。怒气是一种欲望，"
    },
    {
      "id": "p0173",
      "zh": "过了度，就成为暴怒。"
    },
    {
      "id": "p0174",
      "zh": "良善之人的热心是高尚的，"
    },
    {
      "id": "p0175",
      "zh": "卑劣之人的热心却卑劣。恶人的"
    },
    {
      "id": "p0176",
      "zh": "胆量导致毁灭，善人的胆量"
    },
    {
      "id": "p0177",
      "zh": "却得美名。纯洁的爱"
    },
    {
      "id": "p0178",
      "zh": "当受尊重，居普里斯的爱却使"
    },
    {
      "id": "p0179",
      "zh": "羞耻增多。愚昧的人，在同伴中"
    },
    {
      "id": "p0180",
      "zh": "被称作十分讨人喜欢。"
    },
    {
      "id": "p0181",
      "zh": "饮食言谈，都要适度，"
    },
    {
      "id": "p0182",
      "zh": "凡事节制最为美好，"
    },
    {
      "id": "p0183",
      "zh": "逾越限度就带来悲伤。"
    },
    {
      "id": "p0184",
      "zh": "不要嫉妒、失信、辱骂人，"
    },
    {
      "id": "p0185",
      "zh": "不要心怀恶意，也不要虚假骗人。"
    },
    {
      "id": "p0186",
      "zh": "当谨慎明智，远离无耻行为。"
    },
    {
      "id": "p0187",
      "zh": "不要效法邪恶，要把"
    },
    {
      "id": "p0188",
      "zh": "报应交给公义；因为劝服"
    },
    {
      "id": "p0189",
      "zh": "是有益的，纷争却引出纷争。"
    },
    {
      "id": "p0190",
      "zh": "结局未明以前，不要轻易相信。"
    },
    {
      "id": "p0191",
      "zh": "这就是竞赛，这些就是报偿，"
    },
    {
      "id": "p0192",
      "zh": "这些就是奖赏；这就是生命之门，"
    },
    {
      "id": "p0193",
      "zh": "是不朽之境的入口，"
    },
    {
      "id": "p0194",
      "zh": "天上的神为最公义的人"
    },
    {
      "id": "p0195",
      "zh": "设立它，作得胜的奖赏。"
    },
    {
      "id": "p0196",
      "zh": "那些领受胜利冠冕的人，"
    },
    {
      "id": "p0197",
      "zh": "必荣耀地从这门经过。"
    },
    {
      "id": "p0198",
      "zh": "但当这异兆处处出现——"
    },
    {
      "id": "p0199",
      "zh": "孩子出生，两鬓已有灰发——"
    },
    {
      "id": "p0200",
      "zh": "又有人间的苦难、饥荒、瘟疫和战争，"
    },
    {
      "id": "p0201",
      "zh": "时序变迁，许多流泪的哀号，"
    },
    {
      "id": "p0202",
      "zh": "哦，全地有多少父母，"
    },
    {
      "id": "p0203",
      "zh": "他们的儿女要悲伤痛哭，"
    },
    {
      "id": "p0204",
      "zh": "用裹尸布包住他们的肉身和肢体，葬在地里，"
    },
    {
      "id": "p0205",
      "zh": "就是众民之母的土中；血和尘土"
    },
    {
      "id": "p0206",
      "zh": "污秽了儿女自身。末代可怜的人哪，"
    },
    {
      "id": "p0207",
      "zh": "你们这些作恶的人，"
    },
    {
      "id": "p0208",
      "zh": "可怕而幼稚，竟不明白："
    },
    {
      "id": "p0209",
      "zh": "妇女的族类不再生育时，"
    },
    {
      "id": "p0210",
      "zh": "收割世人的时候就到了。"
    },
    {
      "id": "p0211",
      "zh": "毁灭已经临近，那时冒名者"
    },
    {
      "id": "p0212",
      "zh": "取代先知，在地上说话。"
    },
    {
      "id": "p0213",
      "zh": "彼列要来，向世人"
    },
    {
      "id": "p0214",
      "zh": "行许多异能。那时，圣洁、"
    },
    {
      "id": "p0215",
      "zh": "蒙拣选、忠信的人中间必有混乱，"
    },
    {
      "id": "p0216",
      "zh": "他们和希伯来人都要被掠夺。"
    },
    {
      "id": "p0217",
      "zh": "可怕的忿怒要临到他们，"
    },
    {
      "id": "p0218",
      "zh": "那时，一个由十二支派组成的民族，要从东方"
    },
    {
      "id": "p0219",
      "zh": "来寻找他们的希伯来同胞，"
    },
    {
      "id": "p0220",
      "zh": "就是被亚述苗裔毁灭的人；列国"
    },
    {
      "id": "p0221",
      "zh": "要因这些人而灭亡。此后，"
    },
    {
      "id": "p0222",
      "zh": "蒙拣选、忠信的希伯来人，"
    },
    {
      "id": "p0223",
      "zh": "要统治极有势力的人，将他们奴役，"
    },
    {
      "id": "p0224",
      "zh": "如同从前，因为他们的权柄永不衰败。"
    },
    {
      "id": "p0225",
      "zh": "那高过万有、鉴察一切的至高者，"
    },
    {
      "id": "p0226",
      "zh": "住在天上，要将睡意撒在人身上，"
    },
    {
      "id": "p0227",
      "zh": "遮住他们的眼帘。那些仆人有福了，"
    },
    {
      "id": "p0228",
      "zh": "主人来到，看见他们醒着！"
    },
    {
      "id": "p0229",
      "zh": "他们时时警醒等候，"
    },
    {
      "id": "p0230",
      "zh": "双眼不眠。他可能在黎明、"
    },
    {
      "id": "p0231",
      "zh": "傍晚或正午来到；但他必来，"
    },
    {
      "id": "p0232",
      "zh": "必照我所说的成就，必定如此。"
    },
    {
      "id": "p0233",
      "zh": "对于沉睡的人，当时候迫近，"
    },
    {
      "id": "p0234",
      "zh": "星空中的星辰要在正午向众人显现，"
    },
    {
      "id": "p0235",
      "zh": "与两大光体一同出现。"
    },
    {
      "id": "p0236",
      "zh": "那时，提斯比人要从天上"
    },
    {
      "id": "p0237",
      "zh": "驱动他的天上战车，来到"
    },
    {
      "id": "p0238",
      "zh": "地上，向全世界显出"
    },
    {
      "id": "p0239",
      "zh": "生命将遭毁灭的三个凶兆。"
    },
    {
      "id": "p0240",
      "zh": "那日，凡被发现"
    },
    {
      "id": "p0241",
      "zh": "腹中怀胎的妇人都有祸了！"
    },
    {
      "id": "p0242",
      "zh": "凡乳养婴孩的都有祸了！"
    },
    {
      "id": "p0243",
      "zh": "凡住在波浪之上的都有祸了！"
    },
    {
      "id": "p0244",
      "zh": "看见那日的妇人都有祸了！"
    },
    {
      "id": "p0245",
      "zh": "因为黑雾要遮盖无边的世界，"
    },
    {
      "id": "p0246",
      "zh": "东西南北无不如此。随后，一道"
    },
    {
      "id": "p0247",
      "zh": "燃烧的巨大火流要从天上倾下，"
    },
    {
      "id": "p0248",
      "zh": "吞灭各处：大地、浩瀚的洋面、"
    },
    {
      "id": "p0249",
      "zh": "闪耀的海，以及湖泊、河流、泉源、"
    },
    {
      "id": "p0250",
      "zh": "残酷的阴间和天上的穹苍。"
    },
    {
      "id": "p0251",
      "zh": "天上的光体要破碎，汇成一体，"
    },
    {
      "id": "p0252",
      "zh": "变成全然荒凉的形状。"
    },
    {
      "id": "p0253",
      "zh": "因为星辰要从天上坠入各海。"
    },
    {
      "id": "p0254",
      "zh": "世人的一切灵魂都要咬牙切齿，"
    },
    {
      "id": "p0255",
      "zh": "在吞灭人的土地上，被硫磺的河流"
    },
    {
      "id": "p0256",
      "zh": "和猛烈的火焚烧，灰烬遮住万有。"
    },
    {
      "id": "p0257",
      "zh": "那时，世界的一切元素"
    },
    {
      "id": "p0258",
      "zh": "都要被夺去：空气、大地、海、光、天、白昼、"
    },
    {
      "id": "p0259",
      "zh": "黑夜。无数飞鸟不再"
    },
    {
      "id": "p0260",
      "zh": "翱翔空中，游于海中的"
    },
    {
      "id": "p0261",
      "zh": "活物再也不能游动，"
    },
    {
      "id": "p0262",
      "zh": "满载的船不再驶过波涛，"
    },
    {
      "id": "p0263",
      "zh": "牛不再沿着直行犁地，也不再有"
    },
    {
      "id": "p0264",
      "zh": "狂风的声音；他要将万物"
    },
    {
      "id": "p0265",
      "zh": "熔在一起，拣出清洁的。"
    },
    {
      "id": "p0266",
      "zh": "但那不朽之神的永恒使者——"
    },
    {
      "id": "p0267",
      "zh": "亚拉基尔、拉姆尔、乌列、撒米尔，"
    },
    {
      "id": "p0268",
      "zh": "以及阿撒尔——知道每个人从前"
    },
    {
      "id": "p0269",
      "zh": "行过多少恶事；那时，他们要从幽暗中"
    },
    {
      "id": "p0270",
      "zh": "领出世人的一切灵魂，带去受审，"
    },
    {
      "id": "p0271",
      "zh": "来到那伟大不朽之神的"
    },
    {
      "id": "p0272",
      "zh": "审判台前；因为永不朽坏的，"
    },
    {
      "id": "p0273",
      "zh": "惟有独一的他，就是全能者，"
    },
    {
      "id": "p0274",
      "zh": "他要审判世人。那时，天上的那一位"
    },
    {
      "id": "p0275",
      "zh": "要把魂、灵、声音，赐给"
    },
    {
      "id": "p0276",
      "zh": "住在地下的人，又赐骨头，"
    },
    {
      "id": "p0277",
      "zh": "用关节连接，与各样肉身相配，"
    },
    {
      "id": "p0278",
      "zh": "再以肉、筋、血脉和皮肤"
    },
    {
      "id": "p0279",
      "zh": "包裹身体，头发也如从前。"
    },
    {
      "id": "p0280",
      "zh": "经过神的塑造，气息使身体活动，"
    },
    {
      "id": "p0281",
      "zh": "地上之人的身体，有一日必这样复起。"
    },
    {
      "id": "p0282",
      "zh": "那时，大能的使者乌列要折断"
    },
    {
      "id": "p0283",
      "zh": "坚硬、长存的精钢门闩，"
    },
    {
      "id": "p0284",
      "zh": "就是巨大、紧锁阴间铜门的门闩，"
    },
    {
      "id": "p0285",
      "zh": "立刻将它们推倒，领一切"
    },
    {
      "id": "p0286",
      "zh": "经受许多苦难的形体前来受审；"
    },
    {
      "id": "p0287",
      "zh": "首先是古时所生的泰坦，"
    },
    {
      "id": "p0288",
      "zh": "以及巨人，还有一切被洪水淹没的，"
    },
    {
      "id": "p0289",
      "zh": "一切葬身汹涌海水的，"
    },
    {
      "id": "p0290",
      "zh": "一切成了野兽、"
    },
    {
      "id": "p0291",
      "zh": "爬物和飞鸟食物的，都要一同"
    },
    {
      "id": "p0292",
      "zh": "被乌列召到审判台前；"
    },
    {
      "id": "p0293",
      "zh": "那些肉身被火吞噬、"
    },
    {
      "id": "p0294",
      "zh": "在烈焰中毁灭的人，他也要聚集，"
    },
    {
      "id": "p0295",
      "zh": "带到神的审判台前。"
    },
    {
      "id": "p0296",
      "zh": "那在高处发雷声的万军之主，"
    },
    {
      "id": "p0297",
      "zh": "终结命运、使死人复活以后，"
    },
    {
      "id": "p0298",
      "zh": "要坐在天上的宝座，牢牢立定"
    },
    {
      "id": "p0299",
      "zh": "那巨大的柱子。那时，在云彩中，"
    },
    {
      "id": "p0300",
      "zh": "本身永不朽坏的基督，"
    },
    {
      "id": "p0301",
      "zh": "要与圣洁的使者一同，在荣耀中"
    },
    {
      "id": "p0302",
      "zh": "来到那不朽者面前，坐在"
    },
    {
      "id": "p0303",
      "zh": "伟大审判台的右边，"
    },
    {
      "id": "p0304",
      "zh": "审判敬虔者的一生，以及"
    },
    {
      "id": "p0305",
      "zh": "不敬虔者的道路。摩西，就是"
    },
    {
      "id": "p0306",
      "zh": "至高者伟大的朋友，也要披着肉身来到；"
    },
    {
      "id": "p0307",
      "zh": "伟大的亚伯拉罕本人也要来，"
    },
    {
      "id": "p0308",
      "zh": "还有以撒、雅各、约书亚、但以理、"
    },
    {
      "id": "p0309",
      "zh": "以利亚、哈巴谷、约拿，和"
    },
    {
      "id": "p0310",
      "zh": "那些被希伯来人杀害的。但他要毁灭"
    },
    {
      "id": "p0311",
      "zh": "耶利米以后的希伯来人，凡"
    },
    {
      "id": "p0312",
      "zh": "在审判台前受审判的，"
    },
    {
      "id": "p0313",
      "zh": "都要得着应得的报偿，"
    },
    {
      "id": "p0314",
      "zh": "为今生所行的一切偿付代价。"
    },
    {
      "id": "p0315",
      "zh": "那时，众人都要经过那燃烧的河流，"
    },
    {
      "id": "p0316",
      "zh": "其中有不灭的火；但一切义人"
    },
    {
      "id": "p0317",
      "zh": "都必得救，不敬神的人却要"
    },
    {
      "id": "p0318",
      "zh": "永远灭亡，就是那些从前"
    },
    {
      "id": "p0319",
      "zh": "作恶、杀人的，"
    },
    {
      "id": "p0320",
      "zh": "以及一切同谋、"
    },
    {
      "id": "p0321",
      "zh": "说谎者、盗贼、毁坏家庭的人，"
    },
    {
      "id": "p0322",
      "zh": "奸诈凶恶的人、寄食奉承的人，"
    },
    {
      "id": "p0323",
      "zh": "破坏婚姻、口出卑污言语的人，"
    },
    {
      "id": "p0324",
      "zh": "可怕、放荡、不法、拜偶像的人；"
    },
    {
      "id": "p0325",
      "zh": "还有一切离弃伟大不朽之神，"
    },
    {
      "id": "p0326",
      "zh": "成为亵渎者，伤害敬虔之人，"
    },
    {
      "id": "p0327",
      "zh": "破坏信仰、杀害义人的；"
    },
    {
      "id": "p0328",
      "zh": "以及一切带着无耻的诡诈、"
    },
    {
      "id": "p0329",
      "zh": "两面三刀，冒进来作长老"
    },
    {
      "id": "p0330",
      "zh": "和尊贵服侍者的人；他们明知故犯，"
    },
    {
      "id": "p0331",
      "zh": "听从虚谎之言，施行不义的审判，"
    },
    {
      "id": "p0332",
      "zh": "比豹和狼更能伤害人，"
    },
    {
      "id": "p0333",
      "zh": "也更卑劣；还有一切极度骄傲的人，"
    },
    {
      "id": "p0334",
      "zh": "放高利贷、利上加利的人，"
    },
    {
      "id": "p0335",
      "zh": "他们处处损害孤儿寡妇；"
    },
    {
      "id": "p0336",
      "zh": "又有那些把不义行为的果实"
    },
    {
      "id": "p0337",
      "zh": "分给孤儿寡妇的人，以及"
    },
    {
      "id": "p0338",
      "zh": "虽以自己劳苦所得施舍，却出言羞辱人的；"
    },
    {
      "id": "p0339",
      "zh": "还有一切遗弃年老父母，"
    },
    {
      "id": "p0340",
      "zh": "不加奉养，也不向"
    },
    {
      "id": "p0341",
      "zh": "父母尽孝的人；一切"
    },
    {
      "id": "p0342",
      "zh": "悖逆、向生养自己的父母"
    },
    {
      "id": "p0343",
      "zh": "说严厉话的人；一切收下抵押物"
    },
    {
      "id": "p0344",
      "zh": "后来却不承认的人；所有"
    },
    {
      "id": "p0345",
      "zh": "背叛主人的奴仆；以及"
    },
    {
      "id": "p0346",
      "zh": "放纵情欲、玷污肉身的人；"
    },
    {
      "id": "p0347",
      "zh": "还有解开童女腰带，"
    },
    {
      "id": "p0348",
      "zh": "暗中苟合的人；使人"
    },
    {
      "id": "p0349",
      "zh": "流产的人；以及不法地"
    },
    {
      "id": "p0350",
      "zh": "遗弃子女的人；男巫"
    },
    {
      "id": "p0351",
      "zh": "和女巫也在其中。天上"
    },
    {
      "id": "p0352",
      "zh": "不朽之神的忿怒，要驱赶他们"
    },
    {
      "id": "p0353",
      "zh": "来到一根柱子旁，周围有"
    },
    {
      "id": "p0354",
      "zh": "永不止息的火流，环绕奔腾。"
    },
    {
      "id": "p0355",
      "zh": "那永存、不朽之神的不死使者，"
    },
    {
      "id": "p0356",
      "zh": "要用长存的绳索捆绑他们，"
    },
    {
      "id": "p0357",
      "zh": "用燃烧的锁链锁住他们，又从上方"
    },
    {
      "id": "p0358",
      "zh": "以鞭子极其严酷地惩罚他们；"
    },
    {
      "id": "p0359",
      "zh": "在夜晚的幽暗中，他们要被抛进地狱，"
    },
    {
      "id": "p0360",
      "zh": "置于许多可怕的猛兽之下，"
    },
    {
      "id": "p0361",
      "zh": "那些是塔耳塔洛斯的兽，那里黑暗无边。"
    },
    {
      "id": "p0362",
      "zh": "在所有心怀邪恶的人身上，"
    },
    {
      "id": "p0363",
      "zh": "施行许多刑罚以后，"
    },
    {
      "id": "p0364",
      "zh": "还要有一道火轮，"
    },
    {
      "id": "p0365",
      "zh": "从大河出来，环绕他们，"
    },
    {
      "id": "p0366",
      "zh": "因为他们一心顾念恶行。"
    },
    {
      "id": "p0367",
      "zh": "那时，他们这里一个、那里一个，作父亲的、"
    },
    {
      "id": "p0368",
      "zh": "幼小的儿女、母亲、吃奶的婴孩，都要流泪，"
    },
    {
      "id": "p0369",
      "zh": "哀叹自己最悲惨的命运。他们的眼泪"
    },
    {
      "id": "p0370",
      "zh": "没有尽头，哀痛的声音也无人垂听，"
    },
    {
      "id": "p0371",
      "zh": "他们这里一个、那里一个地叹息，"
    },
    {
      "id": "p0372",
      "zh": "长久在阴暗潮湿的塔耳塔洛斯之下受折磨，"
    },
    {
      "id": "p0373",
      "zh": "高声呼喊；在被咒诅的地方，他们要为"
    },
    {
      "id": "p0374",
      "zh": "自己所行的一切恶事，三倍偿还，"
    },
    {
      "id": "p0375",
      "zh": "被大火焚烧。"
    },
    {
      "id": "p0376",
      "zh": "他们被强烈的饥渴耗尽，"
    },
    {
      "id": "p0377",
      "zh": "痛苦得咬牙切齿，"
    },
    {
      "id": "p0378",
      "zh": "称死亡为美，死亡却要"
    },
    {
      "id": "p0379",
      "zh": "逃避他们。因为死亡和黑夜，"
    },
    {
      "id": "p0380",
      "zh": "都不能再使他们安息。他们要向高处掌权的神"
    },
    {
      "id": "p0381",
      "zh": "求许多事，却都是徒然，"
    },
    {
      "id": "p0382",
      "zh": "那时，他要公然转脸，"
    },
    {
      "id": "p0383",
      "zh": "不看他们。因为他曾在七个世代中，"
    },
    {
      "id": "p0384",
      "zh": "为要使犯错的人回转，藉着"
    },
    {
      "id": "p0385",
      "zh": "无玷污的童女之手赐下异兆。"
    },
    {
      "id": "p0386",
      "zh": "但其余的人，凡喜爱公义美好的行为、"
    },
    {
      "id": "p0387",
      "zh": "敬虔和至公至义思想的，"
    },
    {
      "id": "p0388",
      "zh": "使者要带他们渡过燃烧的河流，"
    },
    {
      "id": "p0389",
      "zh": "领入光明和无忧的生命，"
    },
    {
      "id": "p0390",
      "zh": "那里有伟大神明的不朽之道，"
    },
    {
      "id": "p0391",
      "zh": "又有蜜、酒、奶三道泉源。"
    },
    {
      "id": "p0392",
      "zh": "土地由众人平等享有，不再被"
    },
    {
      "id": "p0393",
      "zh": "围墙和篱笆分割，自然而然"
    },
    {
      "id": "p0394",
      "zh": "结出更丰盛的果实；"
    },
    {
      "id": "p0395",
      "zh": "人共享生活，财富不再分配。"
    },
    {
      "id": "p0396",
      "zh": "因为那里不再有穷人和富人，"
    },
    {
      "id": "p0397",
      "zh": "暴君和奴仆，大的和小的，"
    },
    {
      "id": "p0398",
      "zh": "也没有君王和首领；人人一同平等享有。"
    },
    {
      "id": "p0399",
      "zh": "再没有人说“夜晚来了”，"
    },
    {
      "id": "p0400",
      "zh": "也不说“明天将到”或“昨天已过”；"
    },
    {
      "id": "p0401",
      "zh": "不再有许多忧虑的日子，"
    },
    {
      "id": "p0402",
      "zh": "没有春季、冬季、夏日炎热，"
    },
    {
      "id": "p0403",
      "zh": "也没有秋季〔没有婚姻，没有死亡，"
    },
    {
      "id": "p0404",
      "zh": "没有买卖〕；没有日落，"
    },
    {
      "id": "p0405",
      "zh": "也没有日出，因为神要使那日长久。"
    },
    {
      "id": "p0406",
      "zh": "永不朽坏的全能神，"
    },
    {
      "id": "p0407",
      "zh": "还要赐敬虔之人另一件事："
    },
    {
      "id": "p0408",
      "zh": "他们向不朽之神祈求时，"
    },
    {
      "id": "p0409",
      "zh": "他要容许人从狂暴的烈火"
    },
    {
      "id": "p0410",
      "zh": "和无尽噬咬般的痛苦中得救。"
    },
    {
      "id": "p0411",
      "zh": "他必如此行；因为此后，"
    },
    {
      "id": "p0412",
      "zh": "他要把他们从不停燃烧的火焰中拔出，移到别处，"
    },
    {
      "id": "p0413",
      "zh": "又为自己百姓的缘故，"
    },
    {
      "id": "p0414",
      "zh": "使他们进入另一种永恒的生命，"
    },
    {
      "id": "p0415",
      "zh": "与不朽者同在极乐原野，"
    },
    {
      "id": "p0416",
      "zh": "那里湖水的长波起伏，"
    },
    {
      "id": "p0417",
      "zh": "就是永流不息、深邃的阿刻戎之湖。"
    },
    {
      "id": "p0418",
      "zh": "哦，我这可怜的妇人！"
    },
    {
      "id": "p0419",
      "zh": "到那日，我将怎样呢？因为我犯了罪，"
    },
    {
      "id": "p0420",
      "zh": "愚昧地忙于一切事务，"
    },
    {
      "id": "p0421",
      "zh": "不顾婚姻之约，也不顾理性；"
    },
    {
      "id": "p0422",
      "zh": "即使在富有丈夫的家中，"
    },
    {
      "id": "p0423",
      "zh": "我也将困乏者拒之门外；从前，"
    },
    {
      "id": "p0424",
      "zh": "我还明知故犯，行不法之事。"
    },
    {
      "id": "p0425",
      "zh": "救主啊，虽然我曾行无耻之事，"
    },
    {
      "id": "p0426",
      "zh": "求你救我脱离那些折磨我的人，"
    },
    {
      "id": "p0427",
      "zh": "救我这无耻的妇人。如今我求你，"
    },
    {
      "id": "p0428",
      "zh": "使我暂且歇下这歌，稍得安息，"
    },
    {
      "id": "p0429",
      "zh": "圣洁的赐吗哪者啊，广大国度的王啊！"
    }
  ],
  "references": [
    "中文参考《基督教典外文献（共10册）_手机版.txt》第261章《基督教西卜神谕篇》二书，52032—52476行；参考仅节译，英文底本429个诗行与纲要块全部逐块翻译，内容和编号依英文。"
  ],
  "notes": []
}
