{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cWAE",
  "source_sha256": "778fe0a236b00b79b685084ece3ed114ad930aefb16e5c7300f0d20ad7d03c10",
  "reviewed": true,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第十四卷"
    },
    {
      "id": "p0002",
      "zh": "〔警戒人不可贪恋权势，1—14。杀牛者，16—22。以数字一指称的人，23—27。数字为四十的两位统治者，28—34。数字为七十的年轻统治者，115—55。数字为四十的统治者，66—61。从西方来的狼，62—65。以字母 A 指称的统治者，66—73。三位心高气傲的王，数字分别为一、三十、三百，74—93。数字为三的王，94—98。数字为四的老王，99—101。各族遭受战争与灾祸，102—120。数字为五的尊贵君王，121—134。数字分别为三百和三的两位王，115—147。多谋的王，148—159。数字为三百的王，160—172。形同野兽、数字为三十的王，173—188。数字为四的统治者，189—200。天上显出大异兆，201—205。从亚细亚来的统治者，数字为五十，206—216。从埃及来的统治者，217—223。施行大异兆的人与数字为五的和平之王，224—245。众暴君与以字母 A 指称的圣洁君王，246—261。罗马焚毁与重建，262—271。各地希腊人的灾祸，272—278。弑兄弟者，279—283。数字为八十的凶王与他在位时的恐怖事件，284—508。许多人取得王权，309—312。三位王及其毁灭，313—329。许多持矛者，330—335。神审判无耻之人，336—343。罗马的困境与最后一族拉丁君王，344—358。埃及与其明智的王，359—375。亚历山大人，376—381。可怕而无法形容的灾祸，382—398。西西里人，399—406。公狮与母狮，407—418。龙与公羊，419—425。埃及的第二场战争，426—433。毁灭性的屠杀，434—447。弥赛亚的时代，448—468。〕"
    },
    {
      "id": "p0003",
      "zh": "世人啊，你们为何虚妄地思想"
    },
    {
      "id": "p0004",
      "zh": "过于高远的事，仿佛自己永不死亡？"
    },
    {
      "id": "p0005",
      "zh": "你们掌权不过片时，"
    },
    {
      "id": "p0006",
      "zh": "却人人都想统治世人，"
    },
    {
      "id": "p0007",
      "zh": "不明白神自己恨恶"
    },
    {
      "id": "p0008",
      "zh": "对权势的贪恋，尤其恨恶"
    },
    {
      "id": "p0009",
      "zh": "那些贪得无厌、恶行可怖的君王，"
    },
    {
      "id": "p0010",
      "zh": "并向他们兴起黑暗。"
    },
    {
      "id": "p0011",
      "zh": "你们不愿行善，不存公义的意念，"
    },
    {
      "id": "p0012",
      "zh": "反倒个个选择紫袍为衣，"
    },
    {
      "id": "p0013",
      "zh": "渴望惨烈的争战与杀戮！"
    },
    {
      "id": "p0014",
      "zh": "住在天上、不朽的神"
    },
    {
      "id": "p0015",
      "zh": "必使他们寿数短促，将他们全然毁灭，"
    },
    {
      "id": "p0016",
      "zh": "在这里倾覆一个，在那里倾覆另一个。"
    },
    {
      "id": "p0017",
      "zh": "但当杀牛者来到，"
    },
    {
      "id": "p0018",
      "zh": "倚仗自己的力量，毛发浓密、面目凶恶，"
    },
    {
      "id": "p0019",
      "zh": "毁灭一切时，他也要将"
    },
    {
      "id": "p0020",
      "zh": "牧人撕碎。他们不能得胜，"
    },
    {
      "id": "p0021",
      "zh": "除非幼犬立刻飞奔，"
    },
    {
      "id": "p0022",
      "zh": "急切追赶，穿过林木茂密的山谷，"
    },
    {
      "id": "p0023",
      "zh": "前来交战；因为有一只狗"
    },
    {
      "id": "p0024",
      "zh": "追赶那残害牧人的狮子。"
    },
    {
      "id": "p0025",
      "zh": "随后有一位君王，要倚仗"
    },
    {
      "id": "p0026",
      "zh": "自己的能力，名字有四个音节，"
    },
    {
      "id": "p0027",
      "zh": "以数字一清楚地显明。"
    },
    {
      "id": "p0028",
      "zh": "但披铜甲的阿瑞斯要迅速杀死他，"
    },
    {
      "id": "p0029",
      "zh": "因为他与贪得无厌的人争战。"
    },
    {
      "id": "p0030",
      "zh": "随后另外两位尊贵的人要掌权，"
    },
    {
      "id": "p0031",
      "zh": "两人的数字都是四十；在他们治下，"
    },
    {
      "id": "p0032",
      "zh": "世上大有平安，众百姓"
    },
    {
      "id": "p0033",
      "zh": "得享法度与公义。但那些戴着明亮头盔、"
    },
    {
      "id": "p0034",
      "zh": "贪图金银的人，要巧设计谋捉住他们，"
    },
    {
      "id": "p0035",
      "zh": "为了这些财物，行不敬虔之事，"
    },
    {
      "id": "p0036",
      "zh": "将他们杀死。"
    },
    {
      "id": "p0037",
      "zh": "随后又有一位可怕的君王掌权，"
    },
    {
      "id": "p0038",
      "zh": "年纪轻轻，亲自搏战；他的名字显出"
    },
    {
      "id": "p0039",
      "zh": "数字七十。他凶暴，残害生命，"
    },
    {
      "id": "p0040",
      "zh": "要卑鄙地将罗马百姓交给"
    },
    {
      "id": "p0041",
      "zh": "军队；百姓因诸王的怒气，"
    },
    {
      "id": "p0042",
      "zh": "被恶行杀害。他还要摧毁"
    },
    {
      "id": "p0043",
      "zh": "拉丁人的每座城邑、每间房舍。"
    },
    {
      "id": "p0044",
      "zh": "从前旅人不久以前见过的罗马，"
    },
    {
      "id": "p0045",
      "zh": "再也不能看见，也不能听闻；"
    },
    {
      "id": "p0046",
      "zh": "这一切都要化为灰烬，"
    },
    {
      "id": "p0047",
      "zh": "她的建筑没有一样得以存留。"
    },
    {
      "id": "p0048",
      "zh": "因为施行报应的那一位要亲自从天而降；"
    },
    {
      "id": "p0049",
      "zh": "永生的神要从高天发出"
    },
    {
      "id": "p0050",
      "zh": "闪电与雷霆，击打世人。"
    },
    {
      "id": "p0051",
      "zh": "祂要用闪电焚毁一些人，"
    },
    {
      "id": "p0052",
      "zh": "又用大雷击杀另一些人。"
    },
    {
      "id": "p0053",
      "zh": "随后，强盛罗马的子弟和著名的拉丁人"
    },
    {
      "id": "p0054",
      "zh": "要杀死那无耻可怕的统治者。"
    },
    {
      "id": "p0055",
      "zh": "他的尸身周围，尘土不会轻轻覆盖；"
    },
    {
      "id": "p0056",
      "zh": "他要成为狗、鸟"
    },
    {
      "id": "p0057",
      "zh": "和狼的玩物，因为他掳掠了善战之民。"
    },
    {
      "id": "p0058",
      "zh": "在他以后，另一个数字为四十的人要掌权，"
    },
    {
      "id": "p0059",
      "zh": "是著名的帕提亚人毁灭者，"
    },
    {
      "id": "p0060",
      "zh": "也是日耳曼人的毁灭者；他要制服可怕的"
    },
    {
      "id": "p0061",
      "zh": "食人野兽，这些野兽在大洋的水道"
    },
    {
      "id": "p0062",
      "zh": "和幼发拉底河上不断进逼。"
    },
    {
      "id": "p0063",
      "zh": "那时罗马要恢复从前的景象。"
    },
    {
      "id": "p0064",
      "zh": "但当大狼来到你的平原，"
    },
    {
      "id": "p0065",
      "zh": "就是从西方进军而来的统治者，"
    },
    {
      "id": "p0066",
      "zh": "他要倒在强大的阿瑞斯手下，"
    },
    {
      "id": "p0067",
      "zh": "被锋利的铜刃劈开。"
    },
    {
      "id": "p0068",
      "zh": "此后，又有一人要统治"
    },
    {
      "id": "p0069",
      "zh": "极其强大的罗马人；"
    },
    {
      "id": "p0070",
      "zh": "他心志雄壮，从亚述兴起，"
    },
    {
      "id": "p0071",
      "zh": "以首字母为标记。他要亲自"
    },
    {
      "id": "p0072",
      "zh": "借战争使万有臣服，"
    },
    {
      "id": "p0073",
      "zh": "借军队立刻彰显权势，"
    },
    {
      "id": "p0074",
      "zh": "制定法度；但披铜甲的阿瑞斯"
    },
    {
      "id": "p0075",
      "zh": "要迅速毁灭他，他要倒在背叛的军队手下。"
    },
    {
      "id": "p0076",
      "zh": "在他以后，三个心高气傲的人要掌权，"
    },
    {
      "id": "p0077",
      "zh": "一个带着第一个数字，一个带着三十，"
    },
    {
      "id": "p0078",
      "zh": "另一个则带着三百，与他们一同掌权。"
    },
    {
      "id": "p0079",
      "zh": "他们残忍，要将手造神像中的金银"
    },
    {
      "id": "p0080",
      "zh": "放在烈火中熔化，"
    },
    {
      "id": "p0081",
      "zh": "为了得胜，要将钱财发给"
    },
    {
      "id": "p0082",
      "zh": "装备齐全、预备争战的军队，"
    },
    {
      "id": "p0083",
      "zh": "分派许多贵重物品和财宝。"
    },
    {
      "id": "p0084",
      "zh": "他们也要同样热切地"
    },
    {
      "id": "p0085",
      "zh": "争夺权势，以毁灭性的手段扫荡"
    },
    {
      "id": "p0086",
      "zh": "住在深而湍急的幼发拉底河边、"
    },
    {
      "id": "p0087",
      "zh": "善于射箭的帕提亚人、敌对的玛代人，"
    },
    {
      "id": "p0088",
      "zh": "头发柔软、勇于争战的马萨革泰人，"
    },
    {
      "id": "p0089",
      "zh": "以及背负箭袋的波斯人。"
    },
    {
      "id": "p0090",
      "zh": "但当王迎来自己命定的结局，"
    },
    {
      "id": "p0091",
      "zh": "将王杖留给更适合争战的众子，"
    },
    {
      "id": "p0092",
      "zh": "又劝他们秉行公义时，"
    },
    {
      "id": "p0093",
      "zh": "他们却忘记父亲的话，"
    },
    {
      "id": "p0094",
      "zh": "双手已预备好争战，"
    },
    {
      "id": "p0095",
      "zh": "要冲入战阵，争夺王权。"
    },
    {
      "id": "p0096",
      "zh": "随后，另一个数字为三的君王"
    },
    {
      "id": "p0097",
      "zh": "要独自掌权；但他被刀击中，"
    },
    {
      "id": "p0098",
      "zh": "很快便迎来结局。在他以后，"
    },
    {
      "id": "p0099",
      "zh": "许多人要死在彼此手下，"
    },
    {
      "id": "p0100",
      "zh": "他们都为争夺王权而奋勇搏战。"
    },
    {
      "id": "p0101",
      "zh": "又有一位心志雄壮的人要统治"
    },
    {
      "id": "p0102",
      "zh": "极其强大的罗马人；他是年老的君王，"
    },
    {
      "id": "p0103",
      "zh": "数字为四，要将一切治理妥当。"
    },
    {
      "id": "p0104",
      "zh": "随后，战争与争斗要临到腓尼基，"
    },
    {
      "id": "p0105",
      "zh": "因为善射的波斯诸族"
    },
    {
      "id": "p0106",
      "zh": "将要逼近。哦，将有多少人"
    },
    {
      "id": "p0107",
      "zh": "倒在说异族语言的人面前！"
    },
    {
      "id": "p0108",
      "zh": "西顿、特里波利斯和"
    },
    {
      "id": "p0109",
      "zh": "自夸喧嚷的贝里图斯，要在"
    },
    {
      "id": "p0110",
      "zh": "鲜血和尸骸中彼此相见。"
    },
    {
      "id": "p0111",
      "zh": "困苦的老底嘉，你要因人的"
    },
    {
      "id": "p0112",
      "zh": "不敬虔，在自己周围兴起"
    },
    {
      "id": "p0113",
      "zh": "一场徒劳的大战。"
    },
    {
      "id": "p0114",
      "zh": "哦，不幸的推罗人，你们要收取"
    },
    {
      "id": "p0115",
      "zh": "灾祸的庄稼；那时，照耀世人的太阳"
    },
    {
      "id": "p0116",
      "zh": "要在白昼退去，"
    },
    {
      "id": "p0117",
      "zh": "日轮不再显现，浓密丰沛的"
    },
    {
      "id": "p0118",
      "zh": "血滴要从天流下，"
    },
    {
      "id": "p0119",
      "zh": "落在地上。随后，王要死亡，"
    },
    {
      "id": "p0120",
      "zh": "被自己的同伴出卖。在他以后，"
    },
    {
      "id": "p0121",
      "zh": "还有许多无耻的首领，要煽动"
    },
    {
      "id": "p0122",
      "zh": "邪恶的纷争，彼此残杀。"
    },
    {
      "id": "p0123",
      "zh": "随后要有一位尊贵的统治者，"
    },
    {
      "id": "p0124",
      "zh": "足智多谋，名字的数目为五，"
    },
    {
      "id": "p0125",
      "zh": "倚仗大军；世人要因他的"
    },
    {
      "id": "p0126",
      "zh": "王权，热切爱戴他。"
    },
    {
      "id": "p0127",
      "zh": "他既有美名，又要借着"
    },
    {
      "id": "p0128",
      "zh": "善行使美名增添。他在位时，"
    },
    {
      "id": "p0129",
      "zh": "在托罗斯山和积雪的阿马努斯山之间，"
    },
    {
      "id": "p0130",
      "zh": "要有可怕的异兆。基利家地"
    },
    {
      "id": "p0131",
      "zh": "有一座崭新、美丽又坚固的城，"
    },
    {
      "id": "p0132",
      "zh": "要被深而湍急的河水毁灭。"
    },
    {
      "id": "p0133",
      "zh": "普罗蓬提斯和弗吕家"
    },
    {
      "id": "p0134",
      "zh": "要屡次地震。那享有盛名的王"
    },
    {
      "id": "p0135",
      "zh": "要照着自己的命运，"
    },
    {
      "id": "p0136",
      "zh": "因耗损身体的致命疾病而丧命。"
    },
    {
      "id": "p0137",
      "zh": "在他以后，有两位尊贵的王掌权，"
    },
    {
      "id": "p0138",
      "zh": "一个数字为三百，一个为三。"
    },
    {
      "id": "p0139",
      "zh": "他要为了保卫七山之城罗马，"
    },
    {
      "id": "p0140",
      "zh": "又为了强大的王权，"
    },
    {
      "id": "p0141",
      "zh": "彻底毁灭许多人。"
    },
    {
      "id": "p0142",
      "zh": "随后灾祸要临到元老院；"
    },
    {
      "id": "p0143",
      "zh": "只要王仍向它发怒，"
    },
    {
      "id": "p0144",
      "zh": "它就不能从他手中逃脱。那时，"
    },
    {
      "id": "p0145",
      "zh": "地上所有人都要看见异兆；"
    },
    {
      "id": "p0146",
      "zh": "雨水更加丰沛，冰雪与冰雹"
    },
    {
      "id": "p0147",
      "zh": "要毁坏无垠大地上的田产。"
    },
    {
      "id": "p0148",
      "zh": "但他们要在战争中倒下，被强大的阿瑞斯杀死，"
    },
    {
      "id": "p0149",
      "zh": "为意大利人的战事丧命。"
    },
    {
      "id": "p0150",
      "zh": "随后又有一位君王掌权，"
    },
    {
      "id": "p0151",
      "zh": "多谋善变，集结全军，"
    },
    {
      "id": "p0152",
      "zh": "为着争战，将钱财"
    },
    {
      "id": "p0153",
      "zh": "分给身穿铜甲的人。"
    },
    {
      "id": "p0154",
      "zh": "随后，在利比亚大陆之外，盛产谷物的尼罗河"
    },
    {
      "id": "p0155",
      "zh": "要灌溉"
    },
    {
      "id": "p0156",
      "zh": "埃及的黑土和肥沃田地，持续两年；"
    },
    {
      "id": "p0157",
      "zh": "然而饥荒要吞噬一切，"
    },
    {
      "id": "p0158",
      "zh": "战争、盗匪、谋杀和屠戮也一同临到。"
    },
    {
      "id": "p0159",
      "zh": "许多城邑要被善战之人"
    },
    {
      "id": "p0160",
      "zh": "借军队的手彻底摧毁；"
    },
    {
      "id": "p0161",
      "zh": "他自己也要被出卖，倒在明亮的铁刃之下。"
    },
    {
      "id": "p0162",
      "zh": "在他以后，一个数字为三百的人"
    },
    {
      "id": "p0163",
      "zh": "要统治极其强大的罗马人。"
    },
    {
      "id": "p0164",
      "zh": "他要伸出夺命的长矛，"
    },
    {
      "id": "p0165",
      "zh": "攻击亚美尼亚人、帕提亚人、"
    },
    {
      "id": "p0166",
      "zh": "亚述人，以及善于坚守战阵的波斯人。"
    },
    {
      "id": "p0167",
      "zh": "随后，建筑华美的罗马"
    },
    {
      "id": "p0168",
      "zh": "要以黄金、琥珀、"
    },
    {
      "id": "p0169",
      "zh": "白银和象牙重新整齐建起。"
    },
    {
      "id": "p0170",
      "zh": "从整个东方和繁荣的西方，"
    },
    {
      "id": "p0171",
      "zh": "要有许多百姓住在她里面；"
    },
    {
      "id": "p0172",
      "zh": "王要为她另立法度。"
    },
    {
      "id": "p0173",
      "zh": "但毁灭性的死亡与不可抗拒的命运"
    },
    {
      "id": "p0174",
      "zh": "要接着在一座广袤的岛屿上收取他。"
    },
    {
      "id": "p0175",
      "zh": "又有一个数字为十个三的人掌权，"
    },
    {
      "id": "p0176",
      "zh": "形同野兽，金发而面目凶狠，"
    },
    {
      "id": "p0177",
      "zh": "他是希腊人的后裔。"
    },
    {
      "id": "p0178",
      "zh": "随后，莫洛西亚的弗提亚城，"
    },
    {
      "id": "p0179",
      "zh": "这养育众人的城，要与拉里萨一同"
    },
    {
      "id": "p0180",
      "zh": "倒在佩涅俄斯河悬垂的岸边。"
    },
    {
      "id": "p0181",
      "zh": "那时，牧养马匹的西古提地"
    },
    {
      "id": "p0182",
      "zh": "也要发生叛乱。可怕的战争"
    },
    {
      "id": "p0183",
      "zh": "要临近迈奥提斯湖的水边，"
    },
    {
      "id": "p0184",
      "zh": "临近水流丰沛的法西斯河源"
    },
    {
      "id": "p0185",
      "zh": "最远出口的溪流，在日光兰生长的"
    },
    {
      "id": "p0186",
      "zh": "草地上；许多人要在那里"
    },
    {
      "id": "p0187",
      "zh": "倒在强大勇士手下。哦，有多少人"
    },
    {
      "id": "p0188",
      "zh": "要被阿瑞斯用坚硬的铜刃收取！随后，"
    },
    {
      "id": "p0189",
      "zh": "王灭绝一个西古提族群以后，"
    },
    {
      "id": "p0190",
      "zh": "要照自己的命运死亡，舍去性命。"
    },
    {
      "id": "p0191",
      "zh": "此后，又有一个数字为四的人"
    },
    {
      "id": "p0192",
      "zh": "掌权，显明出来，"
    },
    {
      "id": "p0193",
      "zh": "是个可怕的人。所有饮用湍流的"
    },
    {
      "id": "p0194",
      "zh": "阿拉克塞斯河上佳冰水的亚美尼亚人，"
    },
    {
      "id": "p0195",
      "zh": "以及心志雄壮的波斯人，"
    },
    {
      "id": "p0196",
      "zh": "在战争中都要惧怕他。科尔基斯人"
    },
    {
      "id": "p0197",
      "zh": "与极其强大的佩拉斯吉人之间，"
    },
    {
      "id": "p0198",
      "zh": "要有战争、争斗与屠杀。那些占据"
    },
    {
      "id": "p0199",
      "zh": "弗吕家地城邑"
    },
    {
      "id": "p0200",
      "zh": "和普罗蓬提斯城邑的人，要将"
    },
    {
      "id": "p0201",
      "zh": "两刃的刀拔出鞘来，"
    },
    {
      "id": "p0202",
      "zh": "因极大的不敬虔彼此攻击。"
    },
    {
      "id": "p0203",
      "zh": "随后，随着岁月流转，神要从天上"
    },
    {
      "id": "p0204",
      "zh": "向世人显出一个大异兆："
    },
    {
      "id": "p0205",
      "zh": "一只蝙蝠，预示邪恶的战争将临。"
    },
    {
      "id": "p0206",
      "zh": "那时，王不能逃脱严酷的命运，"
    },
    {
      "id": "p0207",
      "zh": "要死于人手，被明亮的铁刃杀死。"
    },
    {
      "id": "p0208",
      "zh": "在他以后，又有一个数字为五十的人"
    },
    {
      "id": "p0209",
      "zh": "从亚细亚出来掌权，"
    },
    {
      "id": "p0210",
      "zh": "令人极其惊恐，亲自搏战。"
    },
    {
      "id": "p0211",
      "zh": "他要向罗马宏伟的城墙发动战争，"
    },
    {
      "id": "p0212",
      "zh": "又在科尔基斯人、赫尼奥基人"
    },
    {
      "id": "p0213",
      "zh": "和饮奶的阿伽提尔西人中间开战，"
    },
    {
      "id": "p0214",
      "zh": "就在攸克辛海边、色雷斯的沙湾旁。"
    },
    {
      "id": "p0215",
      "zh": "那时，王不能逃脱严酷的命运，"
    },
    {
      "id": "p0216",
      "zh": "人要撕碎他的尸身。"
    },
    {
      "id": "p0217",
      "zh": "王被杀后，使人显贵的罗马"
    },
    {
      "id": "p0218",
      "zh": "要成为荒场，许多百姓要灭亡。"
    },
    {
      "id": "p0219",
      "zh": "随后，又有一个令人恐惧战兢的人，"
    },
    {
      "id": "p0220",
      "zh": "从强大的埃及出来掌权，要毁灭"
    },
    {
      "id": "p0221",
      "zh": "心志雄壮的帕提亚人、玛代人、日耳曼人，"
    },
    {
      "id": "p0222",
      "zh": "博斯普鲁斯的阿伽提尔西人，"
    },
    {
      "id": "p0223",
      "zh": "伊厄尔尼人、不列颠人、"
    },
    {
      "id": "p0224",
      "zh": "背负箭袋的伊比利亚人、弯腰的马萨革泰人，"
    },
    {
      "id": "p0225",
      "zh": "以及自以为超越凡人的波斯人。"
    },
    {
      "id": "p0226",
      "zh": "随后，一个声名显赫的人要察看"
    },
    {
      "id": "p0227",
      "zh": "整个希腊，与西古提"
    },
    {
      "id": "p0228",
      "zh": "及多风的高加索为敌。"
    },
    {
      "id": "p0229",
      "zh": "他在位时，要有可怕的异兆："
    },
    {
      "id": "p0230",
      "zh": "冠冕形状全如明亮的星辰，"
    },
    {
      "id": "p0231",
      "zh": "要在南北两方的天空显现。"
    },
    {
      "id": "p0232",
      "zh": "随后，他要将王权传给"
    },
    {
      "id": "p0233",
      "zh": "自己的儿子；这儿子名字的首字母"
    },
    {
      "id": "p0234",
      "zh": "居字母表之首。那勇武的王要照自己的命运，"
    },
    {
      "id": "p0235",
      "zh": "进入阴间的殿堂。"
    },
    {
      "id": "p0236",
      "zh": "但当这人的儿子在罗马地"
    },
    {
      "id": "p0237",
      "zh": "掌权，以数字一显明时，"
    },
    {
      "id": "p0238",
      "zh": "全地要有众人深切渴望的"
    },
    {
      "id": "p0239",
      "zh": "大平安。拉丁人要因他父亲"
    },
    {
      "id": "p0240",
      "zh": "的功德，爱戴他为王。"
    },
    {
      "id": "p0241",
      "zh": "他虽热切地要往东方、西方去，"
    },
    {
      "id": "p0242",
      "zh": "罗马百姓却要违背他的心愿，"
    },
    {
      "id": "p0243",
      "zh": "将他留在本土，治理罗马；"
    },
    {
      "id": "p0244",
      "zh": "因为人人都向这位尊贵"
    },
    {
      "id": "p0245",
      "zh": "显赫的君王怀着友爱之心。"
    },
    {
      "id": "p0246",
      "zh": "但凶恶的死亡要夺去他的生命，"
    },
    {
      "id": "p0247",
      "zh": "使他寿数短促，被交付于自己的命运。"
    },
    {
      "id": "p0248",
      "zh": "此后，又有别的人彼此"
    },
    {
      "id": "p0249",
      "zh": "攻击；他们是强大的战士，持续"
    },
    {
      "id": "p0250",
      "zh": "进行邪恶的争斗，并不真正拥有王者的权柄，"
    },
    {
      "id": "p0251",
      "zh": "而是作暴君。他们要在全世界"
    },
    {
      "id": "p0252",
      "zh": "造成许多恶事，"
    },
    {
      "id": "p0253",
      "zh": "尤其祸害罗马人，直到第三位"
    },
    {
      "id": "p0254",
      "zh": "狄俄尼索斯出现，直到戴盔披甲的"
    },
    {
      "id": "p0255",
      "zh": "阿瑞斯从埃及来到，"
    },
    {
      "id": "p0256",
      "zh": "人要称他为狄俄尼索斯君王。"
    },
    {
      "id": "p0257",
      "zh": "但当一头嗜杀的公狮与一头嗜杀的母狮"
    },
    {
      "id": "p0258",
      "zh": "撕裂显赫的王室紫袍，"
    },
    {
      "id": "p0259",
      "zh": "他们要一同攫住这变动王国的"
    },
    {
      "id": "p0260",
      "zh": "肺腑；随后，有一位圣洁的王，"
    },
    {
      "id": "p0261",
      "zh": "名字以第一个字母开头，要竭力"
    },
    {
      "id": "p0262",
      "zh": "争取胜利，将敌对的首领击倒，"
    },
    {
      "id": "p0263",
      "zh": "交给狗和猛禽作食物。"
    },
    {
      "id": "p0264",
      "zh": "被火焚烧的城啊，你有祸了，"
    },
    {
      "id": "p0265",
      "zh": "强大的罗马啊！当这一切发生时，"
    },
    {
      "id": "p0266",
      "zh": "你必须忍受何等多的苦难！"
    },
    {
      "id": "p0267",
      "zh": "但此后，那伟大而闻名遐迩的王，"
    },
    {
      "id": "p0268",
      "zh": "要用黄金、琥珀、"
    },
    {
      "id": "p0269",
      "zh": "白银和象牙，将你全然重建；在世上，"
    },
    {
      "id": "p0270",
      "zh": "你的产业要居首位，"
    },
    {
      "id": "p0271",
      "zh": "你的庙宇、市集、财富"
    },
    {
      "id": "p0272",
      "zh": "和竞技场也都如此。那时你要再一次"
    },
    {
      "id": "p0273",
      "zh": "成为众人的光，正如从前。"
    },
    {
      "id": "p0274",
      "zh": "哦，困苦的刻克罗普斯人、卡德摩斯人，"
    },
    {
      "id": "p0275",
      "zh": "以及拉科尼亚人，他们居住在"
    },
    {
      "id": "p0276",
      "zh": "佩涅俄斯河与莫洛西亚河周围，"
    },
    {
      "id": "p0277",
      "zh": "那里芦苇丛生；还有特里卡、多多纳，"
    },
    {
      "id": "p0278",
      "zh": "筑在高处的伊托墨、环绕奥林匹斯山巅"
    },
    {
      "id": "p0279",
      "zh": "的庇厄里亚山岭，"
    },
    {
      "id": "p0280",
      "zh": "奥萨、拉里萨和城门高耸的卡吕冬。"
    },
    {
      "id": "p0281",
      "zh": "但当神为世人显出"
    },
    {
      "id": "p0282",
      "zh": "大异兆，使白昼的昏暗笼罩全世界，"
    },
    {
      "id": "p0283",
      "zh": "王啊，你的结局就要来到；"
    },
    {
      "id": "p0284",
      "zh": "你绝不可能逃脱"
    },
    {
      "id": "p0285",
      "zh": "兄弟向你投来的锋利标枪。"
    },
    {
      "id": "p0286",
      "zh": "随后又有一个残害生命的人掌权，"
    },
    {
      "id": "p0287",
      "zh": "是从王族出来的烈火之鹰，"
    },
    {
      "id": "p0288",
      "zh": "要紧紧抓住埃及的后裔；"
    },
    {
      "id": "p0289",
      "zh": "他年纪较轻，却比兄弟强盛得多，"
    },
    {
      "id": "p0290",
      "zh": "名字的首个标记为数字八十。"
    },
    {
      "id": "p0291",
      "zh": "那时，整个世界要为尊荣的缘故，"
    },
    {
      "id": "p0292",
      "zh": "在怀中承受永生神"
    },
    {
      "id": "p0293",
      "zh": "那使心灵痛苦的烈怒；"
    },
    {
      "id": "p0294",
      "zh": "世人不过朝生暮死，"
    },
    {
      "id": "p0295",
      "zh": "却要遭遇饥荒、瘟疫、战争和屠杀。"
    },
    {
      "id": "p0296",
      "zh": "无休止的黑暗要笼罩大地，"
    },
    {
      "id": "p0297",
      "zh": "这万民之母；不可平息的忿怒"
    },
    {
      "id": "p0298",
      "zh": "要从天而降，时序也要混乱，"
    },
    {
      "id": "p0299",
      "zh": "还有地震、燃烧的霹雳，"
    },
    {
      "id": "p0300",
      "zh": "石块、暴雨和污浊的雨滴。"
    },
    {
      "id": "p0301",
      "zh": "弗吕家地高耸的山巅"
    },
    {
      "id": "p0302",
      "zh": "震动，西古提山岭的根基"
    },
    {
      "id": "p0303",
      "zh": "震动；城邑战抖，整个大地"
    },
    {
      "id": "p0304",
      "zh": "在希腊的峭壁旁颤动。"
    },
    {
      "id": "p0305",
      "zh": "神大大发怒，许多城邑"
    },
    {
      "id": "p0306",
      "zh": "要倒伏在燃烧的霹雳之下，"
    },
    {
      "id": "p0307",
      "zh": "伴随着哀哭；人根本无法避开这烈怒，"
    },
    {
      "id": "p0308",
      "zh": "也无处逃生。"
    },
    {
      "id": "p0309",
      "zh": "那时，王要倒在强有力的手下，"
    },
    {
      "id": "p0310",
      "zh": "被自己人击杀，仿佛他微不足道。"
    },
    {
      "id": "p0311",
      "zh": "在他以后，许多拉丁人"
    },
    {
      "id": "p0312",
      "zh": "肩披紫色斗篷，"
    },
    {
      "id": "p0313",
      "zh": "要再度兴起，想凭分定的命运"
    },
    {
      "id": "p0314",
      "zh": "夺取王权。"
    },
    {
      "id": "p0315",
      "zh": "随后，罗马宏伟的城墙上"
    },
    {
      "id": "p0316",
      "zh": "要有三位王；两位带着第一个数字，"
    },
    {
      "id": "p0317",
      "zh": "另一位带着“胜利”之名，"
    },
    {
      "id": "p0318",
      "zh": "无人能与他相比。他们要爱罗马"
    },
    {
      "id": "p0319",
      "zh": "和全世界，关怀世人；"
    },
    {
      "id": "p0320",
      "zh": "却不能成就什么。"
    },
    {
      "id": "p0321",
      "zh": "因为神未曾向世界施恩，"
    },
    {
      "id": "p0322",
      "zh": "也不肯温柔待世人，"
    },
    {
      "id": "p0323",
      "zh": "因他们作了许多恶事。"
    },
    {
      "id": "p0324",
      "zh": "所以祂要使诸王生出卑劣的心，"
    },
    {
      "id": "p0325",
      "zh": "比豹子和狼更为凶恶；"
    },
    {
      "id": "p0326",
      "zh": "身穿铜甲的人要亲手残酷地捉住他们，"
    },
    {
      "id": "p0327",
      "zh": "如同杀害无力抵抗的软弱妇人，"
    },
    {
      "id": "p0328",
      "zh": "将诸王连同他们的权杖"
    },
    {
      "id": "p0329",
      "zh": "一并彻底毁灭。"
    },
    {
      "id": "p0330",
      "zh": "哦，荣耀罗马那些身居高位的困苦人，"
    },
    {
      "id": "p0331",
      "zh": "你们信靠虚假的誓言，必要灭亡。"
    },
    {
      "id": "p0332",
      "zh": "随后，许多持矛的主人，"
    },
    {
      "id": "p0333",
      "zh": "纷乱〔且〕疯狂地向前冲去，"
    },
    {
      "id": "p0334",
      "zh": "要夺去长子们的后裔，"
    },
    {
      "id": "p0335",
      "zh": "使他们流血……因此，至高者"
    },
    {
      "id": "p0336",
      "zh": "要三次降下可怕的灾祸，"
    },
    {
      "id": "p0337",
      "zh": "将所有人连同他们的作为一并毁灭。"
    },
    {
      "id": "p0338",
      "zh": "但神还要使那些心中"
    },
    {
      "id": "p0339",
      "zh": "毫无羞耻的人再度受审判，"
    },
    {
      "id": "p0340",
      "zh": "就是一切定意行恶的人。"
    },
    {
      "id": "p0341",
      "zh": "他们自己要被围困，接连"
    },
    {
      "id": "p0342",
      "zh": "倒在彼此身上，被交付于"
    },
    {
      "id": "p0343",
      "zh": "那对邪恶的定罪之中。"
    },
    {
      "id": "p0344",
      "zh": "一个接着一个；然而，一颗明亮的彗星，"
    },
    {
      "id": "p0345",
      "zh": "预示将有许多事、战争与争斗……"
    },
    {
      "id": "p0346",
      "zh": "到那时，有一人要在群岛周围"
    },
    {
      "id": "p0347",
      "zh": "搜集许多神谕，"
    },
    {
      "id": "p0348",
      "zh": "这些神谕向异乡人讲述战争、争斗，"
    },
    {
      "id": "p0349",
      "zh": "以及庙宇遭受的严重损害。他要吩咐"
    },
    {
      "id": "p0350",
      "zh": "一人赶紧在罗马的厅堂里储存"
    },
    {
      "id": "p0351",
      "zh": "足够十二个月的大量小麦和大麦，"
    },
    {
      "id": "p0352",
      "zh": "行动务要迅速。那些日子，"
    },
    {
      "id": "p0353",
      "zh": "城的境况将极其悲惨，但很快"
    },
    {
      "id": "p0354",
      "zh": "又要大大繁荣；"
    },
    {
      "id": "p0355",
      "zh": "那统治势力被毁灭后，就有安息。"
    },
    {
      "id": "p0356",
      "zh": "随后，拉丁君王最后的世系"
    },
    {
      "id": "p0357",
      "zh": "要出现；在它以后，统治的权势"
    },
    {
      "id": "p0358",
      "zh": "还要兴起，儿女及儿女的后裔"
    },
    {
      "id": "p0359",
      "zh": "必不动摇；这事必为人所知，"
    },
    {
      "id": "p0360",
      "zh": "因为神自己确实是王。"
    },
    {
      "id": "p0361",
      "zh": "有一片可爱的土地，养育人群，"
    },
    {
      "id": "p0362",
      "zh": "坐落在平原；尼罗河围绕它，"
    },
    {
      "id": "p0363",
      "zh": "划定界限，将整个利比亚"
    },
    {
      "id": "p0364",
      "zh": "和古实分隔开来。"
    },
    {
      "id": "p0365",
      "zh": "寿命短促的叙利亚人，要从各处"
    },
    {
      "id": "p0366",
      "zh": "来到那地，"
    },
    {
      "id": "p0367",
      "zh": "掠走一切可搬动的财物。"
    },
    {
      "id": "p0368",
      "zh": "一个伟大而谨慎的君主要作他们的王，"
    },
    {
      "id": "p0369",
      "zh": "训练年轻人，又差人召集男子，"
    },
    {
      "id": "p0370",
      "zh": "针对那些极其可怕的人，筹划"
    },
    {
      "id": "p0371",
      "zh": "可怕的事；他尤其要为整个"
    },
    {
      "id": "p0372",
      "zh": "心高气傲的意大利，派出"
    },
    {
      "id": "p0373",
      "zh": "强有力的帮助者。当他来到"
    },
    {
      "id": "p0374",
      "zh": "亚述黑暗的海上，"
    },
    {
      "id": "p0375",
      "zh": "要在腓尼基人的家中掳掠他们，"
    },
    {
      "id": "p0376",
      "zh": "使邪恶的战争与可怕的争斗牢牢扎根，"
    },
    {
      "id": "p0377",
      "zh": "成为地上两位君主中的一位。"
    },
    {
      "id": "p0378",
      "zh": "如今我要为亚历山大人歌唱，"
    },
    {
      "id": "p0379",
      "zh": "述说他们悲惨的结局。祸哉！异族人"
    },
    {
      "id": "p0380",
      "zh": "要占据神圣的埃及；这片原本安然无恙、"
    },
    {
      "id": "p0381",
      "zh": "坚定不移的土地，将遭诸神的烈怒。"
    },
    {
      "id": "p0382",
      "zh": "……使冬季变为夏季，"
    },
    {
      "id": "p0383",
      "zh": "那时，一切神谕都要应验。"
    },
    {
      "id": "p0384",
      "zh": "但当三个青年在奥林匹克竞技会"
    },
    {
      "id": "p0385",
      "zh": "获胜，而你吩咐那些通晓"
    },
    {
      "id": "p0386",
      "zh": "呼求神之神谕的人，先用"
    },
    {
      "id": "p0387",
      "zh": "吃奶的四足牲畜之血洁净时，"
    },
    {
      "id": "p0388",
      "zh": "至高者就要三次降下"
    },
    {
      "id": "p0389",
      "zh": "可怕的命运；他要向众人"
    },
    {
      "id": "p0390",
      "zh": "挥舞带来哀恸的长矛。那时，许多"
    },
    {
      "id": "p0391",
      "zh": "异族人的血要流在尘土中，"
    },
    {
      "id": "p0392",
      "zh": "因为那城要被不善待客旅的异乡人"
    },
    {
      "id": "p0393",
      "zh": "彻底洗劫。死去的人有福了，"
    },
    {
      "id": "p0394",
      "zh": "没有儿女的人"
    },
    {
      "id": "p0395",
      "zh": "也有福了；因为从前那位"
    },
    {
      "id": "p0396",
      "zh": "以自由人之名为称号的首领，"
    },
    {
      "id": "p0397",
      "zh": "曾在歌中享有盛名，如今不再"
    },
    {
      "id": "p0398",
      "zh": "思量先前的计划，却要将他们的颈项"
    },
    {
      "id": "p0399",
      "zh": "置于奴役的轭下。这位君主要施加"
    },
    {
      "id": "p0400",
      "zh": "这样的奴役，使人痛哭不已。"
    },
    {
      "id": "p0401",
      "zh": "随后，一支命运多舛的西西里军队"
    },
    {
      "id": "p0402",
      "zh": "要迅速来到，带来惊恐；"
    },
    {
      "id": "p0403",
      "zh": "那时，又有一个异族国家"
    },
    {
      "id": "p0404",
      "zh": "突然来攻；田里长出的庄稼，"
    },
    {
      "id": "p0405",
      "zh": "他们要从田间割去。至高的神，"
    },
    {
      "id": "p0406",
      "zh": "那发出雷声的，要赐给他们"
    },
    {
      "id": "p0407",
      "zh": "灾祸，取代福分；异乡人"
    },
    {
      "id": "p0408",
      "zh": "要不断从异乡人手中抢夺可憎的黄金。"
    },
    {
      "id": "p0409",
      "zh": "但当众人看见那"
    },
    {
      "id": "p0410",
      "zh": "食人狮子的血，又有一头"
    },
    {
      "id": "p0411",
      "zh": "嗜杀的母狮扑到它身上时，"
    },
    {
      "id": "p0412",
      "zh": "权杖要从它头上被抛落，"
    },
    {
      "id": "p0413",
      "zh": "从它那里被夺去。正如埃及"
    },
    {
      "id": "p0414",
      "zh": "全体百姓一同享用友好的筵席，"
    },
    {
      "id": "p0415",
      "zh": "他们各逞勇力，彼此"
    },
    {
      "id": "p0416",
      "zh": "拦阻，又有许多"
    },
    {
      "id": "p0417",
      "zh": "响亮的喊叫声；同样，"
    },
    {
      "id": "p0418",
      "zh": "狂暴争斗的恐惧要临到世人，"
    },
    {
      "id": "p0419",
      "zh": "许多人要彻底灭亡，"
    },
    {
      "id": "p0420",
      "zh": "另有些人要在激战中彼此残杀。"
    },
    {
      "id": "p0421",
      "zh": "随后，要有一个遍体覆着黑鳞的来到；"
    },
    {
      "id": "p0422",
      "zh": "另有两个要来，彼此"
    },
    {
      "id": "p0423",
      "zh": "同心行动，还有第三个与他们同来，"
    },
    {
      "id": "p0424",
      "zh": "就是出自古利奈的大公羊；我先前"
    },
    {
      "id": "p0425",
      "zh": "曾说过，他是尼罗河水边"
    },
    {
      "id": "p0426",
      "zh": "战争中的逃亡者；但他们全都走完的，"
    },
    {
      "id": "p0427",
      "zh": "绝不是一条失败的道路。"
    },
    {
      "id": "p0428",
      "zh": "此后，漫长的岁月流转，"
    },
    {
      "id": "p0429",
      "zh": "将有极其安静的日子；然而，"
    },
    {
      "id": "p0430",
      "zh": "后来他们又要在埃及"
    },
    {
      "id": "p0431",
      "zh": "遭遇第二场战争，"
    },
    {
      "id": "p0432",
      "zh": "且有一场海战；胜利"
    },
    {
      "id": "p0433",
      "zh": "却不属于他们。哦，困苦的人，"
    },
    {
      "id": "p0434",
      "zh": "那著名的城要被征服，"
    },
    {
      "id": "p0435",
      "zh": "但作战利品的日子不会长久。"
    },
    {
      "id": "p0436",
      "zh": "随后，那些拥有大片土地、疆界相邻的"
    },
    {
      "id": "p0437",
      "zh": "人，要悲惨地逃亡，带着"
    },
    {
      "id": "p0438",
      "zh": "他们困苦的父母。他们又要"
    },
    {
      "id": "p0439",
      "zh": "挟着大胜，进攻一片土地，"
    },
    {
      "id": "p0440",
      "zh": "毁灭那些坚守战阵的犹太人，"
    },
    {
      "id": "p0441",
      "zh": "在战争中一路蹂躏，直到苍茫的大海；"
    },
    {
      "id": "p0442",
      "zh": "两方都在最前列作战，"
    },
    {
      "id": "p0443",
      "zh": "为的是祖国和父母。一族"
    },
    {
      "id": "p0444",
      "zh": "曾高举战利品的人，要被算在"
    },
    {
      "id": "p0445",
      "zh": "死人之中。哦，将有多少人"
    },
    {
      "id": "p0446",
      "zh": "在波涛间游泳！因为沙滩上"
    },
    {
      "id": "p0447",
      "zh": "要躺卧许多人；金发的头颅"
    },
    {
      "id": "p0448",
      "zh": "要倒在埃及飞鸟的脚下。"
    },
    {
      "id": "p0449",
      "zh": "随后，世人的血"
    },
    {
      "id": "p0450",
      "zh": "要寻索阿拉伯人。但当狼与狗"
    },
    {
      "id": "p0451",
      "zh": "在四面环海的岛上郑重起誓，"
    },
    {
      "id": "p0452",
      "zh": "就要有高塔建起，"
    },
    {
      "id": "p0453",
      "zh": "人要住进那曾饱受苦难的"
    },
    {
      "id": "p0454",
      "zh": "城；因为不再有骗人的黄金"
    },
    {
      "id": "p0455",
      "zh": "或白银，不再争夺"
    },
    {
      "id": "p0456",
      "zh": "土地，也不再有辛苦的奴役。"
    },
    {
      "id": "p0457",
      "zh": "惟有牢固的友谊、共同的生活，"
    },
    {
      "id": "p0458",
      "zh": "心灵欢畅；一切都要共有，"
    },
    {
      "id": "p0459",
      "zh": "维生所需之物同享均等的光照。"
    },
    {
      "id": "p0460",
      "zh": "邪恶要从地上沉入"
    },
    {
      "id": "p0461",
      "zh": "浩瀚的大海。那时，世人"
    },
    {
      "id": "p0462",
      "zh": "收割的日子已经临近。"
    },
    {
      "id": "p0463",
      "zh": "这一切必须应验，"
    },
    {
      "id": "p0464",
      "zh": "有不可抗拒的命定催逼着。那时，"
    },
    {
      "id": "p0465",
      "zh": "再没有别的旅人会这样"
    },
    {
      "id": "p0466",
      "zh": "猜测，说人类虽必朽坏，"
    },
    {
      "id": "p0467",
      "zh": "却终将不复存在。"
    },
    {
      "id": "p0468",
      "zh": "随后，圣洁的国民要得胜，"
    },
    {
      "id": "p0469",
      "zh": "执掌全地的权柄，"
    },
    {
      "id": "p0470",
      "zh": "与他们大能的子孙一同，直到万代。"
    }
  ],
