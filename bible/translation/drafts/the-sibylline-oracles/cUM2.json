{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cUM2",
  "source_sha256": "5d104add2edb9b12406b270ac0fc5b05899f4d12713b0fb56453a30f0c780d00",
  "reviewed": false,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第八卷"
    },
    {
      "id": "p0002",
      "zh": "［引言，1—4行。五个王朝，5—21行。贪利之欲，21—46行。罗马的毁灭，47—63行。白发君王，61—83行。三位统治者，84—94行。罗马的苦难，95—115行。罗马最后的审判，116—140行。为罗马所作的哀歌，141—173行。拉丁诸王的第六代，174—182行。不死鸟显现，183—186行。罗马倾覆，187—210行。罗得岛、底比斯、埃及、罗马、提洛斯、撒摩斯和波斯人的灾祸，211—222行。弥赛亚君王，223—225行。灾祸与毁灭之日，226—251行。西卜的愿望，255—260行。万物的终结，261—283行。关于末日的基督教离合诗，284—330行。摩西预表弥赛亚，331—337行。弥赛亚救主的描绘，338—379行。钉十字架，380—410行。下到阴间与复活，411—429行。劝人尊荣弥赛亚君王，430—447行。再次描绘毁灭之日，448—475行。创造主借西卜自述，476—568行。向天上统治者呼告，569—607行。道成肉身，608—641行。附加的基督教训诫，642—669行。］"
    },
    {
      "id": "p0003",
      "zh": "神宣告大怒将来，"
    },
    {
      "id": "p0004",
      "zh": "在末后的时代临到不信的世界；"
    },
    {
      "id": "p0005",
      "zh": "我将这事显明，向所有世人"
    },
    {
      "id": "p0006",
      "zh": "按各自的城邑发出预言。自从"
    },
    {
      "id": "p0007",
      "zh": "高塔倒塌，世人的言语"
    },
    {
      "id": "p0008",
      "zh": "分成许多种"
    },
    {
      "id": "p0009",
      "zh": "人间的语言，首先建立的是埃及的"
    },
    {
      "id": "p0010",
      "zh": "王权，其后是波斯人、玛代人，"
    },
    {
      "id": "p0011",
      "zh": "以及古实人的，"
    },
    {
      "id": "p0012",
      "zh": "又有亚述和巴比伦的，"
    },
    {
      "id": "p0013",
      "zh": "然后是自夸的马其顿那极大的骄傲；"
    },
    {
      "id": "p0014",
      "zh": "第五个，最后那声名显赫、无法无天的"
    },
    {
      "id": "p0015",
      "zh": "意大利王国，必将许多灾祸"
    },
    {
      "id": "p0016",
      "zh": "带给全人类，耗尽各地"
    },
    {
      "id": "p0017",
      "zh": "世人的劳苦所得。它必将"
    },
    {
      "id": "p0018",
      "zh": "列国不肯屈服的君王带往西方，"
    },
    {
      "id": "p0019",
      "zh": "为万民立法，使万物臣服。"
    },
    {
      "id": "p0020",
      "zh": "神的磨虽迟延，却必磨出细面。"
    },
    {
      "id": "p0021",
      "zh": "随后，火必毁灭万物，将"
    },
    {
      "id": "p0022",
      "zh": "枝叶繁茂的高山之巅"
    },
    {
      "id": "p0023",
      "zh": "和一切血肉之躯化为微尘。万恶的首因，"
    },
    {
      "id": "p0024",
      "zh": "就是贪婪和愚昧。"
    },
    {
      "id": "p0025",
      "zh": "因为人必贪爱迷惑人的金子"
    },
    {
      "id": "p0026",
      "zh": "和银子；世人看它们"
    },
    {
      "id": "p0027",
      "zh": "高过一切，胜过日光、天空，"
    },
    {
      "id": "p0028",
      "zh": "胜过海洋和孕育万物的宽广大地，"
    },
    {
      "id": "p0029",
      "zh": "也胜过厚赐万物的神、"
    },
    {
      "id": "p0030",
      "zh": "万有之父；就连信实和敬虔，"
    },
    {
      "id": "p0031",
      "zh": "他们也不肯置于财物之上。不敬虔的"
    },
    {
      "id": "p0032",
      "zh": "泉源、混乱的先导、"
    },
    {
      "id": "p0033",
      "zh": "战争的工具、和平的仇敌，"
    },
    {
      "id": "p0034",
      "zh": "就是愚昧；它使"
    },
    {
      "id": "p0035",
      "zh": "父母儿女彼此为敌。在金子面前，"
    },
    {
      "id": "p0036",
      "zh": "连婚姻也毫不受尊重。"
    },
    {
      "id": "p0037",
      "zh": "地必划出边界，各海也有"
    },
    {
      "id": "p0038",
      "zh": "守卫，诡诈地分配"
    },
    {
      "id": "p0039",
      "zh": "给一切有金子的人。历世以来，"
    },
    {
      "id": "p0040",
      "zh": "那些企图占有滋养众人之土地的人，"
    },
    {
      "id": "p0041",
      "zh": "便这样掠夺劳苦的百姓，"
    },
    {
      "id": "p0042",
      "zh": "为要取得更广阔的地界，"
    },
    {
      "id": "p0043",
      "zh": "借虚假的名目使他们为奴。"
    },
    {
      "id": "p0044",
      "zh": "倘若广大地土没有把自己的宝座"
    },
    {
      "id": "p0045",
      "zh": "安在远离星空之处，"
    },
    {
      "id": "p0046",
      "zh": "世人便得不到平等的光；光也会被金子买去，"
    },
    {
      "id": "p0047",
      "zh": "只归富人，神就得"
    },
    {
      "id": "p0048",
      "zh": "为穷人另备一个世界。"
    },
    {
      "id": "p0049",
      "zh": "骄傲的罗马啊，有一天，"
    },
    {
      "id": "p0050",
      "zh": "你当受的天谴必从上头临到。"
    },
    {
      "id": "p0051",
      "zh": "你必首先低下颈项，"
    },
    {
      "id": "p0052",
      "zh": "被夷为平地；毁灭的火"
    },
    {
      "id": "p0053",
      "zh": "必将你全然焚尽，使你倒在"
    },
    {
      "id": "p0054",
      "zh": "自己的街面上，你的财富必消灭，"
    },
    {
      "id": "p0055",
      "zh": "狼和狐狸住在你的根基之中。"
    },
    {
      "id": "p0056",
      "zh": "那时，你必全然荒凉，"
    },
    {
      "id": "p0057",
      "zh": "如同不曾存在。你的帕拉狄昂在哪里？"
    },
    {
      "id": "p0058",
      "zh": "哪个神能救你？是金子造的，"
    },
    {
      "id": "p0059",
      "zh": "石头造的，还是铜造的？你元老院的"
    },
    {
      "id": "p0060",
      "zh": "谕令又在哪里？瑞亚的族类在哪里，"
    },
    {
      "id": "p0061",
      "zh": "克罗诺斯、宙斯，以及你所拜的一切，"
    },
    {
      "id": "p0062",
      "zh": "那些无生命的鬼魔，"
    },
    {
      "id": "p0063",
      "zh": "那些衰亡死人的形像，又在哪里？"
    },
    {
      "id": "p0064",
      "zh": "不幸的克里特竟以他们的坟墓为荣，"
    },
    {
      "id": "p0065",
      "zh": "用宝座尊奉无知觉的死人。"
    },
    {
      "id": "p0066",
      "zh": "但当你经历了奢靡的君王，"
    },
    {
      "id": "p0067",
      "zh": "三乘五位，从东方到"
    },
    {
      "id": "p0068",
      "zh": "西方奴役世界以后，必有一位君主，"
    },
    {
      "id": "p0069",
      "zh": "头发灰白，与附近的海同名，"
    },
    {
      "id": "p0070",
      "zh": "脚步敏捷，巡视世界，"
    },
    {
      "id": "p0071",
      "zh": "送出礼物，拥有大量金子，"
    },
    {
      "id": "p0072",
      "zh": "又掠夺更多可憎的银子，"
    },
    {
      "id": "p0073",
      "zh": "将它剥夺下来，收为己有。"
    },
    {
      "id": "p0074",
      "zh": "他必参与术士殿堂中"
    },
    {
      "id": "p0075",
      "zh": "一切秘仪，将他的孩子奉为神，"
    },
    {
      "id": "p0076",
      "zh": "废去一切圣物，又把"
    },
    {
      "id": "p0077",
      "zh": "古老、骗人的奥秘向众人揭露。"
    },
    {
      "id": "p0078",
      "zh": "到那时，那悲惨的人自己灭亡，"
    },
    {
      "id": "p0079",
      "zh": "时日何等悲伤！百姓还要说："
    },
    {
      "id": "p0080",
      "zh": "“城啊，你强大的势力必倾倒！”"
    },
    {
      "id": "p0081",
      "zh": "他们立刻察觉，灾祸的日子"
    },
    {
      "id": "p0082",
      "zh": "正在临近。父亲和幼小的孩子"
    },
    {
      "id": "p0083",
      "zh": "预见你极其悲惨的命运，"
    },
    {
      "id": "p0084",
      "zh": "就一同哀哭，高喊“有祸了，有祸了！”"
    },
    {
      "id": "p0085",
      "zh": "在可悲的台伯河岸举哀。"
    },
    {
      "id": "p0086",
      "zh": "在他以后，到末后的日子，"
    },
    {
      "id": "p0087",
      "zh": "必有三位掌权，成全天上"
    },
    {
      "id": "p0088",
      "zh": "神的一个名；权能属祂，"
    },
    {
      "id": "p0089",
      "zh": "从如今直到万代。其中一位年迈的，"
    },
    {
      "id": "p0090",
      "zh": "必长久掌握王杖，是极可怜的王，"
    },
    {
      "id": "p0091",
      "zh": "将世界一切财富"
    },
    {
      "id": "p0092",
      "zh": "关在自己的宅邸中看守，"
    },
    {
      "id": "p0093",
      "zh": "好等那弑母的逃亡者"
    },
    {
      "id": "p0094",
      "zh": "从地极"
    },
    {
      "id": "p0095",
      "zh": "归来的时候，将这些财富"
    },
    {
      "id": "p0096",
      "zh": "分给众人，使亚细亚大大富足。"
    },
    {
      "id": "p0097",
      "zh": "那时，你必哀哭，脱去"
    },
    {
      "id": "p0098",
      "zh": "你统帅身上宽条紫袍"
    },
    {
      "id": "p0099",
      "zh": "的光彩，换上哀服。"
    },
    {
      "id": "p0100",
      "zh": "骄傲的女王，拉丁罗马的后裔啊，"
    },
    {
      "id": "p0101",
      "zh": "你那傲慢的荣光"
    },
    {
      "id": "p0102",
      "zh": "再不属于你；命运悲惨的城，"
    },
    {
      "id": "p0103",
      "zh": "你再不能兴起，"
    },
    {
      "id": "p0104",
      "zh": "只能仆倒在地。就连那些"
    },
    {
      "id": "p0105",
      "zh": "举鹰徽军团的荣耀，也必衰落。"
    },
    {
      "id": "p0106",
      "zh": "你的权势在哪里？还有哪片盟国的土地，"
    },
    {
      "id": "p0107",
      "zh": "肯因你的愚妄，再受无法无天的奴役？"
    },
    {
      "id": "p0108",
      "zh": "那时，全地的世人必陷入混乱；"
    },
    {
      "id": "p0109",
      "zh": "因为全能者必亲自"
    },
    {
      "id": "p0110",
      "zh": "来到审判台，审判"
    },
    {
      "id": "p0111",
      "zh": "活人与死人的灵魂，以及整个世界。"
    },
    {
      "id": "p0112",
      "zh": "儿女不再爱父母，"
    },
    {
      "id": "p0113",
      "zh": "父母也不再爱儿女，因为"
    },
    {
      "id": "p0114",
      "zh": "他们不敬虔，又遭遇"
    },
    {
      "id": "p0115",
      "zh": "未料的患难。从此，哀哭切齿"
    },
    {
      "id": "p0116",
      "zh": "和流散、被征服，都归于你，"
    },
    {
      "id": "p0117",
      "zh": "众城倾覆，大地裂开深渊。"
    },
    {
      "id": "p0118",
      "zh": "当一条双眼充满火焰的龙，"
    },
    {
      "id": "p0119",
      "zh": "鼓着腹部，踏浪而来，"
    },
    {
      "id": "p0120",
      "zh": "苦害你的儿女，又有"
    },
    {
      "id": "p0121",
      "zh": "饥荒与亲族相残的战争，"
    },
    {
      "id": "p0122",
      "zh": "世界的终结和末日便近了，"
    },
    {
      "id": "p0123",
      "zh": "不朽之神的审判也临到那些"
    },
    {
      "id": "p0124",
      "zh": "蒙悦纳、被拣选的人。首先，"
    },
    {
      "id": "p0125",
      "zh": "必有不能平息的烈怒"
    },
    {
      "id": "p0126",
      "zh": "向罗马人发出，又有一个"
    },
    {
      "id": "p0127",
      "zh": "饮血和生活悲惨的时期临到。"
    },
    {
      "id": "p0128",
      "zh": "有祸了，有祸了，你这放肆的土地，"
    },
    {
      "id": "p0129",
      "zh": "野蛮的大国！你不明白，"
    },
    {
      "id": "p0130",
      "zh": "自己从哪里赤身而来，毫无价值，"
    },
    {
      "id": "p0131",
      "zh": "进入日光之下；你也必赤身"
    },
    {
      "id": "p0132",
      "zh": "回到那里，随后"
    },
    {
      "id": "p0133",
      "zh": "受审判，因为你曾不公地审判人。……"
    },
    {
      "id": "p0134",
      "zh": "有巨大的手从上方而来，"
    },
    {
      "id": "p0135",
      "zh": "独自遍及全世界；你必住在"
    },
    {
      "id": "p0136",
      "zh": "地底。石脑油、沥青、"
    },
    {
      "id": "p0137",
      "zh": "硫磺和大火必使你完全"
    },
    {
      "id": "p0138",
      "zh": "消失，成为燃烧的尘土，"
    },
    {
      "id": "p0139",
      "zh": "直到［永］世。凡看见的人，都必听见"
    },
    {
      "id": "p0140",
      "zh": "阴间传来巨大而悲痛的哀号，"
    },
    {
      "id": "p0141",
      "zh": "以及切齿的声音；你也必大声"
    },
    {
      "id": "p0142",
      "zh": "用双手捶打自己不敬虔的胸膛。"
    },
    {
      "id": "p0143",
      "zh": "因为同样的黑夜临到所有人，"
    },
    {
      "id": "p0144",
      "zh": "无分贫富；人从地上赤身而来，"
    },
    {
      "id": "p0145",
      "zh": "又赤身急急归于地，"
    },
    {
      "id": "p0146",
      "zh": "年日满了，便终止生命。"
    },
    {
      "id": "p0147",
      "zh": "那里没有奴隶，也没有主人或暴君，"
    },
    {
      "id": "p0148",
      "zh": "没有君王，也没有自高的首领，"
    },
    {
      "id": "p0149",
      "zh": "没有熟习律法的辩士，也没有"
    },
    {
      "id": "p0150",
      "zh": "为钱财断案的官长。人不再"
    },
    {
      "id": "p0151",
      "zh": "把祭牲的血作为奠祭"
    },
    {
      "id": "p0152",
      "zh": "倒在坛上；那里没有鼓声，"
    },
    {
      "id": "p0153",
      "zh": "也没有钹响……"
    },
    {
      "id": "p0154",
      "zh": "没有那能使人心智"
    },
    {
      "id": "p0155",
      "zh": "狂乱的多孔笛子，也没有"
    },
    {
      "id": "p0156",
      "zh": "形似弯曲之蛇的管乐声，"
    },
    {
      "id": "p0157",
      "zh": "没有那音调刺耳、传报战争的号角；"
    },
    {
      "id": "p0158",
      "zh": "没有人在无法无天的筵席中"
    },
    {
      "id": "p0159",
      "zh": "醉酒狂欢，或群舞作乐；"
    },
    {
      "id": "p0160",
      "zh": "没有竖琴声，也没有有害的乐器；"
    },
    {
      "id": "p0161",
      "zh": "死人中没有争斗、百般怒气和刀剑，"
    },
    {
      "id": "p0162",
      "zh": "只有所有人共有的永恒，"
    },
    {
      "id": "p0163",
      "zh": "保管着大监牢的钥匙，"
    },
    {
      "id": "p0164",
      "zh": "在神的审判台前。"
    },
    {
      "id": "p0165",
      "zh": "你带着金、银和石头的偶像，"
    },
    {
      "id": "p0166",
      "zh": "已经预备好，要来到那苦日，"
    },
    {
      "id": "p0167",
      "zh": "看见自己最初的刑罚，"
    },
    {
      "id": "p0168",
      "zh": "罗马啊，还要哀哭切齿。此后，"
    },
    {
      "id": "p0169",
      "zh": "叙利亚人和希腊人不再屈颈"
    },
    {
      "id": "p0170",
      "zh": "于你奴役的轭下；外邦人，"
    },
    {
      "id": "p0171",
      "zh": "以及别的民族，也不再如此。你必遭掠夺，"
    },
    {
      "id": "p0172",
      "zh": "承受自己从前加诸别人的苦难，"
    },
    {
      "id": "p0173",
      "zh": "在惧怕中哀哭，付出代价，直到"
    },
    {
      "id": "p0174",
      "zh": "偿还一切；你必成为世界"
    },
    {
      "id": "p0175",
      "zh": "得胜的展品，众人羞辱的对象。"
    },
    {
      "id": "p0176",
      "zh": "拉丁诸王的第六代，"
    },
    {
      "id": "p0177",
      "zh": "那时终于断绝生命，留下王杖。"
    },
    {
      "id": "p0178",
      "zh": "同族中另一位王必兴起掌权，"
    },
    {
      "id": "p0179",
      "zh": "统治全地，执掌众王杖；"
    },
    {
      "id": "p0180",
      "zh": "他拥有全权，遵照"
    },
    {
      "id": "p0181",
      "zh": "至大全能神的谕旨，治理自己的儿女，"
    },
    {
      "id": "p0182",
      "zh": "他的族类由坚定不移的儿女组成。"
    },
    {
      "id": "p0183",
      "zh": "时日轮转，命定就是如此，"
    },
    {
      "id": "p0184",
      "zh": "那时，埃及必有三乘五位君王。"
    },
    {
      "id": "p0185",
      "zh": "此后，当不死鸟"
    },
    {
      "id": "p0186",
      "zh": "所定的时限循环而至，必有一族"
    },
    {
      "id": "p0187",
      "zh": "来掠夺万民；混杂的众支派，"
    },
    {
      "id": "p0188",
      "zh": "作希伯来人的仇敌。随后，阿瑞斯"
    },
    {
      "id": "p0189",
      "zh": "必掠夺阿瑞斯，亲自"
    },
    {
      "id": "p0190",
      "zh": "摧毁罗马人傲慢的威吓。"
    },
    {
      "id": "p0191",
      "zh": "因为罗马的势力，在盛时就消逝了；"
    },
    {
      "id": "p0192",
      "zh": "她是古老的女王，四周众城环绕。"
    },
    {
      "id": "p0193",
      "zh": "罗马丰产的土地，"
    },
    {
      "id": "p0194",
      "zh": "再不能得胜；因为有一位要从亚细亚来，"
    },
    {
      "id": "p0195",
      "zh": "与阿瑞斯一同掌权。他行完"
    },
    {
      "id": "p0196",
      "zh": "这一切事以后，"
    },
    {
      "id": "p0197",
      "zh": "必来到城中。你必满了三乘三百"
    },
    {
      "id": "p0198",
      "zh": "再加四十八的数目；"
    },
    {
      "id": "p0199",
      "zh": "随后，凶险的命运强行夺取你，"
    },
    {
      "id": "p0200",
      "zh": "临到你身上，成全你的名。"
    },
    {
      "id": "p0201",
      "zh": "哦，我这三倍悲惨的人，有一天"
    },
    {
      "id": "p0202",
      "zh": "能看见那毁灭你的日子吗，罗马，"
    },
    {
      "id": "p0203",
      "zh": "那尤其毁灭所有拉丁人的日子？它以谋议"
    },
    {
      "id": "p0204",
      "zh": "尊荣那乘特洛伊战车而来的，"
    },
    {
      "id": "p0205",
      "zh": "带着身份隐秘的孩子，从亚细亚之地而出，"
    },
    {
      "id": "p0206",
      "zh": "心怀火焰。可当他"
    },
    {
      "id": "p0207",
      "zh": "急切地张望，穿过地峡，"
    },
    {
      "id": "p0208",
      "zh": "与众人为敌，越过大海时，"
    },
    {
      "id": "p0209",
      "zh": "黑血必追随那强大的兽。"
    },
    {
      "id": "p0210",
      "zh": "一只狗追赶那残害"
    },
    {
      "id": "p0211",
      "zh": "牧人的狮子。那时，人必夺去"
    },
    {
      "id": "p0212",
      "zh": "他的王杖，他也必下到阴间。"
    },
    {
      "id": "p0213",
      "zh": "罗得岛必遭最后的灾祸，"
    },
    {
      "id": "p0214",
      "zh": "也是最大的；底比斯随后也必"
    },
    {
      "id": "p0215",
      "zh": "惨遭征服，埃及"
    },
    {
      "id": "p0216",
      "zh": "必因统治者的邪恶而灭亡。"
    },
    {
      "id": "p0217",
      "zh": "那本是必死的人，"
    },
    {
      "id": "p0218",
      "zh": "此后若竟逃过这骤然的毁灭，"
    },
    {
      "id": "p0219",
      "zh": "就是三倍蒙福、四倍有福的人。"
    },
    {
      "id": "p0220",
      "zh": "罗马必成空房，提洛斯必黯淡，"
    },
    {
      "id": "p0221",
      "zh": "撒摩斯必成沙土……"
    },
    {
      "id": "p0222",
      "zh": "此后，又必有"
    },
    {
      "id": "p0223",
      "zh": "灾祸因波斯人的骄傲临到他们，"
    },
    {
      "id": "p0224",
      "zh": "他们一切的狂妄都必归于无有。"
    },
    {
      "id": "p0225",
      "zh": "那时，圣洁的全地之主"
    },
    {
      "id": "p0226",
      "zh": "使死人复活以后，必掌握王杖，"
    },
    {
      "id": "p0227",
      "zh": "直到万代。至高者必三次"
    },
    {
      "id": "p0228",
      "zh": "将悲惨的命运带给罗马，"
    },
    {
      "id": "p0229",
      "zh": "也带给众人；他们因自己的行为"
    },
    {
      "id": "p0230",
      "zh": "灭亡，却不肯听劝，"
    },
    {
      "id": "p0231",
      "zh": "本来听劝才是更可喜的。"
    },
    {
      "id": "p0232",
      "zh": "当灾祸迅速加增，"
    },
    {
      "id": "p0233",
      "zh": "饥荒和瘟疫的恶日，"
    },
    {
      "id": "p0234",
      "zh": "以及难以忍受的战争喧嚣临到，"
    },
    {
      "id": "p0235",
      "zh": "那先前胆大妄为的统治者必再次"
    },
    {
      "id": "p0236",
      "zh": "召集元老院，商议"
    },
    {
      "id": "p0237",
      "zh": "怎样全然毁灭……"
    },
    {
      "id": "p0238",
      "zh": "干旱之地必开花，叶子也"
    },
    {
      "id": "p0239",
      "zh": "一同长出；辽阔的天空"
    },
    {
      "id": "p0240",
      "zh": "必在坚硬的岩石上显出"
    },
    {
      "id": "p0241",
      "zh": "暴雨和烈焰，又使大风临到地上，"
    },
    {
      "id": "p0242",
      "zh": "并使全地满布"
    },
    {
      "id": "p0243",
      "zh": "有毒的种子。但他们仍以无耻的心"
    },
    {
      "id": "p0244",
      "zh": "行事，不怕"
    },
    {
      "id": "p0245",
      "zh": "神或人的愤怒，抛弃廉耻，"
    },
    {
      "id": "p0246",
      "zh": "渴慕贪婪的暴君，"
    },
    {
      "id": "p0247",
      "zh": "以及强暴、虚假、永不知足的罪人，"
    },
    {
      "id": "p0248",
      "zh": "作恶且毫无真诚的人，"
    },
    {
      "id": "p0249",
      "zh": "毁坏信义的人，说污言秽语、"
    },
    {
      "id": "p0250",
      "zh": "满口谎言的人；他们永不以财富为足，"
    },
    {
      "id": "p0251",
      "zh": "反倒厚颜无耻地掠夺更多；"
    },
    {
      "id": "p0252",
      "zh": "他们必在暴君的统治下灭亡。"
    },
    {
      "id": "p0253",
      "zh": "众星必全部向前坠入海中，"
    },
    {
      "id": "p0254",
      "zh": "一个接着一个；人却必在天空看见"
    },
    {
      "id": "p0255",
      "zh": "一颗明亮的彗星，作为"
    },
    {
      "id": "p0256",
      "zh": "大患难、战争和争斗将来的记号。"
    },
    {
      "id": "p0257",
      "zh": "愿我不要活在那欢喜女子掌权之时，"
    },
    {
      "id": "p0258",
      "zh": "却活在属天恩典在内掌权之时，"
    },
    {
      "id": "p0259",
      "zh": "活在圣婴以锁链制伏"
    },
    {
      "id": "p0260",
      "zh": "那残害众人的毁灭者之时，"
    },
    {
      "id": "p0261",
      "zh": "深渊被打开，显露出来；忽然，"
    },
    {
      "id": "p0262",
      "zh": "木屋必四面围住世人。"
    },
    {
      "id": "p0263",
      "zh": "当第十代"
    },
    {
      "id": "p0264",
      "zh": "在阴间的住处里以后，"
    },
    {
      "id": "p0265",
      "zh": "必有一位女子大权在握；"
    },
    {
      "id": "p0266",
      "zh": "她被加上王冠、得着王的尊荣时，"
    },
    {
      "id": "p0267",
      "zh": "神必亲自加增许多灾祸，"
    },
    {
      "id": "p0268",
      "zh": "整个时代都必不敬虔。"
    },
    {
      "id": "p0269",
      "zh": "太阳面目昏暗，却在夜里发光；"
    },
    {
      "id": "p0270",
      "zh": "众星必离开天空，狂风"
    },
    {
      "id": "p0271",
      "zh": "夹着大暴雨，使大地荒凉。"
    },
    {
      "id": "p0272",
      "zh": "死人必复活；"
    },
    {
      "id": "p0273",
      "zh": "瘸腿的人必奔跑极快，"
    },
    {
      "id": "p0274",
      "zh": "聋子能听，瞎子能看，"
    },
    {
      "id": "p0275",
      "zh": "不能说话的必开口说话；"
    },
    {
      "id": "p0276",
      "zh": "众人共享生命和财富。土地"
    },
    {
      "id": "p0277",
      "zh": "平等地归众人，不再被墙垣"
    },
    {
      "id": "p0278",
      "zh": "或篱笆分割，必结出更丰盛的果实。"
    },
    {
      "id": "p0279",
      "zh": "它还要赐下甜酒、鲜奶"
    },
    {
      "id": "p0280",
      "zh": "和蜂蜜的泉源……"
    },
    {
      "id": "p0281",
      "zh": "还有不朽之神［（大君王）］的审判。"
    },
    {
      "id": "p0282",
      "zh": "但当神改变时令……"
    },
    {
      "id": "p0283",
      "zh": "冬天生出夏天，那时，"
    },
    {
      "id": "p0284",
      "zh": "［一切］神谕都要［应验］……"
    },
    {
      "id": "p0285",
      "zh": "但当世界已经毁灭……"
    },
    {
      "id": "p0286",
      "zh": "大地必冒汗，因为"
    },
    {
      "id": "p0287",
      "zh": "审判的记号出现。从天而来的，"
    },
    {
      "id": "p0288",
      "zh": "是那要存到万代的君王，"
    },
    {
      "id": "p0289",
      "zh": "亲临审判一切有血肉之躯的和整个世界。"
    },
    {
      "id": "p0290",
      "zh": "信与不信的世人，在时日的终结，"
    },
    {
      "id": "p0291",
      "zh": "都必看见至高神与众圣者同在。"
    },
    {
      "id": "p0292",
      "zh": "祂坐在宝座上，审判有血肉之躯"
    },
    {
      "id": "p0293",
      "zh": "的灵魂；那时，全世界"
    },
    {
      "id": "p0294",
      "zh": "必成为荒漠和荆棘之地。"
    },
    {
      "id": "p0295",
      "zh": "世人必丢弃偶像"
    },
    {
      "id": "p0296",
      "zh": "和一切财富。察验的火必焚烧"
    },
    {
      "id": "p0297",
      "zh": "大地、诸天和海洋，也必烧毁"
    },
    {
      "id": "p0298",
      "zh": "阴间监牢的门户。那时，所有死人的"
    },
    {
      "id": "p0299",
      "zh": "肉身都要来到圣者自由的光中；"
    },
    {
      "id": "p0300",
      "zh": "不法之人却被火旋绕，"
    },
    {
      "id": "p0301",
      "zh": "直到永世。人暗中所做的一切，"
    },
    {
      "id": "p0302",
      "zh": "那时都必宣告出来；"
    },
    {
      "id": "p0303",
      "zh": "因为神要使幽暗的心敞在光中。"
    },
    {
      "id": "p0304",
      "zh": "众人必哀哭，"
    },
    {
      "id": "p0305",
      "zh": "切齿。太阳的光辉"
    },
    {
      "id": "p0306",
      "zh": "和众星的舞动，都必消隐。"
    },
    {
      "id": "p0307",
      "zh": "祂必卷起诸天，月亮"
    },
    {
      "id": "p0308",
      "zh": "的光也必灭没。祂必抬高"
    },
    {
      "id": "p0309",
      "zh": "山谷，摧毁群山的高处，"
    },
    {
      "id": "p0310",
      "zh": "再没有高峰"
    },
    {
      "id": "p0311",
      "zh": "留在人间。山岭必与平原"
    },
    {
      "id": "p0312",
      "zh": "齐平，所有海上也不再"
    },
    {
      "id": "p0313",
      "zh": "有船航行。那时，大地"
    },
    {
      "id": "p0314",
      "zh": "因炎热而干缩，奔腾的河流"
    },
    {
      "id": "p0315",
      "zh": "与泉源都必衰竭。号筒必从"
    },
    {
      "id": "p0316",
      "zh": "天上发出极其悲痛的声音，"
    },
    {
      "id": "p0317",
      "zh": "为可怜世人的可憎之事"
    },
    {
      "id": "p0318",
      "zh": "和世界的灾祸哀号。大地裂开，"
    },
    {
      "id": "p0319",
      "zh": "显出塔耳塔洛斯的混沌。列王"
    },
    {
      "id": "p0320",
      "zh": "必来到神的审判台前。"
    },
    {
      "id": "p0321",
      "zh": "天上必流下一道"
    },
    {
      "id": "p0322",
      "zh": "火与硫磺的河。但那时，所有世人"
    },
    {
      "id": "p0323",
      "zh": "必有一个记号，一个鲜明的印记："
    },
    {
      "id": "p0324",
      "zh": "就是信徒中间的木架，以及"
    },
    {
      "id": "p0325",
      "zh": "众人切慕的角，敬虔之人的生命；"
    },
    {
      "id": "p0326",
      "zh": "它却是世界的绊脚石，"
    },
    {
      "id": "p0327",
      "zh": "借着十二道泉源的水，"
    },
    {
      "id": "p0328",
      "zh": "使蒙拣选的人得光照；又必有"
    },
    {
      "id": "p0329",
      "zh": "牧养的铁杖掌权。这一位如今"
    },
    {
      "id": "p0330",
      "zh": "在显明神之记号的离合诗中，"
    },
    {
      "id": "p0331",
      "zh": "公开写出，就是救主，"
    },
    {
      "id": "p0332",
      "zh": "不朽的君王，为我们受苦的那位。"
    },
    {
      "id": "p0333",
      "zh": "摩西曾预表祂，伸出"
    },
    {
      "id": "p0334",
      "zh": "圣洁的双臂，凭信心战胜亚玛力，"
    },
    {
      "id": "p0335",
      "zh": "使百姓知道，祂是蒙拣选、"
    },
    {
      "id": "p0336",
      "zh": "在父神面前受尊荣的，"
    },
    {
      "id": "p0337",
      "zh": "是大卫的杖，也是那块"
    },
    {
      "id": "p0338",
      "zh": "确曾应许的石头；"
    },
    {
      "id": "p0339",
      "zh": "信靠祂的人，必得永生。"
    },
    {
      "id": "p0340",
      "zh": "祂来到受造界，不是带着荣耀，"
    },
    {
      "id": "p0341",
      "zh": "而是像必死的人一样，贫弱可怜，"
    },
    {
      "id": "p0342",
      "zh": "不受尊重，没有佳形美容，为要"
    },
    {
      "id": "p0343",
      "zh": "赐可怜的人盼望。祂要赐"
    },
    {
      "id": "p0344",
      "zh": "必朽的肉身美好的形貌，赐不信的人"
    },
    {
      "id": "p0345",
      "zh": "属天的信心；又将美好的形貌赐给"
    },
    {
      "id": "p0346",
      "zh": "那从起初由神圣手"
    },
    {
      "id": "p0347",
      "zh": "所造的人。他被蛇用诡计"
    },
    {
      "id": "p0348",
      "zh": "引入迷途，走向"
    },
    {
      "id": "p0349",
      "zh": "死亡的命运，得到"
    },
    {
      "id": "p0350",
      "zh": "分辨善恶的知识，便离弃神，"
    },
    {
      "id": "p0351",
      "zh": "随从世人的道路。因为起初，"
    },
    {
      "id": "p0352",
      "zh": "全能者从开始就以祂作"
    },
    {
      "id": "p0353",
      "zh": "一同商议的，说："
    },
    {
      "id": "p0354",
      "zh": "“我儿，我们共同造必死的众族，"
    },
    {
      "id": "p0355",
      "zh": "将我们形像的印记印在他们身上；"
    },
    {
      "id": "p0356",
      "zh": "如今，我以双手，你在后来以道，"
    },
    {
      "id": "p0357",
      "zh": "照管我们所造的形体，"
    },
    {
      "id": "p0358",
      "zh": "使我们共同让它兴起。”"
    },
    {
      "id": "p0359",
      "zh": "祂记着这旨意，必来到"
    },
    {
      "id": "p0360",
      "zh": "受造界，来到圣洁的童女那里，"
    },
    {
      "id": "p0361",
      "zh": "带来与预表相应的真像，"
    },
    {
      "id": "p0362",
      "zh": "借长老的手用水施洗，"
    },
    {
      "id": "p0363",
      "zh": "用道成就一切，"
    },
    {
      "id": "p0364",
      "zh": "医治各样疾病。祂一句话"
    },
    {
      "id": "p0365",
      "zh": "便使风止息，用祂的脚"
    },
    {
      "id": "p0366",
      "zh": "平静怒海，怀着平安的信心"
    },
    {
      "id": "p0367",
      "zh": "在海上行走。祂用五个饼"
    },
    {
      "id": "p0368",
      "zh": "和一条海鱼，使五千人"
    },
    {
      "id": "p0369",
      "zh": "在旷野吃饱；随后取来"
    },
    {
      "id": "p0370",
      "zh": "一切剩下的碎屑，为万民的盼望，"
    },
    {
      "id": "p0371",
      "zh": "装满十二个篮子。"
    },
    {
      "id": "p0372",
      "zh": "祂要呼召蒙福的灵魂，"
    },
    {
      "id": "p0373",
      "zh": "怜爱可怜的人；他们虽遭嘲弄，"
    },
    {
      "id": "p0374",
      "zh": "被打、被鞭笞，却以善报恶，"
    },
    {
      "id": "p0375",
      "zh": "甘愿贫穷。那洞察一切、"
    },
    {
      "id": "p0376",
      "zh": "看见一切、听见一切的，"
    },
    {
      "id": "p0377",
      "zh": "必鉴察人心，使其显露，接受责断；"
    },
    {
      "id": "p0378",
      "zh": "因为祂自己就是万有的耳、"
    },
    {
      "id": "p0379",
      "zh": "心智和眼睛，也是塑造形体的道，"
    },
    {
      "id": "p0380",
      "zh": "万物都服在祂之下；祂保全"
    },
    {
      "id": "p0381",
      "zh": "已死的人，医治各样疾病。"
    },
    {
      "id": "p0382",
      "zh": "最后，祂必落入不法"
    },
    {
      "id": "p0383",
      "zh": "和不信之人的手；他们要用不洁的手"
    },
    {
      "id": "p0384",
      "zh": "残酷地鞭打神，"
    },
    {
      "id": "p0385",
      "zh": "用污秽的口吐出恶毒的唾沫。"
    },
    {
      "id": "p0386",
      "zh": "那时，祂公开将自己的"
    },
    {
      "id": "p0387",
      "zh": "圣背交给鞭子；[[因为祂必亲自将一位"
    },
    {
      "id": "p0388",
      "zh": "圣洁的童女托付给世界。]]"
    },
    {
      "id": "p0389",
      "zh": "祂受掌掴，却不作声，"
    },
    {
      "id": "p0390",
      "zh": "免得有人知道祂是谁的儿子，"
    },
    {
      "id": "p0391",
      "zh": "从哪里来，好使祂能向死人说话。"
    },
    {
      "id": "p0392",
      "zh": "祂也必戴上荆棘冠冕；"
    },
    {
      "id": "p0393",
      "zh": "因为荆棘的冠冕，是蒙拣选、"
    },
    {
      "id": "p0394",
      "zh": "永恒的装饰。他们必用芦苇刺入祂的肋旁，"
    },
    {
      "id": "p0395",
      "zh": "为要成全他们的律法；"
    },
    {
      "id": "p0396",
      "zh": "因为被另一种灵吹动的芦苇，"
    },
    {
      "id": "p0397",
      "zh": "滋养了灵魂中"
    },
    {
      "id": "p0398",
      "zh": "愤怒和报复的倾向。但当我所说的"
    },
    {
      "id": "p0399",
      "zh": "这些事都成就了，"
    },
    {
      "id": "p0400",
      "zh": "一切律法都必因祂而解开，"
    },
    {
      "id": "p0401",
      "zh": "那律法起初按人的谕令，"
    },
    {
      "id": "p0402",
      "zh": "因悖逆的百姓而赐下。"
    },
    {
      "id": "p0403",
      "zh": "祂必伸开双手，量度全世界。"
    },
    {
      "id": "p0404",
      "zh": "他们却给祂苦胆作食物，醋作饮料，"
    },
    {
      "id": "p0405",
      "zh": "把这样待客无礼的筵席"
    },
    {
      "id": "p0406",
      "zh": "摆在祂面前。但圣殿的幔子"
    },
    {
      "id": "p0407",
      "zh": "必裂为两半，正午"
    },
    {
      "id": "p0408",
      "zh": "必有三小时可怕的黑夜。"
    },
    {
      "id": "p0409",
      "zh": "因为当永恒者亲自来到地上，"
    },
    {
      "id": "p0410",
      "zh": "人不再被指示如何服侍隐秘的圣殿和律法，"
    },
    {
      "id": "p0411",
      "zh": "那些曾被世界的外表遮盖的事，"
    },
    {
      "id": "p0412",
      "zh": "此时都临到这境地。"
    },
    {
      "id": "p0413",
      "zh": "祂必下到阴间，向众圣者"
    },
    {
      "id": "p0414",
      "zh": "宣告盼望、历世的终结"
    },
    {
      "id": "p0415",
      "zh": "和末日。祂安睡，"
    },
    {
      "id": "p0416",
      "zh": "到了第三日，便结束死亡的命定；"
    },
    {
      "id": "p0417",
      "zh": "随后离开死人，来到"
    },
    {
      "id": "p0418",
      "zh": "光中，首先向蒙拣选的人显明"
    },
    {
      "id": "p0419",
      "zh": "复活的开端，并借着"
    },
    {
      "id": "p0420",
      "zh": "不朽泉源的水，洗净"
    },
    {
      "id": "p0421",
      "zh": "他们从前的邪恶，使他们从上"
    },
    {
      "id": "p0422",
      "zh": "而生，不再受"
    },
    {
      "id": "p0423",
      "zh": "世界不法的习俗奴役。"
    },
    {
      "id": "p0424",
      "zh": "随后，祂首先要向属自己的人，"
    },
    {
      "id": "p0425",
      "zh": "以肉身公开显现为主，"
    },
    {
      "id": "p0426",
      "zh": "如同从前一样；祂要在手脚"
    },
    {
      "id": "p0427",
      "zh": "显出刻在肢体上的四处伤痕，"
    },
    {
      "id": "p0428",
      "zh": "表明东方、西方、南方和北方；"
    },
    {
      "id": "p0429",
      "zh": "因为世上这许多王权"
    },
    {
      "id": "p0430",
      "zh": "必向我们的典范，行出"
    },
    {
      "id": "p0431",
      "zh": "那不法而当受谴责的事。"
    },
    {
      "id": "p0432",
      "zh": "圣洁的锡安女子，你要欢喜，"
    },
    {
      "id": "p0433",
      "zh": "你曾受许多苦；你的王亲自"
    },
    {
      "id": "p0434",
      "zh": "骑着驴驹，急速前来。"
    },
    {
      "id": "p0435",
      "zh": "看哪，祂温柔而来，要卸下"
    },
    {
      "id": "p0436",
      "zh": "我们难以承受的奴役之轭，"
    },
    {
      "id": "p0437",
      "zh": "那压在颈上的重担；又要废除"
    },
    {
      "id": "p0438",
      "zh": "我们不敬虔的律法和强加的束缚。"
    },
    {
      "id": "p0439",
      "zh": "你当真切认识自己的神，祂就是神的儿子；"
    },
    {
      "id": "p0440",
      "zh": "荣耀祂，将祂存在心中，"
    },
    {
      "id": "p0441",
      "zh": "从灵魂深处爱祂，高举祂的名。"
    },
    {
      "id": "p0442",
      "zh": "离弃从前的朋友，将自己"
    },
    {
      "id": "p0443",
      "zh": "洗净，脱离他们的血；因为祂不因你的歌声"
    },
    {
      "id": "p0444",
      "zh": "或祈祷而息怒，也不顾念"
    },
    {
      "id": "p0445",
      "zh": "必朽的祭牲，"
    },
    {
      "id": "p0446",
      "zh": "因为祂是不朽的。你当"
    },
    {
      "id": "p0447",
      "zh": "从有悟性的口中献上圣洁的颂歌，"
    },
    {
      "id": "p0448",
      "zh": "认识这一位是谁，你便必"
    },
    {
      "id": "p0449",
      "zh": "看见父……"
    },
    {
      "id": "p0450",
      "zh": "那时，世界的一切元素"
    },
    {
      "id": "p0451",
      "zh": "必孤寂独存：空气、大地、海洋、"
    },
    {
      "id": "p0452",
      "zh": "明亮的火光、天空、黑夜，"
    },
    {
      "id": "p0453",
      "zh": "以及一切白昼，都要汇成一体，"
    },
    {
      "id": "p0454",
      "zh": "成为全然荒凉的形貌。"
    },
    {
      "id": "p0455",
      "zh": "因为天上一切发光的星都必坠落。"
    },
    {
      "id": "p0456",
      "zh": "羽翼丰满的飞鸟不再"
    },
    {
      "id": "p0457",
      "zh": "翱翔空中，地上也没有足迹；"
    },
    {
      "id": "p0458",
      "zh": "因为野兽全都灭亡，不再有"
    },
    {
      "id": "p0459",
      "zh": "人声、兽声或鸟鸣。"
    },
    {
      "id": "p0460",
      "zh": "世界陷入混乱，听不见有用的声音，"
    },
    {
      "id": "p0461",
      "zh": "只有深海高声发出"
    },
    {
      "id": "p0462",
      "zh": "威吓的巨响。"
    },
    {
      "id": "p0463",
      "zh": "海中游动的生物都必战兢"
    },
    {
      "id": "p0464",
      "zh": "而死；海浪上不再"
    },
    {
      "id": "p0465",
      "zh": "有载货的船航行。大地因战争"
    },
    {
      "id": "p0466",
      "zh": "染满鲜血，发出呻吟；世人的灵魂"
    },
    {
      "id": "p0467",
      "zh": "都必切齿，[[不法的灵魂"
    },
    {
      "id": "p0468",
      "zh": "又大声哀哭，满心恐惧，]]他们被"
    },
    {
      "id": "p0469",
      "zh": "干渴、饥荒、瘟疫和杀戮摧残，"
    },
    {
      "id": "p0470",
      "zh": "称死亡为美事；死亡"
    },
    {
      "id": "p0471",
      "zh": "却逃避他们，因为死亡和黑夜"
    },
    {
      "id": "p0472",
      "zh": "都不再给他们安息。他们必向"
    },
    {
      "id": "p0473",
      "zh": "在高处掌权的神多多恳求，却归徒然，"
    },
    {
      "id": "p0474",
      "zh": "那时，祂必公然转脸，"
    },
    {
      "id": "p0475",
      "zh": "不再看顾他们。因为祂已借"
    },
    {
      "id": "p0476",
      "zh": "无玷污童女的手，在七个世代中，"
    },
    {
      "id": "p0477",
      "zh": "给迷途的人悔改的记号。"
    },
    {
      "id": "p0478",
      "zh": "这一切，神亲自在我心中显明；"
    },
    {
      "id": "p0479",
      "zh": "凡我口中所说的，"
    },
    {
      "id": "p0480",
      "zh": "祂都必成就：“我知道"
    },
    {
      "id": "p0481",
      "zh": "沙的数目和海的尺度，"
    },
    {
      "id": "p0482",
      "zh": "我知道大地最深处"
    },
    {
      "id": "p0483",
      "zh": "和幽暗的塔耳塔洛斯。我知道"
    },
    {
      "id": "p0484",
      "zh": "众星、树木，以及四足走兽"
    },
    {
      "id": "p0485",
      "zh": "的各个族类、游泳的生物"
    },
    {
      "id": "p0486",
      "zh": "和飞鸟的数目，也知道如今活着的人、"
    },
    {
      "id": "p0487",
      "zh": "将来的人，以及死去的人。"
    },
    {
      "id": "p0488",
      "zh": "因为我亲自塑造人的形貌"
    },
    {
      "id": "p0489",
      "zh": "和心智，赐下正确的理性，"
    },
    {
      "id": "p0490",
      "zh": "教导知识。我造了眼睛和耳朵，"
    },
    {
      "id": "p0491",
      "zh": "能看、能听，辨明每一个意念，"
    },
    {
      "id": "p0492",
      "zh": "内心知晓一切，"
    },
    {
      "id": "p0493",
      "zh": "却保持静默；此后，我必指证，"
    },
    {
      "id": "p0494",
      "zh": "[[惩罚凡人在隐秘处"
    },
    {
      "id": "p0495",
      "zh": "所行的事，来到神的审判台上，"
    },
    {
      "id": "p0496",
      "zh": "向世人说话。]]"
    },
    {
      "id": "p0497",
      "zh": "我明白哑巴，也听得见"
    },
    {
      "id": "p0498",
      "zh": "不说话的人；我知道从大地"
    },
    {
      "id": "p0499",
      "zh": "到诸天的整个高度，"
    },
    {
      "id": "p0500",
      "zh": "也知道始与终，因为我造了天地。"
    },
    {
      "id": "p0501",
      "zh": "[[万物都从祂而出，从起初"
    },
    {
      "id": "p0502",
      "zh": "直到末了，祂都知道。]]"
    },
    {
      "id": "p0503",
      "zh": "因为唯独我是神，别无"
    },
    {
      "id": "p0504",
      "zh": "他神。人用木头造出我的形像，"
    },
    {
      "id": "p0505",
      "zh": "用手塑造，当作神明，"
    },
    {
      "id": "p0506",
      "zh": "向着无言的偶像唱赞歌，"
    },
    {
      "id": "p0507",
      "zh": "献上祈求和不洁的礼仪。"
    },
    {
      "id": "p0508",
      "zh": "他们离弃创造主，作了淫欲"
    },
    {
      "id": "p0509",
      "zh": "的奴隶。拥有万物的人，"
    },
    {
      "id": "p0510",
      "zh": "却将礼物送给不能帮助他们的东西，"
    },
    {
      "id": "p0511",
      "zh": "仿佛以为这些东西全都"
    },
    {
      "id": "p0512",
      "zh": "有助于尊荣我；他们使祭牲的气味"
    },
    {
      "id": "p0513",
      "zh": "充满筵席，仿佛在祭奠自家的死人。"
    },
    {
      "id": "p0514",
      "zh": "他们将肉和满是骨髓的骨头"
    },
    {
      "id": "p0515",
      "zh": "献在坛上焚烧，向鬼魔"
    },
    {
      "id": "p0516",
      "zh": "倾倒血，又给我这赐光者点灯，"
    },
    {
      "id": "p0517",
      "zh": "还仿佛我是一位"
    },
    {
      "id": "p0518",
      "zh": "口渴的神，醉酒的凡人"
    },
    {
      "id": "p0519",
      "zh": "徒然向不能帮助人的偶像奠酒。"
    },
    {
      "id": "p0520",
      "zh": "我不需要你们的燔祭，"
    },
    {
      "id": "p0521",
      "zh": "也不需要奠祭、污秽的烟，"
    },
    {
      "id": "p0522",
      "zh": "或极可憎的血。他们为记念"
    },
    {
      "id": "p0523",
      "zh": "君王和暴君而行这些事，"
    },
    {
      "id": "p0524",
      "zh": "将死去的鬼魔当作天上的存在，"
    },
    {
      "id": "p0525",
      "zh": "献上不敬虔、带来毁灭的服侍。"
    },
    {
      "id": "p0526",
      "zh": "他们不敬虔，称偶像为神，"
    },
    {
      "id": "p0527",
      "zh": "离弃创造主，相信"
    },
    {
      "id": "p0528",
      "zh": "自己一切盼望和生命都来自偶像；"
    },
    {
      "id": "p0529",
      "zh": "他们又聋又哑，信靠邪恶，"
    },
    {
      "id": "p0530",
      "zh": "却全然不认识良善。"
    },
    {
      "id": "p0531",
      "zh": "我亲自将两条路摆在他们面前，"
    },
    {
      "id": "p0532",
      "zh": "就是生命与死亡，又赐他们"
    },
    {
      "id": "p0533",
      "zh": "判断力，选择美好的生命；他们自己却"
    },
    {
      "id": "p0534",
      "zh": "急奔向死亡和永远的火。"
    },
    {
      "id": "p0535",
      "zh": "人是我的形像，具有正直的理性。"
    },
    {
      "id": "p0536",
      "zh": "你们要为他预备洁净、无血的"
    },
    {
      "id": "p0537",
      "zh": "筵席，摆满美物；"
    },
    {
      "id": "p0538",
      "zh": "给饥饿的饼，给口渴的饮料，"
    },
    {
      "id": "p0539",
      "zh": "给赤身的衣裳，"
    },
    {
      "id": "p0540",
      "zh": "以自己劳苦所得，用无玷污的双手"
    },
    {
      "id": "p0541",
      "zh": "供应。使受苦的人重新得力，"
    },
    {
      "id": "p0542",
      "zh": "扶助疲乏者；又向我，"
    },
    {
      "id": "p0543",
      "zh": "这永生者，献上活祭，"
    },
    {
      "id": "p0544",
      "zh": "撒下敬虔的种子，好让我有一天"
    },
    {
      "id": "p0545",
      "zh": "赐你们不朽的果实；你们必得永恒的光，"
    },
    {
      "id": "p0546",
      "zh": "和永不衰残的生命，"
    },
    {
      "id": "p0547",
      "zh": "那时，我要用火试验一切。"
    },
    {
      "id": "p0548",
      "zh": "我必熔炼万物，拣出纯净的；"
    },
    {
      "id": "p0549",
      "zh": "卷起诸天，敞开大地深处，"
    },
    {
      "id": "p0550",
      "zh": "随后使死人复活，"
    },
    {
      "id": "p0551",
      "zh": "终止命定和死亡的毒钩；"
    },
    {
      "id": "p0552",
      "zh": "此后，我必来审判，"
    },
    {
      "id": "p0553",
      "zh": "判断敬虔者和"
    },
    {
      "id": "p0554",
      "zh": "不敬虔者的行事。我将公羊与公羊相近，"
    },
    {
      "id": "p0555",
      "zh": "牧人与牧人、牛犊与牛犊相近，接受试验，"
    },
    {
      "id": "p0556",
      "zh": "都彼此挨着。凡那些"
    },
    {
      "id": "p0557",
      "zh": "被高举、受试验察验的人，堵住"
    },
    {
      "id": "p0558",
      "zh": "众人的口，为了自己"
    },
    {
      "id": "p0559",
      "zh": "与过圣洁生活的人相争，"
    },
    {
      "id": "p0560",
      "zh": "将他们也置于奴役之下，"
    },
    {
      "id": "p0561",
      "zh": "吩咐他们闭口，被贪利之心驱使，"
    },
    {
      "id": "p0562",
      "zh": "在我面前未经认可的，那时都必退去。"
    },
    {
      "id": "p0563",
      "zh": "此后，你们不再忧愁地说："
    },
    {
      "id": "p0564",
      "zh": "‘明日将到’，或‘昨日已过’；"
    },
    {
      "id": "p0565",
      "zh": "没有许多忧虑的日子，没有春冬，"
    },
    {
      "id": "p0566",
      "zh": "没有夏秋，没有日落，"
    },
    {
      "id": "p0567",
      "zh": "也没有日出；因为我必造一个漫长的白昼。"
    },
    {
      "id": "p0568",
      "zh": "直到万代，必有那为人渴慕的"
    },
    {
      "id": "p0569",
      "zh": "伟大者的光……”"
    },
    {
      "id": "p0570",
      "zh": "[[万世的基督耶稣]]……"
    },
    {
      "id": "p0571",
      "zh": "祢是自有、无玷污的，"
    },
    {
      "id": "p0572",
      "zh": "真实而永恒，以大能量度"
    },
    {
      "id": "p0573",
      "zh": "从天而来的炽热气息，以猛烈的火把"
    },
    {
      "id": "p0574",
      "zh": "止住王杖的碰撞，平息"
    },
    {
      "id": "p0575",
      "zh": "震耳雷霆的轰鸣，"
    },
    {
      "id": "p0576",
      "zh": "使大地震乱，却又"
    },
    {
      "id": "p0577",
      "zh": "约束奔涌的响声。……"
    },
    {
      "id": "p0578",
      "zh": "祢钝化那火焰般的"
    },
    {
      "id": "p0579",
      "zh": "闪电之鞭，抑制倾盆的风暴，"
    },
    {
      "id": "p0580",
      "zh": "秋日的冰雹，云层的寒冷"
    },
    {
      "id": "p0581",
      "zh": "击打，以及严冬的袭击；因为这一切"
    },
    {
      "id": "p0582",
      "zh": "每一样都在祢心中定明。"
    },
    {
      "id": "p0583",
      "zh": "凡祢自己看为美、愿意行的，"
    },
    {
      "id": "p0584",
      "zh": "祢的儿子都点头赞同；在一切"
    },
    {
      "id": "p0585",
      "zh": "受造之物以前，祂已在祢怀中"
    },
    {
      "id": "p0586",
      "zh": "受生，与祢一同商议，"
    },
    {
      "id": "p0587",
      "zh": "塑造世人，创造生命。"
    },
    {
      "id": "p0588",
      "zh": "祢口中最初甜美的话，"
    },
    {
      "id": "p0589",
      "zh": "是向祂说：“看哪，我们要造人，"
    },
    {
      "id": "p0590",
      "zh": "使他的形貌全然像我们，"
    },
    {
      "id": "p0591",
      "zh": "赐他维持生命的气息；"
    },
    {
      "id": "p0592",
      "zh": "他虽然必死，世界万物"
    },
    {
      "id": "p0593",
      "zh": "都要服侍他。他由尘土造成，"
    },
    {
      "id": "p0594",
      "zh": "我们却使万物服在他以下。”祢以言语"
    },
    {
      "id": "p0595",
      "zh": "说出这些事，一切都照"
    },
    {
      "id": "p0596",
      "zh": "祢心意成就；所有元素"
    },
    {
      "id": "p0597",
      "zh": "一同听从祢的命令，"
    },
    {
      "id": "p0598",
      "zh": "永恒的受造者被安置"
    },
    {
      "id": "p0599",
      "zh": "于必死的形体中；又有诸天、空气、火，"
    },
    {
      "id": "p0600",
      "zh": "大地、海水、太阳、月亮，"
    },
    {
      "id": "p0601",
      "zh": "众星的歌队、群山……"
    },
    {
      "id": "p0602",
      "zh": "黑夜与白昼，睡眠与醒来，"
    },
    {
      "id": "p0603",
      "zh": "灵与情感，魂与悟性，"
    },
    {
      "id": "p0604",
      "zh": "技艺、能力和力量，以及野外众族，"
    },
    {
      "id": "p0605",
      "zh": "各种活物，无论水中的、飞翔的、"
    },
    {
      "id": "p0606",
      "zh": "行走的，还是两栖的，"
    },
    {
      "id": "p0607",
      "zh": "爬行的，或兼有双重性质的；"
    },
    {
      "id": "p0608",
      "zh": "因为祂按自己的旨意，"
    },
    {
      "id": "p0609",
      "zh": "在祢引领下安排了万物。"
    },
    {
      "id": "p0610",
      "zh": "但到了末后的日子，祂行过大地，"
    },
    {
      "id": "p0611",
      "zh": "后来从童女马利亚腹中出来，"
    },
    {
      "id": "p0612",
      "zh": "一道新光升起；祂从天而出，"
    },
    {
      "id": "p0613",
      "zh": "披上必死之人的形体。加百列首先显出"
    },
    {
      "id": "p0614",
      "zh": "自己强健、纯洁的形貌，带着消息，"
    },
    {
      "id": "p0615",
      "zh": "随后开口对少女说："
    },
    {
      "id": "p0616",
      "zh": "“童女啊，你要在无玷污的腹中"
    },
    {
      "id": "p0617",
      "zh": "领受神。”说着，他向这温柔的少女"
    },
    {
      "id": "p0618",
      "zh": "吹入神的恩典；她一听见，"
    },
    {
      "id": "p0619",
      "zh": "惊惧与诧异立刻抓住她，"
    },
    {
      "id": "p0620",
      "zh": "她站着战兢，思绪纷乱，"
    },
    {
      "id": "p0621",
      "zh": "心神激荡，"
    },
    {
      "id": "p0622",
      "zh": "因听见意想不到的事而发抖。"
    },
    {
      "id": "p0623",
      "zh": "但她又欢喜起来，"
    },
    {
      "id": "p0624",
      "zh": "声音使她心中振奋；少女笑了，"
    },
    {
      "id": "p0625",
      "zh": "脸颊因喜乐泛红，"
    },
    {
      "id": "p0626",
      "zh": "心里又因羞怯而怔住。"
    },
    {
      "id": "p0627",
      "zh": "她得了信心。道"
    },
    {
      "id": "p0628",
      "zh": "进入她腹中，随着时候来到，"
    },
    {
      "id": "p0629",
      "zh": "成为有生命的肉身，"
    },
    {
      "id": "p0630",
      "zh": "具备人的形体，成为"
    },
    {
      "id": "p0631",
      "zh": "一个因童女生育而不同寻常的男孩。"
    },
    {
      "id": "p0632",
      "zh": "这在世人是大奇事，"
    },
    {
      "id": "p0633",
      "zh": "在父神却不算大奇事，"
    },
    {
      "id": "p0634",
      "zh": "在神的儿子也是如此。"
    },
    {
      "id": "p0635",
      "zh": "欢喜的大地迎接初生婴孩，"
    },
    {
      "id": "p0636",
      "zh": "天上的宝座欢笑，世界欢腾。"
    },
    {
      "id": "p0637",
      "zh": "新显现、宣告预言的星，"
    },
    {
      "id": "p0638",
      "zh": "受到博士尊崇；这初生的婴孩"
    },
    {
      "id": "p0639",
      "zh": "在马槽里，显给那些"
    },
    {
      "id": "p0640",
      "zh": "顺服神的人、牧养牛群的人，"
    },
    {
      "id": "p0641",
      "zh": "牧养山羊的人和绵羊的牧人。"
    },
    {
      "id": "p0642",
      "zh": "伯利恒，神称为道之故乡的地方，"
    },
    {
      "id": "p0643",
      "zh": "蒙了拣选……"
    },
    {
      "id": "p0644",
      "zh": "你们要在心中存谦卑，"
    },
    {
      "id": "p0645",
      "zh": "恨恶残酷的行为，全心爱邻舍，"
    },
    {
      "id": "p0646",
      "zh": "如同爱自己；又要从灵魂深处"
    },
    {
      "id": "p0647",
      "zh": "爱神，服侍祂。因此，我们"
    },
    {
      "id": "p0648",
      "zh": "出自天上基督的圣族，"
    },
    {
      "id": "p0649",
      "zh": "被称为同一血脉；我们在敬拜中"
    },
    {
      "id": "p0650",
      "zh": "节制对宴乐的追忆，"
    },
    {
      "id": "p0651",
      "zh": "行在敬虔和真理的道路上。"
    },
    {
      "id": "p0652",
      "zh": "我们从来不蒙允许去接近"
    },
    {
      "id": "p0653",
      "zh": "庙宇最深处的圣所，"
    },
    {
      "id": "p0654",
      "zh": "也不可向雕像奠酒，"
    },
    {
      "id": "p0655",
      "zh": "以祈祷尊荣它们，或以"
    },
    {
      "id": "p0656",
      "zh": "鲜花悦人的香气、灯盏的光，"
    },
    {
      "id": "p0657",
      "zh": "或闪亮的还愿供物"
    },
    {
      "id": "p0658",
      "zh": "装饰它们，也不可用"
    },
    {
      "id": "p0659",
      "zh": "坛上燃起的乳香之烟。你也不可"
    },
    {
      "id": "p0660",
      "zh": "在献公牛为祭之上，再添加"
    },
    {
      "id": "p0661",
      "zh": "污秽为乐的事，送上"
    },
    {
      "id": "p0662",
      "zh": "残杀羊群的血，以此"
    },
    {
      "id": "p0663",
      "zh": "赎免地底的刑罚；"
    },
    {
      "id": "p0664",
      "zh": "也不可用焚烧肉体之柴堆的烟"
    },
    {
      "id": "p0665",
      "zh": "和恶臭污秽天空的光。"
    },
    {
      "id": "p0666",
      "zh": "我们却奉命，存清洁的思想、快乐的心灵，"
    },
    {
      "id": "p0667",
      "zh": "以丰盛的爱、慷慨的双手，"
    },
    {
      "id": "p0668",
      "zh": "献上安慰人心的诗篇和尊荣神的歌，"
    },
    {
      "id": "p0669",
      "zh": "欢喜地向祢唱赞美，"
    },
    {
      "id": "p0670",
      "zh": "祢是不朽、毫无诡诈的，"
    },
    {
      "id": "p0671",
      "zh": "是有悟性的万有之父、神……"
    }
  ]
}
