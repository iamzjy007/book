  "blocks": [
    {
      "id": "p0001",
      "zh": "第四章"
    },
    {
      "id": "p0002",
      "zh": "我儿，不可夺去穷人赖以为生的东西，也不可使困乏人盼望的眼睛久候。"
    },
    {
      "id": "p0003",
      "zh": "不可使饥饿的人忧伤，也不可激怒处于困境的人。"
    },
    {
      "id": "p0004",
      "zh": "不可给愁苦的心增添烦恼；向有需要的人施予，不可拖延。"
    },
    {
      "id": "p0005",
      "zh": "不可拒绝患难中恳求的人，也不可转脸不顾穷人。"
    },
    {
      "id": "p0006",
      "zh": "不可移开眼目，不看求助的人；不要给人咒诅你的缘由。"
    },
    {
      "id": "p0007",
      "zh": "因为他若心里苦痛，咒诅你，造他的主必垂听他的恳求。"
    },
    {
      "id": "p0008",
      "zh": "要使自己蒙会众喜爱；在尊贵人面前，要低头致敬。"
    },
    {
      "id": "p0009",
      "zh": "当侧耳听穷人的话，谦卑地用温和的言语回答他。"
    },
    {
      "id": "p0010",
      "zh": "要救受欺压的人脱离欺压者的手；施行审断，不可胆怯。"
    },
    {
      "id": "p0011",
      "zh": "要待孤儿如父亲，待他们的母亲如丈夫；这样，你就如至高者的儿子，他爱你，必胜过你母亲爱你。"
    },
    {
      "id": "p0012",
      "zh": "智慧高举自己的儿子，扶持寻求她的人。"
    },
    {
      "id": "p0013",
      "zh": "爱她的，就是爱生命；清早寻求她的人，必满有喜乐。"
    },
    {
      "id": "p0014",
      "zh": "持守她的，必承受荣耀；他所到之处，主必赐福。"
    },
    {
      "id": "p0015",
      "zh": "服事她的，就是事奉那圣者；爱她的人，主也爱他们。"
    },
    {
      "id": "p0016",
      "zh": "听从她的，必审判列国；留心她的，必安然居住。"
    },
    {
      "id": "p0017",
      "zh": "人若信赖她，就必承受她，他的后代也必拥有她。"
    },
    {
      "id": "p0018",
      "zh": "起初，她会领他走曲折的路，使恐惧惊惶临到他，用管教磨炼他，直到她能信赖他的心；她要用自己的判词试验他。"
    },
    {
      "id": "p0019",
      "zh": "随后，她必再次领他回到正路，使他欢喜，向他显明自己的奥秘。"
    },
    {
      "id": "p0020",
      "zh": "他若偏离，她就离弃他，任凭他倾覆。"
    },
    {
      "id": "p0021",
      "zh": "要察看时机，防备邪恶；不可以自己为耻。"
    },
    {
      "id": "p0022",
      "zh": "有一种羞耻招致罪，有一种羞耻却带来荣耀与恩惠。"
    },
    {
      "id": "p0023",
      "zh": "不可因偏袒而损害自己，也不可因敬畏人而跌倒。"
    },
    {
      "id": "p0024",
      "zh": "言语若能救人，就不可缄默；也不可为了显得和气，就隐藏自己的智慧。"
    },
    {
      "id": "p0025",
      "zh": "智慧由言语显明，教养由口中的话表露。"
    },
    {
      "id": "p0026",
      "zh": "不可违背真理说话，以致因自己的无知蒙羞。"
    },
    {
      "id": "p0027",
      "zh": "不可羞于承认自己的罪，也不可逆着河流争斗。"
    },
    {
      "id": "p0028",
      "zh": "不可任凭愚人践踏自己，也不可偏袒有权势的人。"
    },
    {
      "id": "p0029",
      "zh": "要为真理争战，至死不渝，主神必为你争战。"
    },
    {
      "id": "p0030",
      "zh": "舌头不可急躁，行事不可懒惰疏忽。"
    },
    {
      "id": "p0031",
      "zh": "在家中不可像狮子，也不可猜疑仆人。"
    },
    {
      "id": "p0032",
      "zh": "不要收取时伸出手，应当回报时却握紧手。"
    }
  ],
