  "blocks": [
    {
      "id": "p0001",
      "zh": "第九十五章"
    },
    {
      "id": "p0002",
      "zh": "“如今我们既献感谢，我就说：‘我愿蒙拯救，也愿施行拯救。阿们。"
    },
    {
      "id": "p0003",
      "zh": "我愿得释放，也愿释放人。阿们。"
    },
    {
      "id": "p0004",
      "zh": "我愿受伤，也愿使人受伤。阿们。"
    },
    {
      "id": "p0005",
      "zh": "我愿受生，也愿生育。阿们。"
    },
    {
      "id": "p0006",
      "zh": "我愿吃，也愿被吃。阿们。"
    },
    {
      "id": "p0007",
      "zh": "我愿听，也愿被听见。阿们。"
    },
    {
      "id": "p0008",
      "zh": "我愿被思想，因为我全然是思想。阿们。"
    },
    {
      "id": "p0009",
      "zh": "我愿被洗净，也愿施行洗净。阿们。"
    },
    {
      "id": "p0010",
      "zh": "恩典在跳舞。我愿吹笛，你们都当跳舞。阿们。"
    },
    {
      "id": "p0011",
      "zh": "我愿哀伤，你们都当悲哭。阿们。"
    },
    {
      "id": "p0012",
      "zh": "八这数目与我们同声赞美。阿们。"
    },
    {
      "id": "p0013",
      "zh": "十二这数目在高处跳舞。阿们。"
    },
    {
      "id": "p0014",
      "zh": "高处的全体有分于我们的舞蹈。阿们。"
    },
    {
      "id": "p0015",
      "zh": "凡不跳舞的，就不知道正在发生的事。阿们。"
    },
    {
      "id": "p0016",
      "zh": "我愿逃离，也愿停留。阿们。"
    },
    {
      "id": "p0017",
      "zh": "我愿装饰，也愿被装饰。阿们。"
    },
    {
      "id": "p0018",
      "zh": "我愿被联合，也愿使之联合。阿们。"
    },
    {
      "id": "p0019",
      "zh": "我没有房屋，却有许多房屋。阿们。"
    },
    {
      "id": "p0020",
      "zh": "我没有地方，却有许多地方。阿们。"
    },
    {
      "id": "p0021",
      "zh": "我没有殿，却有许多殿。阿们。"
    },
    {
      "id": "p0022",
      "zh": "对于观看我的人，我是灯。阿们。"
    },
    {
      "id": "p0023",
      "zh": "对于认识我的人，我是镜子。阿们。"
    },
    {
      "id": "p0024",
      "zh": "对于向我叩门的人，我是门。阿们。对于行路的你，我是道路。’”"
    }
  ],
  "references": [
    "中文参考《基督教典外文献（共10册）_手机版.txt》第250章《约翰行传（文本略）》，49873—49885行，只有简介和少量引文，未提供本批全文；正文逐段依据英文翻译。"
  ],
  "notes": [
    "“八”“十二”“高处的全体”为底本的象征称谓，未擅加天体或神灵身份解释。"
  ]
}
