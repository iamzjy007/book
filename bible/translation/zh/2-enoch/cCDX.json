  "blocks": [
    {
      "id": "p0001",
      "zh": "第五十二章"
    },
    {
      "id": "p0002",
      "zh": "开口赞美万军之神、从心里赞美主的人有福了。"
    },
    {
      "id": "p0003",
      "zh": "凡开口藐视、毁谤邻舍的人，都受咒诅，因为他藐视的是神。"
    },
    {
      "id": "p0004",
      "zh": "开口称颂、赞美神的人有福了。"
    },
    {
      "id": "p0005",
      "zh": "开口咒诅、辱骂的人，一生的日子都在主面前受咒诅。"
    },
    {
      "id": "p0006",
      "zh": "称颂主一切作为的人有福了。"
    },
    {
      "id": "p0007",
      "zh": "藐视主所造之物的人受咒诅。"
    },
    {
      "id": "p0008",
      "zh": "垂顾跌倒之人、将他扶起的人有福了。"
    },
    {
      "id": "p0009",
      "zh": "盯着不属于自己的东西、急欲毁掉它的人受咒诅。"
    },
    {
      "id": "p0010",
      "zh": "守护列祖从起初所立稳固根基的人有福了。"
    },
    {
      "id": "p0011",
      "zh": "歪曲列祖法度的人受咒诅。"
    },
    {
      "id": "p0012",
      "zh": "传递和平与爱的人有福了。"
    },
    {
      "id": "p0013",
      "zh": "扰乱爱邻舍之人的人受咒诅。"
    },
    {
      "id": "p0014",
      "zh": "存谦卑的心、用谦和的舌向众人说话的人有福了。"
    },
    {
      "id": "p0015",
      "zh": "口中说平安，心里却没有平安，只有刀剑的人受咒诅。"
    },
    {
      "id": "p0016",
      "zh": "因为在大审判之日，这一切都要在天平和书卷中显露出来。"
    }
  ],
  "references": [
