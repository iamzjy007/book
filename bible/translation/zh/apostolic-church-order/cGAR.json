  "blocks": [
    {
      "id": "p0001",
      "zh": "第六章"
    },
    {
      "id": "p0002",
      "zh": "彼得说：“不可杀人，不可奸淫；"
    },
    {
      "id": "p0003",
      "zh": "不可行淫，不可玷污少年人；"
    },
    {
      "id": "p0004",
      "zh": "不可偷盗；"
    },
    {
      "id": "p0005",
      "zh": "不可行巫术；"
    },
    {
      "id": "p0006",
      "zh": "不可念咒；"
    },
    {
      "id": "p0007",
      "zh": "不可堕胎杀害胎儿，也不可杀害已经出生的婴孩；"
    },
    {
      "id": "p0008",
      "zh": "不可贪恋邻舍任何所有的；"
    },
    {
      "id": "p0009",
      "zh": "不可作假见证，不可出恶言；"
    },
    {
      "id": "p0010",
      "zh": "不可怀恨；"
    },
    {
      "id": "p0011",
      "zh": "不可心怀二意，也不可一口两舌，因为一口两舌是死亡的网罗。"
    },
    {
      "id": "p0012",
      "zh": "你所说的话不可空洞，也不可虚假。不可贪婪、掠夺、假冒为善、心怀恶意或狂傲，也不可图谋害邻舍。"
    },
    {
      "id": "p0013",
      "zh": "不可恨任何人；有些人你当责备，有些人当怜悯，有些人当为他们祷告，有些人则当爱他们，胜过自己的性命。”"
    }
  ],
  "references": [
    "检索《基督教典外文献（共10册）_手机版.txt》与reference-map，未找到本书对应中文全文；依英文底本逐块翻译，与新约及十二使徒遗训相近处仅借鉴通行中文措辞。"
  ],
