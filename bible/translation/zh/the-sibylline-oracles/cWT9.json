{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cWT9",
  "source_sha256": "f65968ac3c7a201add9e9287fbc89ef88e7f0aa45c0bfd13a799f8f7e77796a0",
  "reviewed": true,
  "blocks": [
    {
      "id": "p0001",
      "zh": "神谕残篇"
    },
    {
      "id": "p0002",
      "zh": "〔有些《西卜神谕》的残篇无法确定归属。其中第一篇或许有理由置于第三卷开头。〕"
    },
    {
      "id": "p0003",
      "zh": "残篇一"
    },
    {
      "id": "p0004",
      "zh": "你们这些血肉所成、算不得什么的世人，"
    },
    {
      "id": "p0005",
      "zh": "为何这样快就自高自大，却看不见"
    },
    {
      "id": "p0006",
      "zh": "生命的终局！你们如今岂不战兢，"
    },
    {
      "id": "p0007",
      "zh": "敬畏那看顾你们的神，"
    },
    {
      "id": "p0008",
      "zh": "那至高者、全知者，"
    },
    {
      "id": "p0009",
      "zh": "那察看万有、为一切作见证的，"
    },
    {
      "id": "p0010",
      "zh": "那养育万有的创造主？祂已将"
    },
    {
      "id": "p0011",
      "zh": "祂美善的灵放在万有之中，又立"
    },
    {
      "id": "p0012",
      "zh": "这灵引领一切世人。神只有一位，"
    },
    {
      "id": "p0013",
      "zh": "独自掌权，无比伟大，非受生者，"
    },
    {
      "id": "p0014",
      "zh": "全能而不可见；唯独祂"
    },
    {
      "id": "p0015",
      "zh": "看见万有，却没有"
    },
    {
      "id": "p0016",
      "zh": "属血肉的世人能看见祂。"
    },
    {
      "id": "p0017",
      "zh": "因为有什么血肉之躯能用"
    },
    {
      "id": "p0018",
      "zh": "眼睛看见那属天、真实的神，"
    },
    {
      "id": "p0019",
      "zh": "就是以诸天为居所的那一位呢？"
    },
    {
      "id": "p0020",
      "zh": "即使在太阳明亮的光芒前，"
    },
    {
      "id": "p0021",
      "zh": "生而必死的人也不能站定直视，"
    },
    {
      "id": "p0022",
      "zh": "他们不过是骨骼上附着筋脉和血肉。"
    },
    {
      "id": "p0023",
      "zh": "唯独祂是世界的主宰，"
    },
    {
      "id": "p0024",
      "zh": "唯独祂永远长存，从亘古"
    },
    {
      "id": "p0025",
      "zh": "就已存在。你们当敬畏祂，"
    },
    {
      "id": "p0026",
      "zh": "那自有、非受生者，"
    },
    {
      "id": "p0027",
      "zh": "祂历世历代统管万有，在同一光照之下，"
    },
    {
      "id": "p0028",
      "zh": "向一切世人"
    },
    {
      "id": "p0029",
      "zh": "施行审判。你们必因"
    },
    {
      "id": "p0030",
      "zh": "邪恶的谋算，得着当受的报应；"
    },
    {
      "id": "p0031",
      "zh": "因为你们不再将荣耀"
    },
    {
      "id": "p0032",
      "zh": "归给真实永恒的神，也不再向祂"
    },
    {
      "id": "p0033",
      "zh": "献上圣洁的百牲祭，反把祭物"
    },
    {
      "id": "p0034",
      "zh": "献给住在阴间的鬼魔。"
    },
    {
      "id": "p0035",
      "zh": "你们狂妄自负，行事疯狂，"
    },
    {
      "id": "p0036",
      "zh": "离弃真实正直的道路，"
    },
    {
      "id": "p0037",
      "zh": "转身走开，在荆棘"
    },
    {
      "id": "p0038",
      "zh": "与蒺藜中徘徊。哦，愚昧的世人，不要再"
    },
    {
      "id": "p0039",
      "zh": "游荡于幽暗和漆黑的夜里；"
    },
    {
      "id": "p0040",
      "zh": "要离开黑夜，持守"
    },
    {
      "id": "p0041",
      "zh": "光明。看哪，祂向众人显明，"
    },
    {
      "id": "p0042",
      "zh": "绝无差错；来吧，不要总是追逐"
    },
    {
      "id": "p0043",
      "zh": "黑暗与幽冥。看哪，太阳悦目的光"
    },
    {
      "id": "p0044",
      "zh": "以无比的光辉照耀。"
    },
    {
      "id": "p0045",
      "zh": "如今要将智慧存记在心，知道"
    },
    {
      "id": "p0046",
      "zh": "神只有一位，祂降下风雨，"
    },
    {
      "id": "p0047",
      "zh": "地震与闪电、饥荒与瘟疫，"
    },
    {
      "id": "p0048",
      "zh": "悲苦的忧患、暴雪与寒冰。"
    },
    {
      "id": "p0049",
      "zh": "我又何必逐一述说呢？"
    },
    {
      "id": "p0050",
      "zh": "祂引导诸天，统管大地，掌管阴间。"
    },
    {
      "id": "p0051",
      "zh": "残篇二"
    },
    {
      "id": "p0052",
      "zh": "倘若诸神生养后代，又永远"
    },
    {
      "id": "p0053",
      "zh": "不死，那么神的数目早已多过人，"
    },
    {
      "id": "p0054",
      "zh": "世上也早就没有足够的地方"
    },
    {
      "id": "p0055",
      "zh": "让世人立足。"
    },
    {
      "id": "p0056",
      "zh": "残篇三"
    },
    {
      "id": "p0057",
      "zh": "倘若一切受生的都必灭亡，"
    },
    {
      "id": "p0058",
      "zh": "那么神就不可能"
    },
    {
      "id": "p0059",
      "zh": "由人的腰际和母腹而生；"
    },
    {
      "id": "p0060",
      "zh": "唯有神是独一、至高的，"
    },
    {
      "id": "p0061",
      "zh": "祂造了诸天、日月星辰，"
    },
    {
      "id": "p0062",
      "zh": "结果实的大地、海中的波涛，"
    },
    {
      "id": "p0063",
      "zh": "巍峨的山岳和长流不息的泉眼。"
    },
    {
      "id": "p0064",
      "zh": "祂也生出数不尽的"
    },
    {
      "id": "p0065",
      "zh": "水中生物，"
    },
    {
      "id": "p0066",
      "zh": "使地上"
    },
    {
      "id": "p0067",
      "zh": "爬行的活物得以存活，"
    },
    {
      "id": "p0068",
      "zh": "又养育斑斓纤巧、鸣声清脆的飞鸟，"
    },
    {
      "id": "p0069",
      "zh": "它们振翼穿行空中，发出尖锐的声响。"
    },
    {
      "id": "p0070",
      "zh": "祂将各类野兽安置在"
    },
    {
      "id": "p0071",
      "zh": "荒山的幽谷，使一切牲畜"
    },
    {
      "id": "p0072",
      "zh": "顺服我们世人，又立祂所造的人"
    },
    {
      "id": "p0073",
      "zh": "为万物的管理者，"
    },
    {
      "id": "p0074",
      "zh": "使形形色色、难以测透的万物"
    },
    {
      "id": "p0075",
      "zh": "都服在人以下。"
    },
    {
      "id": "p0076",
      "zh": "这一切，哪个血肉之躯能明白呢？"
    },
    {
      "id": "p0077",
      "zh": "唯有祂自己知道，就是在起初"
    },
    {
      "id": "p0078",
      "zh": "造了这一切的那一位，那不朽的"
    },
    {
      "id": "p0079",
      "zh": "永恒创造主，住在天上，"
    },
    {
      "id": "p0080",
      "zh": "将更丰盛的美好赏赐"
    },
    {
      "id": "p0081",
      "zh": "报答善人，却向邪恶不义的人"
    },
    {
      "id": "p0082",
      "zh": "发出烈怒和忿恨，"
    },
    {
      "id": "p0083",
      "zh": "降下战争、瘟疫和令人流泪的苦难。"
    },
    {
      "id": "p0084",
      "zh": "哦，世人啊，你们为何虚妄自大，"
    },
    {
      "id": "p0085",
      "zh": "自取灭亡？你们当感到羞愧，不要"
    },
    {
      "id": "p0086",
      "zh": "把臭鼬和怪物奉为神明！这岂不是疯狂，"
    },
    {
      "id": "p0087",
      "zh": "岂不是丧失了理智，"
    },
    {
      "id": "p0088",
      "zh": "竟让所谓的神偷盘子、搬走瓦罐？"
    },
    {
      "id": "p0089",
      "zh": "它们没有在金色天庭中"
    },
    {
      "id": "p0090",
      "zh": "享受丰盛；看哪，反倒被蛀虫啃噬，"
    },
    {
      "id": "p0091",
      "zh": "被厚厚的蜘蛛网缠绕！"
    },
    {
      "id": "p0092",
      "zh": "哦，愚昧的人，你们向蛇、狗和猫下拜，"
    },
    {
      "id": "p0093",
      "zh": "敬奉飞鸟和地上的爬物，"
    },
    {
      "id": "p0094",
      "zh": "敬奉石像、手造的雕像，"
    },
    {
      "id": "p0095",
      "zh": "又敬奉路旁的石堆；"
    },
    {
      "id": "p0096",
      "zh": "还有许多虚无之物，"
    },
    {
      "id": "p0097",
      "zh": "连说起来都令人羞耻。"
    },
    {
      "id": "p0098",
      "zh": "这些就是愚顽人所拜、带来祸害的神明，"
    },
    {
      "id": "p0099",
      "zh": "致命的毒汁从它们口中流出。"
    },
    {
      "id": "p0100",
      "zh": "但生命和永恒不灭的光明"
    },
    {
      "id": "p0101",
      "zh": "出于祂；祂将比蜜还甜的喜乐"
    },
    {
      "id": "p0102",
      "zh": "赐给义人。"
    },
    {
      "id": "p0103",
      "zh": "你们只当向祂低头敬拜，"
    },
    {
      "id": "p0104",
      "zh": "使自己的道路转向敬虔人的生活。"
    },
    {
      "id": "p0105",
      "zh": "你们却离弃这一切，心灵因愚昧"
    },
    {
      "id": "p0106",
      "zh": "而疯狂，人人都喝尽了"
    },
    {
      "id": "p0107",
      "zh": "那盛满审判的杯；杯中之物纯净，"
    },
    {
      "id": "p0108",
      "zh": "压得紧实，沉甸甸的，毫无掺杂。"
    },
    {
      "id": "p0109",
      "zh": "你们仍不肯从醉梦中醒来，"
    },
    {
      "id": "p0110",
      "zh": "恢复清醒的理智，认识神，"
    },
    {
      "id": "p0111",
      "zh": "知道祂是监察万有的王。"
    },
    {
      "id": "p0112",
      "zh": "因此，闪耀的烈火"
    },
    {
      "id": "p0113",
      "zh": "将临到你们；火把要焚烧你们，"
    },
    {
      "id": "p0114",
      "zh": "终日不息，直到永永远远，"
    },
    {
      "id": "p0115",
      "zh": "使你们因那些虚假无用的偶像蒙羞。"
    },
    {
      "id": "p0116",
      "zh": "但敬畏真实永恒之神的人"
    },
    {
      "id": "p0117",
      "zh": "必承受生命，永远一同住在"
    },
    {
      "id": "p0118",
      "zh": "乐园肥美的田地里，"
    },
    {
      "id": "p0119",
      "zh": "享用从星空降下的甘美食粮。"
    },
    {
      "id": "p0120",
      "zh": "残篇四"
    },
    {
      "id": "p0121",
      "zh": "世人啊，听我说，永恒的王掌权。"
    },
    {
      "id": "p0122",
      "zh": "残篇五"
    },
    {
      "id": "p0123",
      "zh": "唯有祂是神，是不受辖制的创造主；"
    },
    {
      "id": "p0124",
      "zh": "祂定下人形的样式，"
    },
    {
      "id": "p0125",
      "zh": "亲自调和一切世人的本性，"
    },
    {
      "id": "p0126",
      "zh": "祂就是〔一切〕生命的生发者。"
    },
    {
      "id": "p0127",
      "zh": "残篇六"
    },
    {
      "id": "p0128",
      "zh": "每逢祂来到，"
    },
    {
      "id": "p0129",
      "zh": "漆黑的午夜必有烟火升起。"
    },
    {
      "id": "p0130",
      "zh": "残篇七"
    },
    {
      "id": "p0131",
      "zh": "厄律特莱的西卜向神说：“主啊，你为什么命定我必须说预言，却不把我从地上接到高处，保守我直到你降临那至为有福的日子呢？”"
    }
  ],
  "references": [
    "bible/基督教典外文献（共10册）_手机版.txt：检索《西卜神谕》及残篇，未找到这七则残篇的明确对应文本；本单元依据英文逐块翻译。"
  ],
  "notes": [
    "残篇三原文 be placed、statues made with bands 按上下文分别作 he placed、statues made with hands 处理，译为“祂将……安置”“手造的雕像”。"
  ]
}
