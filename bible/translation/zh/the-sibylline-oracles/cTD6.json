{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cTD6",
  "source_sha256": "3914f79d30a8b48e9f9cb01d50aefd577c287e6daa373a639d513199b3a3fffe",
  "reviewed": true,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第四卷"
    },
    {
      "id": "p0002",
      "zh": "［引言，1—28行。义人的福乐，29—60行。亚述王国，61—65行。玛代人和波斯人，66—82行。弗吕家、亚细亚和埃及的灾祸，83—100行。西西里被埃特纳的火焚烧，101—104行。希腊的争战，105—108行。马其顿的胜利，109—129行。意大利的胜利，130—168行。意大利的惩罚，169—180行。安提阿、居比路和卡里亚的灾祸，181—197行。为不敬虔者存留的烈怒，198—209行。劝告与警诫，210—230行。复活、审判和奖赏，231—248行。］"
    },
    {
      "id": "p0003",
      "zh": "夸耀的亚细亚和欧洲之民哪，"
    },
    {
      "id": "p0004",
      "zh": "你们当听，我将述说许多全然真实之事，"
    },
    {
      "id": "p0005",
      "zh": "从我的大殿，以多声多调之口"
    },
    {
      "id": "p0006",
      "zh": "发出预言。我不是那说谎的"
    },
    {
      "id": "p0007",
      "zh": "福玻斯的代言人，虚妄的人称他为神，"
    },
    {
      "id": "p0008",
      "zh": "又称他为先见，越发妄言；"
    },
    {
      "id": "p0009",
      "zh": "我乃是大能神的代言人，祂不是人手"
    },
    {
      "id": "p0010",
      "zh": "所造，不像那雕刻于石、不能言语的偶像。"
    },
    {
      "id": "p0011",
      "zh": "祂不以一块运到庙中的石头为居所，"
    },
    {
      "id": "p0012",
      "zh": "那石头无言无齿，"
    },
    {
      "id": "p0013",
      "zh": "实在严重羞辱了不朽者；"
    },
    {
      "id": "p0014",
      "zh": "因为人在地上不能看见祂，凡人的眼睛"
    },
    {
      "id": "p0015",
      "zh": "不能测度祂，凡人的手不能塑造祂。"
    },
    {
      "id": "p0016",
      "zh": "祂一眼俯察万有，"
    },
    {
      "id": "p0017",
      "zh": "自己却不被任何人看见。幽暗的夜属于祂，"
    },
    {
      "id": "p0018",
      "zh": "白昼、太阳、众星、月亮、海洋"
    },
    {
      "id": "p0019",
      "zh": "和海中的鱼，大地、江河、"
    },
    {
      "id": "p0020",
      "zh": "永不枯竭的泉口，为生命所造的众生，"
    },
    {
      "id": "p0021",
      "zh": "以及迅速使田地结出果实的雨水，"
    },
    {
      "id": "p0022",
      "zh": "树木、葡萄和橄榄油，都属于祂。这位神以鞭"
    },
    {
      "id": "p0023",
      "zh": "击打我的内心，使我向世人"
    },
    {
      "id": "p0024",
      "zh": "真实述说如今已经发生的事，"
    },
    {
      "id": "p0025",
      "zh": "以及今后还要临到他们的许多事，"
    },
    {
      "id": "p0026",
      "zh": "从第一代直到第十一代。"
    },
    {
      "id": "p0027",
      "zh": "因为祂必亲自使这些事成就，"
    },
    {
      "id": "p0028",
      "zh": "证实一切。百姓啊，你们凡事"
    },
    {
      "id": "p0029",
      "zh": "都要侧耳听西卜的话，"
    },
    {
      "id": "p0030",
      "zh": "她从圣洁的口中倾诉真实的声音。"
    },
    {
      "id": "p0031",
      "zh": "在地上，世人中有福的，"
    },
    {
      "id": "p0032",
      "zh": "必是那些爱大能神的人；"
    },
    {
      "id": "p0033",
      "zh": "他们在吃喝以前，先向祂献上赞美，"
    },
    {
      "id": "p0034",
      "zh": "以敬虔为倚靠。他们看见"
    },
    {
      "id": "p0035",
      "zh": "庙宇、祭坛和无言的石头形像，"
    },
    {
      "id": "p0036",
      "zh": "[[石像和人手所造的雕像，]]"
    },
    {
      "id": "p0037",
      "zh": "被活物的血"
    },
    {
      "id": "p0038",
      "zh": "和四足牲畜的祭牲污秽，"
    },
    {
      "id": "p0039",
      "zh": "便将这一切弃绝。他们必仰望"
    },
    {
      "id": "p0040",
      "zh": "独一神的大荣耀，不"
    },
    {
      "id": "p0041",
      "zh": "妄行凶杀，也不经手"
    },
    {
      "id": "p0042",
      "zh": "偷盗所得之财，这些都是极其可憎的事。"
    },
    {
      "id": "p0043",
      "zh": "他们不贪恋别人的床榻，"
    },
    {
      "id": "p0044",
      "zh": "也不存卑污可恨的男色之欲。"
    },
    {
      "id": "p0045",
      "zh": "他们的行事、敬虔和品性，"
    },
    {
      "id": "p0046",
      "zh": "那些喜爱无耻生活的人，"
    },
    {
      "id": "p0047",
      "zh": "从不肯效法；反用戏谑和笑话"
    },
    {
      "id": "p0048",
      "zh": "嘲弄他们，愚昧如孩童，"
    },
    {
      "id": "p0049",
      "zh": "将自己所行的一切"
    },
    {
      "id": "p0050",
      "zh": "可责可恶之事，诬加在他们身上。"
    },
    {
      "id": "p0051",
      "zh": "因为全人类都迟钝，"
    },
    {
      "id": "p0052",
      "zh": "不肯相信。但等到世界"
    },
    {
      "id": "p0053",
      "zh": "和世人的审判来到，神必亲自施行，"
    },
    {
      "id": "p0054",
      "zh": "一同审判不敬虔与敬虔的人；"
    },
    {
      "id": "p0055",
      "zh": "那时，祂必将不敬虔的人遣回"
    },
    {
      "id": "p0056",
      "zh": "下界的黑暗，[[他们便知道"
    },
    {
      "id": "p0057",
      "zh": "自己曾行多少不敬虔之事。]]敬虔的人"
    },
    {
      "id": "p0058",
      "zh": "却仍留在丰产的土地上，"
    },
    {
      "id": "p0059",
      "zh": "神赐他们气息、生命和恩典。"
    },
    {
      "id": "p0060",
      "zh": "这一切都要在第十代"
    },
    {
      "id": "p0061",
      "zh": "成就。如今，我要述说"
    },
    {
      "id": "p0062",
      "zh": "从第一代起将要发生的事。"
    },
    {
      "id": "p0063",
      "zh": "亚述人首先必统治所有世人，"
    },
    {
      "id": "p0064",
      "zh": "掌握世界的权柄"
    },
    {
      "id": "p0065",
      "zh": "达六代之久，从天上的神"
    },
    {
      "id": "p0066",
      "zh": "向众城和世人发怒，"
    },
    {
      "id": "p0067",
      "zh": "使海水泛滥，以洪水淹没大地的时候算起。"
    },
    {
      "id": "p0068",
      "zh": "玛代人必战胜他们，却只在王位上"
    },
    {
      "id": "p0069",
      "zh": "夸胜两代。"
    },
    {
      "id": "p0070",
      "zh": "在这些日子，必发生以下的事："
    },
    {
      "id": "p0071",
      "zh": "正午必有黑夜临到，"
    },
    {
      "id": "p0072",
      "zh": "众星和运行的月亮"
    },
    {
      "id": "p0073",
      "zh": "必从天上消失；大地因大地震"
    },
    {
      "id": "p0074",
      "zh": "剧烈摇动，将许多城邑"
    },
    {
      "id": "p0075",
      "zh": "和人手的工程倾覆；海中的岛屿"
    },
    {
      "id": "p0076",
      "zh": "必从深处显露。"
    },
    {
      "id": "p0077",
      "zh": "幼发拉底大河涌起"
    },
    {
      "id": "p0078",
      "zh": "血浪的时候，"
    },
    {
      "id": "p0079",
      "zh": "玛代人与波斯人之间也必爆发可怕的"
    },
    {
      "id": "p0080",
      "zh": "战事；玛代人必倒下逃窜，"
    },
    {
      "id": "p0081",
      "zh": "在波斯人的枪矛下，退到"
    },
    {
      "id": "p0082",
      "zh": "底格里斯大河以外。波斯的势力"
    },
    {
      "id": "p0083",
      "zh": "必在全世界最为强大，"
    },
    {
      "id": "p0084",
      "zh": "享有一代极其昌盛的统治。"
    },
    {
      "id": "p0085",
      "zh": "那时，许多人人欲除之恶"
    },
    {
      "id": "p0086",
      "zh": "必然发生：战争的喧嚣、"
    },
    {
      "id": "p0087",
      "zh": "凶杀、纷争、放逐，"
    },
    {
      "id": "p0088",
      "zh": "城楼倾覆、城邑荒废。"
    },
    {
      "id": "p0089",
      "zh": "荣耀的希腊必扬帆，"
    },
    {
      "id": "p0090",
      "zh": "越过宽阔的赫勒斯滂，"
    },
    {
      "id": "p0091",
      "zh": "给弗吕家带来悲伤，给亚细亚带来毁灭。"
    },
    {
      "id": "p0092",
      "zh": "埃及那田畴众多之地，"
    },
    {
      "id": "p0093",
      "zh": "必遭凄惨的饥荒，荒芜"
    },
    {
      "id": "p0094",
      "zh": "持续二十个年头；"
    },
    {
      "id": "p0095",
      "zh": "那滋养五谷的尼罗河，"
    },
    {
      "id": "p0096",
      "zh": "必将幽暗的波浪藏在地下某处。"
    },
    {
      "id": "p0097",
      "zh": "一位大王必从亚细亚而来，"
    },
    {
      "id": "p0098",
      "zh": "手持长矛，率领无数船只；"
    },
    {
      "id": "p0099",
      "zh": "他必走过深海的水路，"
    },
    {
      "id": "p0100",
      "zh": "劈开山峰高耸的山以后，"
    },
    {
      "id": "p0101",
      "zh": "航行过去；然而，惧怕的亚细亚"
    },
    {
      "id": "p0102",
      "zh": "必接回这从战场逃亡的王。"
    },
    {
      "id": "p0103",
      "zh": "可怜的西西里必被一股"
    },
    {
      "id": "p0104",
      "zh": "猛烈的火流全然点燃；埃特纳山"
    },
    {
      "id": "p0105",
      "zh": "喷吐烈焰，而大城克罗顿"
    },
    {
      "id": "p0106",
      "zh": "必坠入深渊。"
    },
    {
      "id": "p0107",
      "zh": "希腊必有纷争，彼此"
    },
    {
      "id": "p0108",
      "zh": "怒攻，倾覆许多城邑，"
    },
    {
      "id": "p0109",
      "zh": "交战中杀灭许多人；"
    },
    {
      "id": "p0110",
      "zh": "双方却势均力敌。"
    },
    {
      "id": "p0111",
      "zh": "世人的族类来到"
    },
    {
      "id": "p0112",
      "zh": "第十代的时候，"
    },
    {
      "id": "p0113",
      "zh": "波斯人也必负起奴役的轭，"
    },
    {
      "id": "p0114",
      "zh": "遭受恐惧。但当马其顿人"
    },
    {
      "id": "p0115",
      "zh": "以王权夸耀的时候，底比斯必"
    },
    {
      "id": "p0116",
      "zh": "从后方遭到惨痛征服；卡里亚人"
    },
    {
      "id": "p0117",
      "zh": "必住在推罗，推罗人却被消灭。"
    },
    {
      "id": "p0118",
      "zh": "巴比伦外观宏伟，战力却微弱，"
    },
    {
      "id": "p0119",
      "zh": "徒有怀着虚妄盼望筑起的城墙。"
    },
    {
      "id": "p0120",
      "zh": "马其顿人必住在巴克特里亚，"
    },
    {
      "id": "p0121",
      "zh": "苏撒和巴克特里亚的人"
    },
    {
      "id": "p0122",
      "zh": "却都逃往希腊之地。"
    },
    {
      "id": "p0123",
      "zh": "这些必临到将来的人，"
    },
    {
      "id": "p0124",
      "zh": "当泛着银光漩涡的皮拉摩斯河"
    },
    {
      "id": "p0125",
      "zh": "漫过两岸，流到圣岛时。"
    },
    {
      "id": "p0126",
      "zh": "基比拉和基济库斯必倒塌，"
    },
    {
      "id": "p0127",
      "zh": "因为大地震动，众城倾覆。"
    },
    {
      "id": "p0128",
      "zh": "沙土必堆起，掩埋整个撒摩斯。"
    },
    {
      "id": "p0129",
      "zh": "提洛斯再也不能被看见，"
    },
    {
      "id": "p0130",
      "zh": "岛上的一切都必隐没。"
    },
    {
      "id": "p0131",
      "zh": "罗得岛的灾祸最后才来，却是最大的。"
    },
    {
      "id": "p0132",
      "zh": "马其顿的势力不会长存；"
    },
    {
      "id": "p0133",
      "zh": "一场意大利的大战必从西方"
    },
    {
      "id": "p0134",
      "zh": "兴起，全世界在它之下"
    },
    {
      "id": "p0135",
      "zh": "负起奴役的轭，服侍意大利人。"
    },
    {
      "id": "p0136",
      "zh": "可怜的哥林多啊，你必亲眼看见"
    },
    {
      "id": "p0137",
      "zh": "自己被征服的日子。迦太基啊，你的城楼"
    },
    {
      "id": "p0138",
      "zh": "必被压倒在地。"
    },
    {
      "id": "p0139",
      "zh": "可怜的老底嘉，有一天，"
    },
    {
      "id": "p0140",
      "zh": "地震必使你倾覆，将你摔下；"
    },
    {
      "id": "p0141",
      "zh": "但你必再成为根基稳固的城，"
    },
    {
      "id": "p0142",
      "zh": "重新屹立。吕家的美拉，美丽的城啊，"
    },
    {
      "id": "p0143",
      "zh": "震动的大地永不让你"
    },
    {
      "id": "p0144",
      "zh": "站稳；你必仆倒在地，"
    },
    {
      "id": "p0145",
      "zh": "像异乡人一般祈求，"
    },
    {
      "id": "p0146",
      "zh": "但愿逃往别国。"
    },
    {
      "id": "p0147",
      "zh": "那时，幽暗的海水，"
    },
    {
      "id": "p0148",
      "zh": "连同雷声和地震，必因帕大喇的不敬虔，"
    },
    {
      "id": "p0149",
      "zh": "止息那城的喧嚣。"
    },
    {
      "id": "p0150",
      "zh": "亚美尼亚啊，为你留下的，"
    },
    {
      "id": "p0151",
      "zh": "也是受奴役的命运。一股凶猛的战争风暴"
    },
    {
      "id": "p0152",
      "zh": "必从意大利袭向耶路撒冷，"
    },
    {
      "id": "p0153",
      "zh": "洗劫神的大殿。"
    },
    {
      "id": "p0154",
      "zh": "但这些人信靠愚昧，弃绝"
    },
    {
      "id": "p0155",
      "zh": "敬虔，在圣殿四周"
    },
    {
      "id": "p0156",
      "zh": "大肆杀戮以后，必有一位意大利的"
    },
    {
      "id": "p0157",
      "zh": "强王，如逃奴一般，"
    },
    {
      "id": "p0158",
      "zh": "暗中越过幼发拉底河，"
    },
    {
      "id": "p0159",
      "zh": "不为人知；这人有一天将胆敢犯下可憎的"
    },
    {
      "id": "p0160",
      "zh": "弑母罪，以及许多别的罪，"
    },
    {
      "id": "p0161",
      "zh": "仗恃自己极恶的双手。"
    },
    {
      "id": "p0162",
      "zh": "当他逃过帕提亚之地时，许多人必为王位争夺，"
    },
    {
      "id": "p0163",
      "zh": "使罗马的土地染满鲜血。"
    },
    {
      "id": "p0164",
      "zh": "罗马的首领必从叙利亚而来；"
    },
    {
      "id": "p0165",
      "zh": "他焚烧耶路撒冷的圣殿，"
    },
    {
      "id": "p0166",
      "zh": "杀戮许多犹太人以后，"
    },
    {
      "id": "p0167",
      "zh": "必使他们广大之地遭到毁灭。"
    },
    {
      "id": "p0168",
      "zh": "那时，地震也必倾覆"
    },
    {
      "id": "p0169",
      "zh": "撒拉米和帕弗；幽暗的海水"
    },
    {
      "id": "p0170",
      "zh": "越过居比路，这岛被重重海浪冲刷。"
    },
    {
      "id": "p0171",
      "zh": "但当意大利土地的深裂缝中"
    },
    {
      "id": "p0172",
      "zh": "有火喷出，照亮广阔的天空，"
    },
    {
      "id": "p0173",
      "zh": "焚烧许多城邑，毁灭世人，"
    },
    {
      "id": "p0174",
      "zh": "大量黑灰充满高天，"
    },
    {
      "id": "p0175",
      "zh": "仿佛红土的小滴从天而降时，"
    },
    {
      "id": "p0176",
      "zh": "你们就当知道，这是天上神的烈怒；"
    },
    {
      "id": "p0177",
      "zh": "因为他们无缘无故地毁灭"
    },
    {
      "id": "p0178",
      "zh": "敬虔的民族。此后，战争引起的"
    },
    {
      "id": "p0179",
      "zh": "争斗必临到西方；"
    },
    {
      "id": "p0180",
      "zh": "那从罗马逃亡的人也必回来，"
    },
    {
      "id": "p0181",
      "zh": "手持长矛，率着万万大军，"
    },
    {
      "id": "p0182",
      "zh": "越过幼发拉底河。"
    },
    {
      "id": "p0183",
      "zh": "可怜的安提阿啊，人们将不再"
    },
    {
      "id": "p0184",
      "zh": "称你为城；因你自己的愚昧，"
    },
    {
      "id": "p0185",
      "zh": "你必倒在围攻的长矛之下。"
    },
    {
      "id": "p0186",
      "zh": "随后，瘟疫和可怕的战斗声，"
    },
    {
      "id": "p0187",
      "zh": "必给斯基罗斯带来毁灭。"
    },
    {
      "id": "p0188",
      "zh": "有祸了，有祸了！可怜的居比路，"
    },
    {
      "id": "p0189",
      "zh": "浩大的海浪必将你淹没，"
    },
    {
      "id": "p0190",
      "zh": "旋转的暴风将你高高抛起。"
    },
    {
      "id": "p0191",
      "zh": "巨大的财富必进入亚细亚；"
    },
    {
      "id": "p0192",
      "zh": "这些财富，罗马曾掠夺来，"
    },
    {
      "id": "p0193",
      "zh": "积存在自己的奢华宅邸。"
    },
    {
      "id": "p0194",
      "zh": "她必将两倍，甚至更多，归还亚细亚；"
    },
    {
      "id": "p0195",
      "zh": "其后又有无尽的战争。"
    },
    {
      "id": "p0196",
      "zh": "米安德河畔卡里亚的众城，"
    },
    {
      "id": "p0197",
      "zh": "城楼环绕，极其美丽，"
    },
    {
      "id": "p0198",
      "zh": "却必被惨痛的饥荒毁灭，"
    },
    {
      "id": "p0199",
      "zh": "因为米安德河藏起了幽暗的水。"
    },
    {
      "id": "p0200",
      "zh": "当敬虔从人类中消失，"
    },
    {
      "id": "p0201",
      "zh": "信实和公义在世上隐藏，"
    },
    {
      "id": "p0202",
      "zh": "……反复无常……以不圣洁的放肆"
    },
    {
      "id": "p0203",
      "zh": "活着，任意施暴，"
    },
    {
      "id": "p0204",
      "zh": "肆无忌惮地行恶；对于敬虔者，"
    },
    {
      "id": "p0205",
      "zh": "无人顾念，反而在无知中"
    },
    {
      "id": "p0206",
      "zh": "将他们全然毁灭，"
    },
    {
      "id": "p0207",
      "zh": "如顽童般愚昧，以自己的强暴"
    },
    {
      "id": "p0208",
      "zh": "为乐，双手沾满鲜血；"
    },
    {
      "id": "p0209",
      "zh": "那时，你们确实当知道，神不再温和，"
    },
    {
      "id": "p0210",
      "zh": "祂必切齿发怒，以大火"
    },
    {
      "id": "p0211",
      "zh": "毁灭整个人类。"
    },
    {
      "id": "p0212",
      "zh": "哦，可怜的世人，改掉这些恶行，"
    },
    {
      "id": "p0213",
      "zh": "不要激起大能神极大的震怒！"
    },
    {
      "id": "p0214",
      "zh": "放下你们的刀剑和尖刃，"
    },
    {
      "id": "p0215",
      "zh": "弃绝杀人和肆意的强暴，"
    },
    {
      "id": "p0216",
      "zh": "在长流的水中洗净全身，"
    },
    {
      "id": "p0217",
      "zh": "举手向天，求祂赦免"
    },
    {
      "id": "p0218",
      "zh": "从前的恶行，以赞美赎去"
    },
    {
      "id": "p0219",
      "zh": "那苦毒的不敬虔；神必赐给你们"
    },
    {
      "id": "p0220",
      "zh": "悔改的机会，不施毁灭，"
    },
    {
      "id": "p0221",
      "zh": "再度抑制烈怒，只要你们众人心里"
    },
    {
      "id": "p0222",
      "zh": "实行可尊重的敬虔。"
    },
    {
      "id": "p0223",
      "zh": "你们若心怀恶意，不肯听我，"
    },
    {
      "id": "p0224",
      "zh": "反倒喜爱异样的愚妄，"
    },
    {
      "id": "p0225",
      "zh": "以邪恶的耳朵听受这一切，"
    },
    {
      "id": "p0226",
      "zh": "必有火临到全世界；"
    },
    {
      "id": "p0227",
      "zh": "日出之时，刀剑和号筒相伴，"
    },
    {
      "id": "p0228",
      "zh": "最大的征兆出现；全世界都必听见吼声"
    },
    {
      "id": "p0229",
      "zh": "和巨响。祂必焚烧全地，"
    },
    {
      "id": "p0230",
      "zh": "毁灭整个人类，以及所有"
    },
    {
      "id": "p0231",
      "zh": "城邑、江河和海洋。"
    },
    {
      "id": "p0232",
      "zh": "祂必将万物焚烧，化为黑色尘土。"
    },
    {
      "id": "p0233",
      "zh": "等一切都已化为"
    },
    {
      "id": "p0234",
      "zh": "尘土和灰烬，神使祂所点燃、"
    },
    {
      "id": "p0235",
      "zh": "无法形容的烈火平息以后，"
    },
    {
      "id": "p0236",
      "zh": "祂必亲自将人的骸骨和灰烬"
    },
    {
      "id": "p0237",
      "zh": "重新塑造，再次"
    },
    {
      "id": "p0238",
      "zh": "使世人复活，如同从前。"
    },
    {
      "id": "p0239",
      "zh": "随后就是审判，神必亲自"
    },
    {
      "id": "p0240",
      "zh": "作审判者，再审判这世界。"
    },
    {
      "id": "p0241",
      "zh": "凡心存不敬虔而犯罪的，"
    },
    {
      "id": "p0242",
      "zh": "祂必再藏在土丘之下，"
    },
    {
      "id": "p0243",
      "zh": "[[黑暗的塔耳塔洛斯和冥河的地狱中。]]"
    },
    {
      "id": "p0244",
      "zh": "但一切敬虔的人，必再"
    },
    {
      "id": "p0245",
      "zh": "活在地上，[[并在那里承受"
    },
    {
      "id": "p0246",
      "zh": "伟大、不朽之神永不衰残的福乐。]]"
    },
    {
      "id": "p0247",
      "zh": "神赐给他们灵、生命和喜乐，"
    },
    {
      "id": "p0248",
      "zh": "[[就是赐给敬虔的人；他们都必发现自己"
    },
    {
      "id": "p0249",
      "zh": "正观看太阳甘美、使人欢欣的光。"
    },
    {
      "id": "p0250",
      "zh": "这样的人在地上，何等有福！]]"
    }
  ],
  "references": [
    "《基督教典外文献（共10册）_手机版.txt》7478—8008行旧2《西卜神谕篇》卷4，已完整对照；后部重复段未加入。另读51850—51861行新4选篇导读，不能把该选篇范围误认为总集全部范围。"
  ],
  "notes": [
    "正文每一英文诗行保留独立block，不以段落合并；跨诗行语序只作必要中文衔接，卷首概要编号为原文诗行号。",
    "原文修正说明：p0005 month many-toned与p0019 month of springs均按明确语境修正month为mouth，分别译多声多调之口、泉口；p0208 bands依in blood及上下文修正为hands为双手。",
    "p0162—0163缺动词，依罗马争位流血语境译使土地染满鲜血；p0167 will destruction缺谓语，补最低限度使…遭毁灭，未增事实。p0202原缺文保留。",
    "Solyma为耶路撒冷的诗体名，译耶路撒冷；Stygian Gehenna译冥河的地狱，保留希腊冥界与地狱混合意象。",
    "与旧2参考卷四有明确版本差异：第一至第十一代、埃及饥荒二十年、Scyros斯基罗斯、Cibyra基比拉均依英文，不改为参考的第十代、三十年、塞浦路斯及巴里斯。"
  ]
}
