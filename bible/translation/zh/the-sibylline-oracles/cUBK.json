  "blocks": [
    {
      "id": "p0001",
      "zh": "第六卷"
    },
    {
      "id": "p0002",
      "zh": "〔神子先存、道成肉身及受洗，1—9行；他的教导与神迹，10—25行；为有罪之地存留的苦难，26—32行；蒙福的十字架，33—36行。〕"
    },
    {
      "id": "p0003",
      "zh": "不朽者伟大的儿子，在诗歌中享有盛名，"
    },
    {
      "id": "p0004",
      "zh": "我从心里宣告他；父早在他"
    },
    {
      "id": "p0005",
      "zh": "出生以前，便赐他宝座，"
    },
    {
      "id": "p0006",
      "zh": "使之坚立。后来，他被举起，"
    },
    {
      "id": "p0007",
      "zh": "照着所赐的肉身，在约旦河口"
    },
    {
      "id": "p0008",
      "zh": "受了洗；那河奔流不息，"
    },
    {
      "id": "p0009",
      "zh": "拖曳着闪耀的波浪。他脱离火，"
    },
    {
      "id": "p0010",
      "zh": "首先要看见神甘美的灵，"
    },
    {
      "id": "p0011",
      "zh": "乘着白鸽的翅膀降下。"
    },
    {
      "id": "p0012",
      "zh": "纯洁的花要开放，泉源要充盈。"
    },
    {
      "id": "p0013",
      "zh": "他要向世人指示道路，显明"
    },
    {
      "id": "p0014",
      "zh": "属天的路径，以智慧教导众人。"
    },
    {
      "id": "p0015",
      "zh": "他要为审判而来，劝服"
    },
    {
      "id": "p0016",
      "zh": "悖逆的百姓，又以自己出于天父、"
    },
    {
      "id": "p0017",
      "zh": "配受赞美的血统为荣。"
    },
    {
      "id": "p0018",
      "zh": "他要践踏波浪，除去世人的"
    },
    {
      "id": "p0019",
      "zh": "疾病，使死人复活，"
    },
    {
      "id": "p0020",
      "zh": "驱散许多苦难。"
    },
    {
      "id": "p0021",
      "zh": "一个行囊里的饼，就能使众人饱足，"
    },
    {
      "id": "p0022",
      "zh": "那时，大卫家将生出一个孩子；"
    },
    {
      "id": "p0023",
      "zh": "全世界，地、天、海，都在他手中。"
    },
    {
      "id": "p0024",
      "zh": "他要在地上闪耀，如同从前"
    },
    {
      "id": "p0025",
      "zh": "那两个从彼此肋旁所生的人，"
    },
    {
      "id": "p0026",
      "zh": "看见人的形状显现。此事要发生，"
    },
    {
      "id": "p0027",
      "zh": "那时，大地因盼望孩子而欢喜。"
    },
    {
      "id": "p0028",
      "zh": "惟有你，所多玛般的土地，"
    },
    {
      "id": "p0029",
      "zh": "有凶恶的灾祸为你存留；因为你"
    },
    {
      "id": "p0030",
      "zh": "心怀恶意，不认识你的神，"
    },
    {
      "id": "p0031",
      "zh": "就是嗤笑世人计谋的那一位；你反以荆棘"
    },
    {
      "id": "p0032",
      "zh": "为他编冠冕，将可怕的苦胆"
    },
    {
      "id": "p0033",
      "zh": "掺入凌辱和恶意之中。"
    },
    {
      "id": "p0034",
      "zh": "这些事必使凶恶的灾祸临到你。"
    },
    {
      "id": "p0035",
      "zh": "哦，木头啊，你何等有福，"
    },
    {
      "id": "p0036",
      "zh": "神在你上面伸展身体；大地将不再拥有你，"
    },
    {
      "id": "p0037",
      "zh": "你却要仰望天上的居所，"
    },
    {
      "id": "p0038",
      "zh": "神啊，那时你要闪动火焰的眼睛。"
    }
  ],
  "references": [
    "中文参考《基督教典外文献（共10册）_手机版.txt》第261章《基督教西卜神谕篇》六、七书，52478—52892行；英文诗行逐块完整翻译，异文、次序及残缺以英文为准。",
    "补核同一总集旧约卷二完整《西卜神谕篇》第29章，9132—9192行；已比对相应全卷，包括新约卷四选篇未收录部分。措辞仅供参考，分歧仍依英文底本。"
  ],
  "notes": [
    "本卷“两人从彼此肋旁所生”等特殊意象及末段人称转换均依底本保留，未以其他版本改写。"
  ]
}
