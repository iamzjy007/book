{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cW2Z",
  "source_sha256": "cd927f4e671a289852e5b369a43b11f1b84f5e30c4661b6060f5d6bc2ff2deba",
  "reviewed": true,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第十三卷"
    },
    {
      "id": "p0002",
      "zh": "〔引言，1—8行；战争与灾祸之时，9—16行；波斯人叛乱及罗马的战士之王，17—28行；来自叙利亚的战士和他的儿子，29—47行；波斯战争和出产谷物的尼罗河之地，48—65行；宣告另一首关于亚历山大人的诗歌，66—71行；忿怒临到亚述人和爱琴海人，72—78行；悲惨的安提阿，79—84行；劝告阿拉伯诸城，85—97行；战争与背叛，98—106行；来自达契亚的罗马统治者，107—116行；叙利亚的强盗，117—135行；高卢王与可怕的灾祸，136—156行；悲惨的叙利亚，157—165行；悲惨的安提阿，165—171行；灾祸临到亚细亚许多城，172—189行；凶杀与战争，190—208行；公牛、龙、鹿、狮子和山羊的寓言，209—230行；西卜的祷告，231—232行。〕"
    },
    {
      "id": "p0003",
      "zh": "他吩咐我再次歌唱伟大的神圣话语——"
    },
    {
      "id": "p0004",
      "zh": "他就是永生、圣洁、永不朽坏的神，"
    },
    {
      "id": "p0005",
      "zh": "将权柄赐给诸王，也将权柄夺去，"
    },
    {
      "id": "p0006",
      "zh": "为他们定下两种时限，"
    },
    {
      "id": "p0007",
      "zh": "就是生存之时，以及凶恶的死亡之时。"
    },
    {
      "id": "p0008",
      "zh": "天上的神将这些事吩咐我，"
    },
    {
      "id": "p0009",
      "zh": "我虽不愿意，仍须向诸王传告"
    },
    {
      "id": "p0010",
      "zh": "关乎王权的消息……"
    },
    {
      "id": "p0011",
      "zh": "又有长矛与狂暴的阿瑞斯；在他手下，"
    },
    {
      "id": "p0012",
      "zh": "一切都要灭亡，孩子和那为"
    },
    {
      "id": "p0013",
      "zh": "会众制定律法的老人都要如此；必有许多战争、"
    },
    {
      "id": "p0014",
      "zh": "争斗和凶杀，"
    },
    {
      "id": "p0015",
      "zh": "饥荒、瘟疫、地震，"
    },
    {
      "id": "p0016",
      "zh": "猛烈的雷击；亚述人的许多行径"
    },
    {
      "id": "p0017",
      "zh": "必遍布全地，"
    },
    {
      "id": "p0018",
      "zh": "又有掠夺和抢劫殿宇的事。"
    },
    {
      "id": "p0019",
      "zh": "随后，勤勉的波斯人"
    },
    {
      "id": "p0020",
      "zh": "必起来叛乱，与他们一同的，"
    },
    {
      "id": "p0021",
      "zh": "还有印度人、亚美尼亚人和阿拉伯人；"
    },
    {
      "id": "p0022",
      "zh": "又有一位罗马王必向这些人"
    },
    {
      "id": "p0023",
      "zh": "逼近，他永不厌战，率领"
    },
    {
      "id": "p0024",
      "zh": "执矛的兵攻打亚述人，"
    },
    {
      "id": "p0025",
      "zh": "如年轻的阿瑞斯；善战的阿瑞斯"
    },
    {
      "id": "p0026",
      "zh": "必伸出致命的长矛，直到"
    },
    {
      "id": "p0027",
      "zh": "深流闪银的幼发拉底河，"
    },
    {
      "id": "p0028",
      "zh": "因为……"
    },
    {
      "id": "p0029",
      "zh": "他必被朋友出卖，倒在"
    },
    {
      "id": "p0030",
      "zh": "行伍中，被闪亮的铁器击中。"
    },
    {
      "id": "p0031",
      "zh": "随后，立刻有一位从叙利亚而来、"
    },
    {
      "id": "p0032",
      "zh": "喜爱紫袍的战士起来掌权，"
    },
    {
      "id": "p0033",
      "zh": "带来阿瑞斯的恐怖；他的儿子"
    },
    {
      "id": "p0034",
      "zh": "也必作凯撒，压迫全地；"
    },
    {
      "id": "p0035",
      "zh": "他们两人同有一个名字："
    },
    {
      "id": "p0036",
      "zh": "在第一和第二十之上，还要加上"
    },
    {
      "id": "p0037",
      "zh": "五百。但当他们在战争中掌权，"
    },
    {
      "id": "p0038",
      "zh": "制定律法时，必有"
    },
    {
      "id": "p0039",
      "zh": "短暂的休战，却不长久；"
    },
    {
      "id": "p0040",
      "zh": "但当一只狼向羊群"
    },
    {
      "id": "p0041",
      "zh": "郑重起誓，要对付白牙的狗，"
    },
    {
      "id": "p0042",
      "zh": "它迷惑了羊群以后，必将"
    },
    {
      "id": "p0043",
      "zh": "披毛的羊撕碎，将誓言抛弃；"
    },
    {
      "id": "p0044",
      "zh": "随后，高傲的诸王必在战争中"
    },
    {
      "id": "p0045",
      "zh": "不法地相争；叙利亚人"
    },
    {
      "id": "p0046",
      "zh": "必悲惨地灭亡，印度人、"
    },
    {
      "id": "p0047",
      "zh": "亚美尼亚人、阿拉伯人、"
    },
    {
      "id": "p0048",
      "zh": "波斯人和巴比伦人，"
    },
    {
      "id": "p0049",
      "zh": "必在苦战中彼此毁灭。"
    },
    {
      "id": "p0050",
      "zh": "但当罗马的阿瑞斯毁灭了"
    },
    {
      "id": "p0051",
      "zh": "那得胜于大洋之上、毁灭生命的"
    },
    {
      "id": "p0052",
      "zh": "日耳曼阿瑞斯，高傲的波斯人"
    },
    {
      "id": "p0053",
      "zh": "就必连年争战，"
    },
    {
      "id": "p0054",
      "zh": "却不能得胜；"
    },
    {
      "id": "p0055",
      "zh": "因为鱼不能在高耸、"
    },
    {
      "id": "p0056",
      "zh": "多脊、多风又陡峭的"
    },
    {
      "id": "p0057",
      "zh": "岩石尖上游水，龟也不会飞，"
    },
    {
      "id": "p0058",
      "zh": "鹰也不进入水中，"
    },
    {
      "id": "p0059",
      "zh": "照样，波斯人在那日"
    },
    {
      "id": "p0060",
      "zh": "也远离胜利。那爱护"
    },
    {
      "id": "p0061",
      "zh": "意大利人的乳母，安卧在尼罗河平原、"
    },
    {
      "id": "p0062",
      "zh": "圣水之旁，"
    },
    {
      "id": "p0063",
      "zh": "必向七山的罗马送去所定的贡赋。"
    },
    {
      "id": "p0064",
      "zh": "这些事必要如此；按流转时日的数值，"
    },
    {
      "id": "p0065",
      "zh": "罗马的名字有多少，"
    },
    {
      "id": "p0066",
      "zh": "那马其顿君主的尊贵大城"
    },
    {
      "id": "p0067",
      "zh": "就必甘心供应多少年的谷物。"
    },
    {
      "id": "p0068",
      "zh": "我要再歌唱一种极其痛苦的灾难，"
    },
    {
      "id": "p0069",
      "zh": "临到亚历山大人；他们必"
    },
    {
      "id": "p0070",
      "zh": "因卑劣之人的纷争而毁灭。"
    },
    {
      "id": "p0071",
      "zh": "从前可怕的强者，"
    },
    {
      "id": "p0072",
      "zh": "那时必软弱无力，因首领的邪恶，"
    },
    {
      "id": "p0073",
      "zh": "恳求和平。"
    },
    {
      "id": "p0074",
      "zh": "大能神的忿怒必临到"
    },
    {
      "id": "p0075",
      "zh": "亚述人；一道山洪"
    },
    {
      "id": "p0076",
      "zh": "必将他们全然毁灭，流到"
    },
    {
      "id": "p0077",
      "zh": "凯撒之城，伤害迦南人。"
    },
    {
      "id": "p0078",
      "zh": "皮拉摩斯河必灌入"
    },
    {
      "id": "p0079",
      "zh": "摩普索斯城；随后，爱琴海人必"
    },
    {
      "id": "p0080",
      "zh": "因极强之人的争斗而倒下。"
    },
    {
      "id": "p0081",
      "zh": "你这悲惨的安提阿，当亚述的战争"
    },
    {
      "id": "p0082",
      "zh": "从四面逼迫你时，强大的阿瑞斯"
    },
    {
      "id": "p0083",
      "zh": "必不离开你；因为有一位众人的首领"
    },
    {
      "id": "p0084",
      "zh": "必住在你的屋宇中，与所有"
    },
    {
      "id": "p0085",
      "zh": "发箭的波斯人争战；他自己"
    },
    {
      "id": "p0086",
      "zh": "已经取得罗马人的王权。"
    },
    {
      "id": "p0087",
      "zh": "如今，阿拉伯人的诸城，要装饰自己，"
    },
    {
      "id": "p0088",
      "zh": "建造殿宇和竞赛场，"
    },
    {
      "id": "p0089",
      "zh": "宽阔的市集，陈列辉煌的财富，"
    },
    {
      "id": "p0090",
      "zh": "又有雕像、黄金、白银和象牙；"
    },
    {
      "id": "p0091",
      "zh": "你们这在众城中最喜爱求知的，"
    },
    {
      "id": "p0092",
      "zh": "波斯拉和腓立波波利斯，也要如此，好叫你们"
    },
    {
      "id": "p0093",
      "zh": "陷入大忧愁。黄道穹顶上"
    },
    {
      "id": "p0094",
      "zh": "那些欢笑的星球，白羊宫、"
    },
    {
      "id": "p0095",
      "zh": "金牛宫、双子宫，以及一切与它们"
    },
    {
      "id": "p0096",
      "zh": "同现于天、掌管时辰的星宿，"
    },
    {
      "id": "p0097",
      "zh": "都不能使你得益。你这可怜的城，"
    },
    {
      "id": "p0098",
      "zh": "倚靠了许多，然而那个人"
    },
    {
      "id": "p0099",
      "zh": "随后必将属于你的带近。"
    },
    {
      "id": "p0100",
      "zh": "如今，我要为好战的亚历山大人"
    },
    {
      "id": "p0101",
      "zh": "歌唱极可怕的战争；许多百姓"
    },
    {
      "id": "p0102",
      "zh": "必灭亡，他们的城邑必被毁坏，"
    },
    {
      "id": "p0103",
      "zh": "因居民彼此为敌，"
    },
    {
      "id": "p0104",
      "zh": "为可恨的纷争而战；"
    },
    {
      "id": "p0105",
      "zh": "那冲入他们四周的可怕阿瑞斯，"
    },
    {
      "id": "p0106",
      "zh": "必止息战争。随后，一个心志刚强的人"
    },
    {
      "id": "p0107",
      "zh": "必与自己强有力的儿子一同，"
    },
    {
      "id": "p0108",
      "zh": "因年长之王的缘故，被诡计倾覆。"
    },
    {
      "id": "p0109",
      "zh": "他以后，另有一位心志刚强的君主"
    },
    {
      "id": "p0110",
      "zh": "必大有权势地治理富饶的罗马，"
    },
    {
      "id": "p0111",
      "zh": "他精通战争，来自达契亚人，"
    },
    {
      "id": "p0112",
      "zh": "数值为三百；他还有"
    },
    {
      "id": "p0113",
      "zh": "数值为四的字母。"
    },
    {
      "id": "p0114",
      "zh": "他必杀死许多人；随后，王"
    },
    {
      "id": "p0115",
      "zh": "必毁灭自己所有的弟兄和朋友，"
    },
    {
      "id": "p0116",
      "zh": "正当诸王被剪除时；立刻"
    },
    {
      "id": "p0117",
      "zh": "必有争斗、掠夺和凶杀，"
    },
    {
      "id": "p0118",
      "zh": "因年长之王的缘故忽然发生。"
    },
    {
      "id": "p0119",
      "zh": "那时，一个狡猾的人被召而来，"
    },
    {
      "id": "p0120",
      "zh": "他是强盗，是个不出名的罗马人，"
    },
    {
      "id": "p0121",
      "zh": "从叙利亚出现，必用诡计"
    },
    {
      "id": "p0122",
      "zh": "闯入加帕多家人的族中，"
    },
    {
      "id": "p0123",
      "zh": "围困他们，紧紧压迫，"
    },
    {
      "id": "p0124",
      "zh": "永不厌战。那时，你们，"
    },
    {
      "id": "p0125",
      "zh": "提亚纳和马扎卡，必被"
    },
    {
      "id": "p0126",
      "zh": "攻取，沦为奴仆，"
    },
    {
      "id": "p0127",
      "zh": "颈项上再加一个可怕的轭。"
    },
    {
      "id": "p0128",
      "zh": "干旱的叙利亚必为被毁灭的人哀哭，"
    },
    {
      "id": "p0129",
      "zh": "那时月亮女神也不能保守"
    },
    {
      "id": "p0130",
      "zh": "她的圣城。然而，当他逃出"
    },
    {
      "id": "p0131",
      "zh": "叙利亚，来到罗马人面前，"
    },
    {
      "id": "p0132",
      "zh": "渡过幼发拉底河的水流，"
    },
    {
      "id": "p0133",
      "zh": "不再像罗马人，却像凶猛"
    },
    {
      "id": "p0134",
      "zh": "射箭的波斯人，那时，命数应验，"
    },
    {
      "id": "p0135",
      "zh": "意大利人的统治者必倒下，"
    },
    {
      "id": "p0136",
      "zh": "倒在行伍中，被闪亮的铁器击中；"
    },
    {
      "id": "p0137",
      "zh": "紧接着，他的儿女也必灭亡。"
    },
    {
      "id": "p0138",
      "zh": "但当罗马另一位王作王时，"
    },
    {
      "id": "p0139",
      "zh": "动荡不安的列国也必"
    },
    {
      "id": "p0140",
      "zh": "来到罗马人那里；毁灭人的阿瑞斯"
    },
    {
      "id": "p0141",
      "zh": "必与他的私生子来到罗马城墙前；"
    },
    {
      "id": "p0142",
      "zh": "那时也必有饥荒、瘟疫、"
    },
    {
      "id": "p0143",
      "zh": "猛烈的雷击、可怕的战争，"
    },
    {
      "id": "p0144",
      "zh": "城中也必忽然失去秩序；"
    },
    {
      "id": "p0145",
      "zh": "叙利亚人必悲惨地灭亡；"
    },
    {
      "id": "p0146",
      "zh": "因为至高者的大忿怒"
    },
    {
      "id": "p0147",
      "zh": "必临到他们，勤勉的波斯人"
    },
    {
      "id": "p0148",
      "zh": "也必立刻叛乱；叙利亚人"
    },
    {
      "id": "p0149",
      "zh": "与波斯人混在一起，必毁灭"
    },
    {
      "id": "p0150",
      "zh": "罗马人；然而按神的旨意，"
    },
    {
      "id": "p0151",
      "zh": "他们不能征服罗马人的律法。"
    },
    {
      "id": "p0152",
      "zh": "有祸了！多少人必带着财物，"
    },
    {
      "id": "p0153",
      "zh": "从东方逃到说别种语言的人中！"
    },
    {
      "id": "p0154",
      "zh": "有祸了！大地要喝下"
    },
    {
      "id": "p0155",
      "zh": "多少人的黑血！因为那时，"
    },
    {
      "id": "p0156",
      "zh": "活着的人必为死去的人"
    },
    {
      "id": "p0157",
      "zh": "口称有福，"
    },
    {
      "id": "p0158",
      "zh": "赞美死亡的美好，死亡却必远避他们。"
    },
    {
      "id": "p0159",
      "zh": "如今，你这悲惨的叙利亚，"
    },
    {
      "id": "p0160",
      "zh": "我为你忧伤哭泣；因为有可怕的一击"
    },
    {
      "id": "p0161",
      "zh": "必从发箭的人那里临到你，"
    },
    {
      "id": "p0162",
      "zh": "是你从未料想会临到自己的。"
    },
    {
      "id": "p0163",
      "zh": "又有一个罗马的逃亡者必来到，"
    },
    {
      "id": "p0164",
      "zh": "手持大矛，一路上与他的"
    },
    {
      "id": "p0165",
      "zh": "万万军兵渡过幼发拉底河，"
    },
    {
      "id": "p0166",
      "zh": "他必焚烧你，使万事"
    },
    {
      "id": "p0167",
      "zh": "陷入恶境。哦，悲惨的安提阿，"
    },
    {
      "id": "p0168",
      "zh": "人再不称你为城，"
    },
    {
      "id": "p0169",
      "zh": "因为你因自己的愚昧，必倒在"
    },
    {
      "id": "p0170",
      "zh": "长矛之下；他必剥去你的一切，"
    },
    {
      "id": "p0171",
      "zh": "使你赤裸，将你撇下，"
    },
    {
      "id": "p0172",
      "zh": "毫无遮蔽，无家可归；凡看见你的人，"
    },
    {
      "id": "p0173",
      "zh": "都必立刻为你流泪。"
    },
    {
      "id": "p0174",
      "zh": "你，希拉波立，必成为"
    },
    {
      "id": "p0175",
      "zh": "得胜者的战利品；庇哩亚，你也如此；你要"
    },
    {
      "id": "p0176",
      "zh": "在迦尔基斯为新近受伤的儿女哭泣。"
    },
    {
      "id": "p0177",
      "zh": "有祸了！多少人住在高耸险峻的"
    },
    {
      "id": "p0178",
      "zh": "卡西乌斯山旁，多少人住在阿马努斯山旁，"
    },
    {
      "id": "p0179",
      "zh": "又有多少人住在里古河流过之处，"
    },
    {
      "id": "p0180",
      "zh": "在马尔叙阿斯河和闪着银色漩涡的"
    },
    {
      "id": "p0181",
      "zh": "皮拉摩斯河旁！因为他们积聚掠物，必远达"
    },
    {
      "id": "p0182",
      "zh": "亚细亚的边界，"
    },
    {
      "id": "p0183",
      "zh": "剥尽各城，抢走偶像，"
    },
    {
      "id": "p0184",
      "zh": "在出产丰盛的大地上拆毁殿宇。"
    },
    {
      "id": "p0185",
      "zh": "又有一日，高卢人和潘诺尼亚人，"
    },
    {
      "id": "p0186",
      "zh": "每西亚人和庇推尼人，必有"
    },
    {
      "id": "p0187",
      "zh": "大忧愁，因为一个战士来到。"
    },
    {
      "id": "p0188",
      "zh": "哦，吕基亚人，吕基亚人，必有一只狼来到，"
    },
    {
      "id": "p0189",
      "zh": "舔你们的血；那时萨尼人必与"
    },
    {
      "id": "p0190",
      "zh": "毁城的阿瑞斯同来，卡尔皮人"
    },
    {
      "id": "p0191",
      "zh": "也必前来与奥索尼亚人交战。"
    },
    {
      "id": "p0192",
      "zh": "随后，那私生子因自己的"
    },
    {
      "id": "p0193",
      "zh": "无耻妄为，必杀死王，"
    },
    {
      "id": "p0194",
      "zh": "他自己也必因不敬虔"
    },
    {
      "id": "p0195",
      "zh": "立刻灭亡。他以后，"
    },
    {
      "id": "p0196",
      "zh": "又有另一人必掌权，名字显出"
    },
    {
      "id": "p0197",
      "zh": "第一个字母；然而他也必很快倒在"
    },
    {
      "id": "p0198",
      "zh": "强大的阿瑞斯手下，被闪亮的铁器击中。"
    },
    {
      "id": "p0199",
      "zh": "世界必再次混乱，"
    },
    {
      "id": "p0200",
      "zh": "人因瘟疫和战争而灭亡。"
    },
    {
      "id": "p0201",
      "zh": "波斯人被奥索尼亚人激怒，"
    },
    {
      "id": "p0202",
      "zh": "必再次在阿瑞斯的劳苦中"
    },
    {
      "id": "p0203",
      "zh": "奋力闯入。那时，罗马人"
    },
    {
      "id": "p0204",
      "zh": "必逃亡；此后有一位"
    },
    {
      "id": "p0205",
      "zh": "四方闻名的祭司必来到，是太阳差来的，"
    },
    {
      "id": "p0206",
      "zh": "从叙利亚出现；他必用诡计"
    },
    {
      "id": "p0207",
      "zh": "成就万事。那时，"
    },
    {
      "id": "p0208",
      "zh": "太阳之城也必献上祈祷；"
    },
    {
      "id": "p0209",
      "zh": "在城的四围，波斯人必敢于面对"
    },
    {
      "id": "p0210",
      "zh": "腓尼基人可怕的威吓。"
    },
    {
      "id": "p0211",
      "zh": "但当两位善于迅速争战的首领"
    },
    {
      "id": "p0212",
      "zh": "治理极强大的罗马人时，"
    },
    {
      "id": "p0213",
      "zh": "其中一人数值为七十，另一人"
    },
    {
      "id": "p0214",
      "zh": "数值为三；那时，威严的公牛，"
    },
    {
      "id": "p0215",
      "zh": "用蹄刨地，用两角"
    },
    {
      "id": "p0216",
      "zh": "扬起尘土，必加给"
    },
    {
      "id": "p0217",
      "zh": "一条黑皮爬虫许多灾祸——"
    },
    {
      "id": "p0218",
      "zh": "那爬虫以鳞片拖出一道痕迹；此外，"
    },
    {
      "id": "p0219",
      "zh": "公牛自己也必灭亡。此后，"
    },
    {
      "id": "p0220",
      "zh": "又有另一只角形秀美的牡鹿来到，"
    },
    {
      "id": "p0221",
      "zh": "在山中挨饿，竭力想要"
    },
    {
      "id": "p0222",
      "zh": "吞吃吐毒的野兽。"
    },
    {
      "id": "p0223",
      "zh": "随后，一只可畏可怕的狮子必来到，"
    },
    {
      "id": "p0224",
      "zh": "是太阳差来的，喷出许多烈焰。"
    },
    {
      "id": "p0225",
      "zh": "那时，他也必凭自己无耻的妄为，"
    },
    {
      "id": "p0226",
      "zh": "毁灭那角形完美、奔跑迅疾的牡鹿，"
    },
    {
      "id": "p0227",
      "zh": "以及那最强大、吐毒的野兽，"
    },
    {
      "id": "p0228",
      "zh": "就是发出许多尖声、极其可怕的兽，"
    },
    {
      "id": "p0229",
      "zh": "又毁灭那侧身而行的公山羊；"
    },
    {
      "id": "p0230",
      "zh": "声名随着他；他自己"
    },
    {
      "id": "p0231",
      "zh": "必健全无伤、无人能近，统治"
    },
    {
      "id": "p0232",
      "zh": "罗马人，波斯人却必衰弱。"
    },
    {
      "id": "p0233",
      "zh": "然而，主啊，世界的王，神啊，求你止息"
    },
    {
      "id": "p0234",
      "zh": "我们言语的诗歌，赐下悦耳的歌。"
    }
  ],
  "references": [
    "中文参考总集旧约卷二第34章《西卜神谕篇》卷13，11971—12355行；已通读比对，英文控制内容、分行、数字及残缺。"
  ],
  "notes": [
    "“亚述人的许多行径”“将属于你的带近”等英文表述不明，未据参考本另改；停止战争等与参考本不同的动词也照英文保留。",
    "本卷字母数值和兽类隐喻依英文保留，没有用推测的历史人物姓名替代。",
    "月亮女神对应原文Selenian goddess；其他残缺处照底本保留。"
  ]
}
