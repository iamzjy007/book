{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cUCY",
  "source_sha256": "013720f7577a3e214d7f109214890f6ce4bfc5929a754c64429d67c7d501ea21",
  "reviewed": true,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第七卷"
    },
    {
      "id": "p0002",
      "zh": "〔罗得、得洛斯、居比路和西西里的灾祸，1—9行；洪水，10—15行；弗吕家、古实和埃及的毁灭，16—28行；老底嘉的灾祸，29—31行；弥赛亚的神迹与大能，32—49行；新枝，50—52行；波斯战争，53—67行；伊利亚斯的倾覆，68—72行；科洛丰、帖撒利、哥林多和推罗的结局，73—86行；基利叙利亚受咒诅，87—102行；献祭与施舍的规矩，103—130行；撒丁、米格多尼亚、凯尔特之地、罗马、叙利亚和底比斯的结局，131—161行；吞灭万物的火，162—190行；长夜过去，美好的时期来到，191—205行；西卜的认罪与结局，206—221行。〕"
    },
    {
      "id": "p0003",
      "zh": "罗得啊，你不幸了，因为我要首先"
    },
    {
      "id": "p0004",
      "zh": "为你哀哭；你要在众城之中"
    },
    {
      "id": "p0005",
      "zh": "居首，也要最先遭到毁灭，"
    },
    {
      "id": "p0006",
      "zh": "失去居民，却并非全然"
    },
    {
      "id": "p0007",
      "zh": "没有生活所需之物。得洛斯啊，你要漂流，"
    },
    {
      "id": "p0008",
      "zh": "在水上摇荡不定。"
    },
    {
      "id": "p0009",
      "zh": "居比路啊，有朝一日，你那闪耀海面的波浪"
    },
    {
      "id": "p0010",
      "zh": "要将你毁灭；西西里啊，"
    },
    {
      "id": "p0011",
      "zh": "你里面燃烧的火，要把你吞灭。"
    },
    {
      "id": "p0012",
      "zh": "也不理会神那可怕、异乎寻常的洪水。"
    },
    {
      "id": "p0013",
      "zh": "万民之中，惟有挪亚逃脱出来。"
    },
    {
      "id": "p0014",
      "zh": "大地要漂浮，山岭要漂浮，连天空也要漂浮，"
    },
    {
      "id": "p0015",
      "zh": "万有都要成为水，一切事物"
    },
    {
      "id": "p0016",
      "zh": "要被水毁灭。众风"
    },
    {
      "id": "p0017",
      "zh": "将止息，第二个世代要来到。"
    },
    {
      "id": "p0018",
      "zh": "弗吕家啊，你要首先从水的顶端"
    },
    {
      "id": "p0019",
      "zh": "闪耀起来；又要首先不敬虔，"
    },
    {
      "id": "p0020",
      "zh": "否认神自己，讨好"
    },
    {
      "id": "p0021",
      "zh": "虚假的神；它们要把你彻底毁灭，"
    },
    {
      "id": "p0022",
      "zh": "可怜的你啊，许多年岁就这样流转。"
    },
    {
      "id": "p0023",
      "zh": "注定败亡的古实人，在痛苦中"
    },
    {
      "id": "p0024",
      "zh": "承受悲惨之事；他们要被刀剑"
    },
    {
      "id": "p0025",
      "zh": "击杀，伏在地上。"
    },
    {
      "id": "p0026",
      "zh": "富饶的埃及总挂心自己的谷物，"
    },
    {
      "id": "p0027",
      "zh": "尼罗河的七条丰水支流"
    },
    {
      "id": "p0028",
      "zh": "使田地饱饮；她却要在内争中"
    },
    {
      "id": "p0029",
      "zh": "被毁灭。从那里，人们会出乎意料地"
    },
    {
      "id": "p0030",
      "zh": "驱逐亚皮斯，他并不是世人的神。"
    },
    {
      "id": "p0031",
      "zh": "老底嘉啊，你有祸了，有祸了！"
    },
    {
      "id": "p0032",
      "zh": "你从未见神，胆大妄为，却要倒卧；"
    },
    {
      "id": "p0033",
      "zh": "里古河的波浪要冲过你。"
    },
    {
      "id": "p0034",
      "zh": "那降生为大能之神的，"
    },
    {
      "id": "p0035",
      "zh": "要行许多神迹，在天空中央"
    },
    {
      "id": "p0036",
      "zh": "悬起一根轴，使世人看见"
    },
    {
      "id": "p0037",
      "zh": "高处极其可怕的异象，"
    },
    {
      "id": "p0038",
      "zh": "以大火量出一根柱子，"
    },
    {
      "id": "p0039",
      "zh": "火滴要杀死世人中"
    },
    {
      "id": "p0040",
      "zh": "敢于作恶的族类。但有朝一日，"
    },
    {
      "id": "p0041",
      "zh": "众人要有一位共同的主，世人"
    },
    {
      "id": "p0042",
      "zh": "要祈求神息怒，却仍不能终止"
    },
    {
      "id": "p0043",
      "zh": "徒然的忧患。藉着大卫家，"
    },
    {
      "id": "p0044",
      "zh": "一切都要成就。因为神亲自"
    },
    {
      "id": "p0045",
      "zh": "将权能赐给他，交在他手中。"
    },
    {
      "id": "p0046",
      "zh": "他的使者要安睡在他脚下，"
    },
    {
      "id": "p0047",
      "zh": "有的点燃火，有的使"
    },
    {
      "id": "p0048",
      "zh": "河流出现，有的拯救城邑，"
    },
    {
      "id": "p0049",
      "zh": "有的发出众风。此外，"
    },
    {
      "id": "p0050",
      "zh": "许多人要遭遇艰苦的生活，"
    },
    {
      "id": "p0051",
      "zh": "侵入他们的灵魂，改变世人的心。"
    },
    {
      "id": "p0052",
      "zh": "但当新枝从根中"
    },
    {
      "id": "p0053",
      "zh": "生出芽眼，那曾向万有"
    },
    {
      "id": "p0054",
      "zh": "赐下丰盛食物的受造界……"
    },
    {
      "id": "p0055",
      "zh": "到了时候，它要充满。然而，当"
    },
    {
      "id": "p0056",
      "zh": "另一族掌权，就是好战的波斯人，"
    },
    {
      "id": "p0057",
      "zh": "因着不法的行为，洞房立刻"
    },
    {
      "id": "p0058",
      "zh": "变得可怕。母亲要以自己的儿子"
    },
    {
      "id": "p0059",
      "zh": "为丈夫，儿子要成为"
    },
    {
      "id": "p0060",
      "zh": "母亲的毁灭；女儿要与父亲"
    },
    {
      "id": "p0061",
      "zh": "同卧，使这异邦的律法"
    },
    {
      "id": "p0062",
      "zh": "沉睡。此后，"
    },
    {
      "id": "p0063",
      "zh": "罗马的阿瑞斯要从无数长矛中向他们闪现，"
    },
    {
      "id": "p0064",
      "zh": "他们要使大片土地混满人血。"
    },
    {
      "id": "p0065",
      "zh": "但那时，意大利的一位首领要逃避"
    },
    {
      "id": "p0066",
      "zh": "矛锋的威力。他们却要在"
    },
    {
      "id": "p0067",
      "zh": "地上留下一枝刻有金字的长矛，"
    },
    {
      "id": "p0068",
      "zh": "作他们统治权的旗号，"
    },
    {
      "id": "p0069",
      "zh": "由前锋战士时刻高举。"
    },
    {
      "id": "p0070",
      "zh": "那邪恶、命途多舛的"
    },
    {
      "id": "p0071",
      "zh": "伊利亚斯，要悲惨地为众人备好"
    },
    {
      "id": "p0072",
      "zh": "坟墓而非婚礼；那时，新妇们要痛哭，"
    },
    {
      "id": "p0073",
      "zh": "因为她们不认识神，却总是"
    },
    {
      "id": "p0074",
      "zh": "敲击鼓和钹，发出喧闹之声。"
    },
    {
      "id": "p0075",
      "zh": "科洛丰啊，要去求问神谕，"
    },
    {
      "id": "p0076",
      "zh": "因为极其可怕的大火悬在你上方。"
    },
    {
      "id": "p0077",
      "zh": "婚配不祥的帖撒利啊，大地不再"
    },
    {
      "id": "p0078",
      "zh": "看见你，连你的灰烬也看不见；你要独自"
    },
    {
      "id": "p0079",
      "zh": "逃离大陆，在水上漂荡。"
    },
    {
      "id": "p0080",
      "zh": "可怜的你啊，就这样成为战争"
    },
    {
      "id": "p0081",
      "zh": "悲惨的残余，因为你倒在"
    },
    {
      "id": "p0082",
      "zh": "急流和刀剑之下。"
    },
    {
      "id": "p0083",
      "zh": "可怜的哥林多啊，你也要迎来"
    },
    {
      "id": "p0084",
      "zh": "严酷的阿瑞斯环绕，不幸的你，"
    },
    {
      "id": "p0085",
      "zh": "你们要彼此相杀而灭亡。"
    },
    {
      "id": "p0086",
      "zh": "推罗啊，你这不幸的，要孤独无伴；"
    },
    {
      "id": "p0087",
      "zh": "因为敬虔之人的衰弱，你成了寡妇，"
    },
    {
      "id": "p0088",
      "zh": "终必归于无有。"
    },
    {
      "id": "p0089",
      "zh": "哦，基利叙利亚，腓尼基人"
    },
    {
      "id": "p0090",
      "zh": "最后的据点，贝鲁特咸海"
    },
    {
      "id": "p0091",
      "zh": "吐出的海水，奔涌倾注在你身上；"
    },
    {
      "id": "p0092",
      "zh": "可怜的你啊，你不认识自己的神，"
    },
    {
      "id": "p0093",
      "zh": "他曾在约旦河口受洗，"
    },
    {
      "id": "p0094",
      "zh": "那灵展开翅膀，飞向他；"
    },
    {
      "id": "p0095",
      "zh": "在大地和星辰遍布的天空以前，"
    },
    {
      "id": "p0096",
      "zh": "他就已存在，他是真实的道，由父所生，"
    },
    {
      "id": "p0097",
      "zh": "又藉圣灵披上肉身，"
    },
    {
      "id": "p0098",
      "zh": "迅速飞往父的家。"
    },
    {
      "id": "p0099",
      "zh": "浩大的天为他建立"
    },
    {
      "id": "p0100",
      "zh": "三座塔，其中住着神尊贵的引导者："
    },
    {
      "id": "p0101",
      "zh": "盼望、敬虔，以及人所渴慕的敬畏，"
    },
    {
      "id": "p0102",
      "zh": "它们不以金银为乐，"
    },
    {
      "id": "p0103",
      "zh": "却喜悦世人敬畏的行为，"
    },
    {
      "id": "p0104",
      "zh": "就是献祭和至为公义的思想。"
    },
    {
      "id": "p0105",
      "zh": "你要向那不朽、"
    },
    {
      "id": "p0106",
      "zh": "大能、威严的神献祭，不把乳香的颗粒"
    },
    {
      "id": "p0107",
      "zh": "放在火里熔化，也不用刀"
    },
    {
      "id": "p0108",
      "zh": "宰杀毛茸茸的羊羔；你要与所有"
    },
    {
      "id": "p0109",
      "zh": "同你血脉的人，取来野鸟，献上祷告，"
    },
    {
      "id": "p0110",
      "zh": "举目向天，将鸟放飞。"
    },
    {
      "id": "p0111",
      "zh": "你要把水洒在清洁的火上，"
    },
    {
      "id": "p0112",
      "zh": "高声说：“父怎样生了"
    },
    {
      "id": "p0113",
      "zh": "你这道；父啊，我也放出一只鸟，"
    },
    {
      "id": "p0114",
      "zh": "作言语迅捷的使者，用圣水"
    },
    {
      "id": "p0115",
      "zh": "洒下，记念你的洗礼。道啊，藉着这洗礼，"
    },
    {
      "id": "p0116",
      "zh": "你在火中显明了自己。”"
    },
    {
      "id": "p0117",
      "zh": "若有外人来到你这里，"
    },
    {
      "id": "p0118",
      "zh": "因贫穷而饥饿，求你"
    },
    {
      "id": "p0119",
      "zh": "使他的饥饿止息，你不可关上门。"
    },
    {
      "id": "p0120",
      "zh": "你当接住那人，用水洒他，"
    },
    {
      "id": "p0121",
      "zh": "祷告三次，向你的神"
    },
    {
      "id": "p0122",
      "zh": "这样呼求：“我不渴求财富，"
    },
    {
      "id": "p0123",
      "zh": "我自己是乞求的人，却曾公开接待"
    },
    {
      "id": "p0124",
      "zh": "一个乞求的人；父啊，你是供应者，求你垂听。”"
    },
    {
      "id": "p0125",
      "zh": "你祷告以后，就当给他；"
    },
    {
      "id": "p0126",
      "zh": "那人后来离去……"
    },
    {
      "id": "p0127",
      "zh": "不要使我受苦，对神圣洁的敬畏，"
    },
    {
      "id": "p0128",
      "zh": "又公义，生来清洁，不受奴役，"
    },
    {
      "id": "p0129",
      "zh": "有见证……"
    },
    {
      "id": "p0130",
      "zh": "父啊，求你使我可怜的心"
    },
    {
      "id": "p0131",
      "zh": "安定；我仰望你，仰望"
    },
    {
      "id": "p0132",
      "zh": "那无玷污、非人手所造的你。"
    },
    {
      "id": "p0133",
      "zh": "撒丁啊，你如今举足轻重，却要化为"
    },
    {
      "id": "p0134",
      "zh": "灰烬。你不再是岛屿，"
    },
    {
      "id": "p0135",
      "zh": "等第十个时期来到。海浪中，"
    },
    {
      "id": "p0136",
      "zh": "水手要寻找你，你却已不复存在，"
    },
    {
      "id": "p0137",
      "zh": "翠鸟要在你上方唱哀伤的挽歌。"
    },
    {
      "id": "p0138",
      "zh": "崎岖的米格多尼亚，险海的"
    },
    {
      "id": "p0139",
      "zh": "灯塔啊，你要夸耀自己历经万代，"
    },
    {
      "id": "p0140",
      "zh": "却也要永远被"
    },
    {
      "id": "p0141",
      "zh": "热风毁灭，在许多灾祸中狂号。"
    },
    {
      "id": "p0142",
      "zh": "凯尔特之地啊，你在那巍峨的山脉上，"
    },
    {
      "id": "p0143",
      "zh": "在难以越过的阿尔卑斯山彼岸，深沙"
    },
    {
      "id": "p0144",
      "zh": "要将你完全埋葬；你不再缴纳"
    },
    {
      "id": "p0145",
      "zh": "贡物，不再出产谷物和牧草。"
    },
    {
      "id": "p0146",
      "zh": "你要长久远离人群，"
    },
    {
      "id": "p0147",
      "zh": "全然荒凉；寒冷的冰"
    },
    {
      "id": "p0148",
      "zh": "厚厚覆盖你。你要为一场暴行付出代价，"
    },
    {
      "id": "p0149",
      "zh": "不洁的你啊，那是你未曾察觉的。"
    },
    {
      "id": "p0150",
      "zh": "刚强的罗马啊，在马其顿的矛锋之后，"
    },
    {
      "id": "p0151",
      "zh": "你要向奥林匹斯发出闪电。"
    },
    {
      "id": "p0152",
      "zh": "但你在人眼中似乎站得"
    },
    {
      "id": "p0153",
      "zh": "更加稳固时，神却要使你"
    },
    {
      "id": "p0154",
      "zh": "彻底销声匿迹。那时，我要向你这样呼喊："
    },
    {
      "id": "p0155",
      "zh": "你在灭亡中要喊叫，痛苦"
    },
    {
      "id": "p0156",
      "zh": "沸腾。罗马啊，我还要第二次，"
    },
    {
      "id": "p0157",
      "zh": "再第二次向你说话。"
    },
    {
      "id": "p0158",
      "zh": "如今，可怜的叙利亚啊，"
    },
    {
      "id": "p0159",
      "zh": "我以怜悯的悲伤，为你痛苦哀号。"
    },
    {
      "id": "p0160",
      "zh": "底比斯人啊，你们听信愚计，邪恶的声音"
    },
    {
      "id": "p0161",
      "zh": "笼罩你们，笛声响起；"
    },
    {
      "id": "p0162",
      "zh": "号角要为你们吹出凶恶的声响，"
    },
    {
      "id": "p0163",
      "zh": "你们要看见全地毁灭！"
    },
    {
      "id": "p0164",
      "zh": "你这可怜的，有祸了，有祸了！"
    },
    {
      "id": "p0165",
      "zh": "心怀恶意的海啊，你有祸了，有祸了！"
    },
    {
      "id": "p0166",
      "zh": "你要被火完全吞灭，"
    },
    {
      "id": "p0167",
      "zh": "也要以咸水毁灭百姓。"
    },
    {
      "id": "p0168",
      "zh": "因为地上将有这样猛烈的火，"
    },
    {
      "id": "p0169",
      "zh": "流动如水，要毁灭"
    },
    {
      "id": "p0170",
      "zh": "全地。它要点燃山岭，"
    },
    {
      "id": "p0171",
      "zh": "烧着河流，使泉源干涸。"
    },
    {
      "id": "p0172",
      "zh": "人类灭亡时，"
    },
    {
      "id": "p0173",
      "zh": "世界要陷入混乱。那时，这些可怜的人，"
    },
    {
      "id": "p0174",
      "zh": "被火烧得惨烈，要望向天空，"
    },
    {
      "id": "p0175",
      "zh": "那里不再布满星辰，乃是火焰。他们不会"
    },
    {
      "id": "p0176",
      "zh": "迅速灭亡，却要从肉身以下"
    },
    {
      "id": "p0177",
      "zh": "消解，灵中仍在燃烧，"
    },
    {
      "id": "p0178",
      "zh": "历经漫长的年岁；他们才会知道，神的律法"
    },
    {
      "id": "p0179",
      "zh": "始终不可轻易试探，也不可"
    },
    {
      "id": "p0180",
      "zh": "欺瞒。那时，大地被强力攫住，"
    },
    {
      "id": "p0181",
      "zh": "因她胆敢接纳各样神明来到"
    },
    {
      "id": "p0182",
      "zh": "自己的祭坛，受了欺骗，便在改变的空气中"
    },
    {
      "id": "p0183",
      "zh": "化为烟雾；那些为得利而预言"
    },
    {
      "id": "p0184",
      "zh": "可耻之事、助长邪恶时代的人，"
    },
    {
      "id": "p0185",
      "zh": "也要承受极多的苦难。"
    },
    {
      "id": "p0186",
      "zh": "那些披着绵羊粗毛皮的"
    },
    {
      "id": "p0187",
      "zh": "希伯来人，要显为虚假；他们在这族类中"
    },
    {
      "id": "p0188",
      "zh": "并未承受产业，"
    },
    {
      "id": "p0189",
      "zh": "却只用空话谈论忧患，是一群"
    },
    {
      "id": "p0190",
      "zh": "贪吝之人。他们要改变生活的道路，"
    },
    {
      "id": "p0191",
      "zh": "却不能引诱义人走迷；义人从心里"
    },
    {
      "id": "p0192",
      "zh": "全然忠信，祈求他们的神息怒。"
    },
    {
      "id": "p0193",
      "zh": "当流转的年岁来到第三份，"
    },
    {
      "id": "p0194",
      "zh": "第八为首之时，另一个世界要出现。"
    },
    {
      "id": "p0195",
      "zh": "一切都将是黑夜……漫长而无光。"
    },
    {
      "id": "p0196",
      "zh": "随后，可怕的硫磺气味"
    },
    {
      "id": "p0197",
      "zh": "四处弥漫，作杀戮的使者，"
    },
    {
      "id": "p0198",
      "zh": "因为他们要被黑夜和饥饿夺去性命。"
    },
    {
      "id": "p0199",
      "zh": "那时，神要在世人里面生出清洁的心思，"
    },
    {
      "id": "p0200",
      "zh": "使这族类坚立，如同"
    },
    {
      "id": "p0201",
      "zh": "从前。再没有人"
    },
    {
      "id": "p0202",
      "zh": "用弯犁开出深沟，也没有两头牛"
    },
    {
      "id": "p0203",
      "zh": "沿直线把铁犁压入土中；不再有葡萄树，"
    },
    {
      "id": "p0204",
      "zh": "也没有麦穗；众人却要一同"
    },
    {
      "id": "p0205",
      "zh": "用洁白的牙齿，吃带着甘露的吗哪。"
    },
    {
      "id": "p0206",
      "zh": "那时，神也要在他们中间，"
    },
    {
      "id": "p0207",
      "zh": "教导他们，如同教导我"
    },
    {
      "id": "p0208",
      "zh": "这悲伤的人。我从前曾做过"
    },
    {
      "id": "p0209",
      "zh": "多少明知故犯的恶事，又有许多事，"
    },
    {
      "id": "p0210",
      "zh": "不加思索便邪恶地去行。"
    },
    {
      "id": "p0211",
      "zh": "我的床榻无数，却从不"
    },
    {
      "id": "p0212",
      "zh": "顾念婚姻之约；我全无信义，向众人"
    },
    {
      "id": "p0213",
      "zh": "起凶恶的誓。我曾拒绝"
    },
    {
      "id": "p0214",
      "zh": "贫乏的人，又走在前头，"
    },
    {
      "id": "p0215",
      "zh": "进入同样的山谷，不理会神的话。"
    },
    {
      "id": "p0216",
      "zh": "因此，火曾吞灭我，还要继续啃噬；"
    },
    {
      "id": "p0217",
      "zh": "因为我不能永远活着，一段"
    },
    {
      "id": "p0218",
      "zh": "邪恶的时期要毁灭我。那时，"
    },
    {
      "id": "p0219",
      "zh": "人要在海边为我"
    },
    {
      "id": "p0220",
      "zh": "筑造坟墓，用石头打死我；"
    },
    {
      "id": "p0221",
      "zh": "因为我与父亲同寝，给他生了"
    },
    {
      "id": "p0222",
      "zh": "一个爱子。打我吧，你们都来打我！"
    },
    {
      "id": "p0223",
      "zh": "因为这样，我才要活着，定睛仰望天上。"
    }
  ],
  "references": [
    "中文参考《基督教典外文献（共10册）_手机版.txt》第261章《基督教西卜神谕篇》六、七书，52478—52892行；英文诗行逐块完整翻译，异文、次序及残缺以英文为准。",
    "补核同一总集旧约卷二完整《西卜神谕篇》第30章，9193—9557行；已比对相应全卷，包括新约卷四选篇未收录部分。措辞仅供参考，分歧仍依英文底本。"
  ],
  "notes": [
    "纲要“长夜过去”原作101—205行，显与前项162—190及正文位置不合，译为191—205并在此注明。",
    "阿瑞斯是希腊战神，本卷以其名指战争；亚皮斯是埃及受敬奉的神牛。",
    "“第三份／第八为首”的纪年表述含混，按底本保留；末段山谷、父女同寝等与参考本有明显差异，均依英文。",
    "残篇祷词、黑夜等处的省略号均照底本保留，未用参考本补齐。"
  ]
}
