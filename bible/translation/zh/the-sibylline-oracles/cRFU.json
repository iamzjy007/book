{
  "book_id": "the-sibylline-oracles",
  "unit_id": "cRFU",
  "source_sha256": "d1c47daad358b449c81b181c6f8e0f59a81e24dd10f29ef80bb2fddf25a36535",
  "reviewed": true,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第一卷"
    },
    {
      "id": "p0002",
      "zh": "［宣告，1—5行。大地与人的创造，6—47行。最初的罪及刑罚，48—81行。第一代人的境况，82—107行。第二代人，108—129行。第三、第四代人，130—148行。巨人一代，149—153行。挪亚蒙召与传道，154—243行。进入方舟与洪水，244—281行。洪水消退，282—319行。出方舟，320—343行。第六代人与提坦，344—386行。论基督的预言，387—468行。希伯来人分散，469—485行。］"
    },
    {
      "id": "p0003",
      "zh": "从必死之人的第一代起，"
    },
    {
      "id": "p0004",
      "zh": "直到最后一代，"
    },
    {
      "id": "p0005",
      "zh": "我要逐一预言：昔日发生的，"
    },
    {
      "id": "p0006",
      "zh": "今日正在发生的，以及将来因人的不敬虔，"
    },
    {
      "id": "p0007",
      "zh": "临到世界的一切。"
    },
    {
      "id": "p0008",
      "zh": "如今，神首先催促我，"
    },
    {
      "id": "p0009",
      "zh": "如实述说世界怎样形成。"
    },
    {
      "id": "p0010",
      "zh": "你这精明的世人，当谨慎传扬，"
    },
    {
      "id": "p0011",
      "zh": "免得你忽略我的命令；"
    },
    {
      "id": "p0012",
      "zh": "要传扬那使万有存在的至高君王，"
    },
    {
      "id": "p0013",
      "zh": "祂说：“要有”，整个世界便有了。"
    },
    {
      "id": "p0014",
      "zh": "祂坚立大地，将它安置，"
    },
    {
      "id": "p0015",
      "zh": "环绕塔耳塔洛斯；祂亲自"
    },
    {
      "id": "p0016",
      "zh": "赐下柔和的光，将天高举，"
    },
    {
      "id": "p0017",
      "zh": "铺展闪耀的海，又以无数"
    },
    {
      "id": "p0018",
      "zh": "灿烂发光的星辰，为穹苍加冠；"
    },
    {
      "id": "p0019",
      "zh": "以草木装饰大地，将海"
    },
    {
      "id": "p0020",
      "zh": "与河相连，将空气与和风"
    },
    {
      "id": "p0021",
      "zh": "及含水的云相融；随后，又安排"
    },
    {
      "id": "p0022",
      "zh": "另一类受造者，将鱼赐给海，"
    },
    {
      "id": "p0023",
      "zh": "将飞鸟赐给风，将树林"
    },
    {
      "id": "p0024",
      "zh": "赐给颈生长毛的兽、爬行的蛇，"
    },
    {
      "id": "p0025",
      "zh": "以及如今地上所见的一切。"
    },
    {
      "id": "p0026",
      "zh": "这些都是祂用话语造成，万事"
    },
    {
      "id": "p0027",
      "zh": "迅速而准确地完成；"
    },
    {
      "id": "p0028",
      "zh": "祂自有永有，从天俯瞰，"
    },
    {
      "id": "p0029",
      "zh": "世界已经造好，极其美善。"
    },
    {
      "id": "p0030",
      "zh": "此后，祂又塑造"
    },
    {
      "id": "p0031",
      "zh": "一个有生命的受造者，照自己的形像，"
    },
    {
      "id": "p0032",
      "zh": "造出一个新人，秀美而有神的样式；"
    },
    {
      "id": "p0033",
      "zh": "吩咐他住在不朽的园中，"
    },
    {
      "id": "p0034",
      "zh": "专心料理美好的工作。"
    },
    {
      "id": "p0035",
      "zh": "但在乐园肥沃的田间，"
    },
    {
      "id": "p0036",
      "zh": "他孤独一人，渴望交谈，"
    },
    {
      "id": "p0037",
      "zh": "便祈求能看见另一个"
    },
    {
      "id": "p0038",
      "zh": "与自己相似的形体。神随即从人的身侧"
    },
    {
      "id": "p0039",
      "zh": "取出一根骨头，亲自造了美丽的夏娃，"
    },
    {
      "id": "p0040",
      "zh": "作他的配偶，又将她安置在乐园，"
    },
    {
      "id": "p0041",
      "zh": "与他同住。当他凝望她，"
    },
    {
      "id": "p0042",
      "zh": "心里忽然充满喜乐，"
    },
    {
      "id": "p0043",
      "zh": "极其赞叹，因为看见"
    },
    {
      "id": "p0044",
      "zh": "如此相似的样式；便以智慧的言语，"
    },
    {
      "id": "p0045",
      "zh": "自然流露，彼此应答，"
    },
    {
      "id": "p0046",
      "zh": "因为神看顾一切。他们的心思"
    },
    {
      "id": "p0047",
      "zh": "没有因情欲昏暗，也不遮掩"
    },
    {
      "id": "p0048",
      "zh": "赤裸的身体；他们的心远离邪恶，"
    },
    {
      "id": "p0049",
      "zh": "如同野兽一般，露着肢体行走。"
    },
    {
      "id": "p0050",
      "zh": "此后，神将命令赐给他们，"
    },
    {
      "id": "p0051",
      "zh": "指示他们不可触摸某一棵树；"
    },
    {
      "id": "p0052",
      "zh": "但可怕的蛇以诡计引他们偏离，"
    },
    {
      "id": "p0053",
      "zh": "走向死亡的命运，"
    },
    {
      "id": "p0054",
      "zh": "得知善恶。"
    },
    {
      "id": "p0055",
      "zh": "妻子首先成了背叛神的人，"
    },
    {
      "id": "p0056",
      "zh": "她给了男人，催促这不明白的人犯罪。"
    },
    {
      "id": "p0057",
      "zh": "男人受了女人言语的劝诱，"
    },
    {
      "id": "p0058",
      "zh": "完全忘记那不朽的创造主，"
    },
    {
      "id": "p0059",
      "zh": "忽略祂明白的命令。"
    },
    {
      "id": "p0060",
      "zh": "所以，他们照所行的，所得不是福，乃是祸。"
    },
    {
      "id": "p0061",
      "zh": "随后，他们把甜美无花果树的叶子"
    },
    {
      "id": "p0062",
      "zh": "穿在一起，做成衣裳，"
    },
    {
      "id": "p0063",
      "zh": "彼此穿上，遮住"
    },
    {
      "id": "p0064",
      "zh": "下体，因为心里羞愧。"
    },
    {
      "id": "p0065",
      "zh": "不朽者向他们发怒，"
    },
    {
      "id": "p0066",
      "zh": "将他们赶出不朽之地。"
    },
    {
      "id": "p0067",
      "zh": "从此，他们住在必朽之地，"
    },
    {
      "id": "p0068",
      "zh": "因为虽然听见，却没有遵守"
    },
    {
      "id": "p0069",
      "zh": "那不朽、大能之神的话。"
    },
    {
      "id": "p0070",
      "zh": "他们立刻走到出产丰盛的土地上，"
    },
    {
      "id": "p0071",
      "zh": "在眼泪和呻吟中，浑身湿透；"
    },
    {
      "id": "p0072",
      "zh": "那不朽的神，亲自向他们"
    },
    {
      "id": "p0073",
      "zh": "说了更美的话：“你们要生养，"
    },
    {
      "id": "p0074",
      "zh": "增多，不住地在地上劳作，"
    },
    {
      "id": "p0075",
      "zh": "好借着劳苦的汗水，"
    },
    {
      "id": "p0076",
      "zh": "得着足够的食物。”祂如此说，又使"
    },
    {
      "id": "p0077",
      "zh": "那施行欺骗的祸首，贴着地面，"
    },
    {
      "id": "p0078",
      "zh": "用腹部和身侧爬行，成为一条蛇，"
    },
    {
      "id": "p0079",
      "zh": "严厉地将他赶出去；又使"
    },
    {
      "id": "p0080",
      "zh": "他们之间有可怕的仇恨；蛇时刻留意，"
    },
    {
      "id": "p0081",
      "zh": "保护自己的头，"
    },
    {
      "id": "p0082",
      "zh": "人则保护自己的脚跟，因为死亡近在咫尺，"
    },
    {
      "id": "p0083",
      "zh": "紧挨着谋恶的毒蛇和人类。"
    },
    {
      "id": "p0084",
      "zh": "此后，人类果然增多，"
    },
    {
      "id": "p0085",
      "zh": "正如全能者亲自吩咐的，"
    },
    {
      "id": "p0086",
      "zh": "一族接着一族兴起，"
    },
    {
      "id": "p0087",
      "zh": "多得无法数算。他们修饰各式"
    },
    {
      "id": "p0088",
      "zh": "房屋，建造城邑和城墙，"
    },
    {
      "id": "p0089",
      "zh": "精良而巧妙；他们蒙赐"
    },
    {
      "id": "p0090",
      "zh": "长久的年日，享受所爱的生命；"
    },
    {
      "id": "p0091",
      "zh": "他们不是被愁苦耗尽而死，"
    },
    {
      "id": "p0092",
      "zh": "倒像被睡眠制伏。这些心胸宽广、"
    },
    {
      "id": "p0093",
      "zh": "极其有福的人，蒙不朽的救主，"
    },
    {
      "id": "p0094",
      "zh": "就是君王、神所爱。但他们也犯罪，"
    },
    {
      "id": "p0095",
      "zh": "被愚妄击中；他们肆无忌惮，"
    },
    {
      "id": "p0096",
      "zh": "讥笑父亲，藐视母亲；"
    },
    {
      "id": "p0097",
      "zh": "不认亲属，又密谋"
    },
    {
      "id": "p0098",
      "zh": "攻击兄弟。他们污秽不洁，"
    },
    {
      "id": "p0099",
      "zh": "以人的鲜血玷污自己，"
    },
    {
      "id": "p0100",
      "zh": "又兴起战争。于是，最后的灾祸"
    },
    {
      "id": "p0101",
      "zh": "从天降下，临到他们，"
    },
    {
      "id": "p0102",
      "zh": "夺去这些可怕之人的生命；"
    },
    {
      "id": "p0103",
      "zh": "阴间便收纳他们。那地称为"
    },
    {
      "id": "p0104",
      "zh": "阴间，因为亚当尝了死味，"
    },
    {
      "id": "p0105",
      "zh": "首先前往，大地将他四面包围。"
    },
    {
      "id": "p0106",
      "zh": "所以，凡生在地上的人，"
    },
    {
      "id": "p0107",
      "zh": "都蒙召往阴间的居所去。"
    },
    {
      "id": "p0108",
      "zh": "但这些人进入阴间，"
    },
    {
      "id": "p0109",
      "zh": "仍得尊荣，因为他们是最初的一代。"
    },
    {
      "id": "p0110",
      "zh": "阴间收纳这些人以后，神第二次，"
    },
    {
      "id": "p0111",
      "zh": "[[从余下最公义的人中，]]"
    },
    {
      "id": "p0112",
      "zh": "造成另一代极其聪敏的人，"
    },
    {
      "id": "p0113",
      "zh": "他们关注美好的工作、高尚的劳作，"
    },
    {
      "id": "p0114",
      "zh": "卓越的敬虔和稳固的智慧；"
    },
    {
      "id": "p0115",
      "zh": "他们受教于各样技艺，"
    },
    {
      "id": "p0116",
      "zh": "因物资缺乏而作出发明。"
    },
    {
      "id": "p0117",
      "zh": "有人发明用犁耕地，"
    },
    {
      "id": "p0118",
      "zh": "有人作木工，有人关心"
    },
    {
      "id": "p0119",
      "zh": "航海，有人观察星辰，"
    },
    {
      "id": "p0120",
      "zh": "又凭有翅的飞鸟占卜；"
    },
    {
      "id": "p0121",
      "zh": "有人钻研药物的使用，"
    },
    {
      "id": "p0122",
      "zh": "有人迷恋巫术；"
    },
    {
      "id": "p0123",
      "zh": "其余的人，也学会了人们所关注的"
    },
    {
      "id": "p0124",
      "zh": "各样技艺，警醒不倦，"
    },
    {
      "id": "p0125",
      "zh": "勤勉不息，配得这样的称号，"
    },
    {
      "id": "p0126",
      "zh": "因为他们里面有不眠的心思，"
    },
    {
      "id": "p0127",
      "zh": "又有庞大的身躯；他们形体壮伟，"
    },
    {
      "id": "p0128",
      "zh": "强健有力；然而仍然下到"
    },
    {
      "id": "p0129",
      "zh": "塔耳塔洛斯可怕的囚室，"
    },
    {
      "id": "p0130",
      "zh": "被坚固的锁链拘禁，受尽刑罚，"
    },
    {
      "id": "p0131",
      "zh": "在地狱中，经受猛烈、狂暴、不灭的火。"
    },
    {
      "id": "p0132",
      "zh": "这些人以后，第三代意志强悍的人"
    },
    {
      "id": "p0133",
      "zh": "出现了；他们专横，"
    },
    {
      "id": "p0134",
      "zh": "可怕，在彼此之间作出"
    },
    {
      "id": "p0135",
      "zh": "许多恶事。争斗、凶杀、"
    },
    {
      "id": "p0136",
      "zh": "战争，不断毁灭"
    },
    {
      "id": "p0137",
      "zh": "这些骄傲自大的人。"
    },
    {
      "id": "p0138",
      "zh": "此后，又从他们生出"
    },
    {
      "id": "p0139",
      "zh": "另一代人，晚近形成，最后出生，"
    },
    {
      "id": "p0140",
      "zh": "沾满鲜血，谋虑邪僻；这些人"
    },
    {
      "id": "p0141",
      "zh": "属于第四代，他们流了许多血，"
    },
    {
      "id": "p0142",
      "zh": "既不惧怕神，也不尊重人，"
    },
    {
      "id": "p0143",
      "zh": "因为狂乱的怒气和深重的不敬虔"
    },
    {
      "id": "p0144",
      "zh": "临到他们。战争、凶杀、"
    },
    {
      "id": "p0145",
      "zh": "争斗，将一些人送入厄瑞玻斯，"
    },
    {
      "id": "p0146",
      "zh": "因为他们骄横，不敬虔。"
    },
    {
      "id": "p0147",
      "zh": "余下的人，后来天上的神亲自"
    },
    {
      "id": "p0148",
      "zh": "在怒中，将他们从祂的世界除去，"
    },
    {
      "id": "p0149",
      "zh": "扔进巨大的塔耳塔洛斯，"
    },
    {
      "id": "p0150",
      "zh": "就是大地根基以下。"
    },
    {
      "id": "p0151",
      "zh": "更后来，祂又造成更坏的一代，"
    },
    {
      "id": "p0152",
      "zh": "[[此后，不朽者再没有为他们]]"
    },
    {
      "id": "p0153",
      "zh": "预备美善，因为他们行了许多恶事。"
    },
    {
      "id": "p0154",
      "zh": "他们比从前那些人更为强暴，"
    },
    {
      "id": "p0155",
      "zh": "是悖逆的巨人，口吐污言。"
    },
    {
      "id": "p0156",
      "zh": "众人之中，惟有挪亚最公义、最真实，"
    },
    {
      "id": "p0157",
      "zh": "也最忠信，专心"
    },
    {
      "id": "p0158",
      "zh": "追求最美好的工作。神亲自"
    },
    {
      "id": "p0159",
      "zh": "从天上对他说：“挪亚，你要放心，"
    },
    {
      "id": "p0160",
      "zh": "心里刚强，向众民宣告"
    },
    {
      "id": "p0161",
      "zh": "回转，好使他们全都得救。"
    },
    {
      "id": "p0162",
      "zh": "他们若厚颜无耻，不肯听从我，"
    },
    {
      "id": "p0163",
      "zh": "我就要用滔天洪水，"
    },
    {
      "id": "p0164",
      "zh": "将整个人类灭尽。如今，你要赶快，"
    },
    {
      "id": "p0165",
      "zh": "照我吩咐，造一座不会朽坏的房屋，"
    },
    {
      "id": "p0166",
      "zh": "使用坚固、不透水的木板。"
    },
    {
      "id": "p0167",
      "zh": "我要将悟性放在你心里，"
    },
    {
      "id": "p0168",
      "zh": "赐你精巧的手艺、尺寸的法则，"
    },
    {
      "id": "p0169",
      "zh": "以及次序；一切事我都要照管，"
    },
    {
      "id": "p0170",
      "zh": "使你和与你同住的人得救。"
    },
    {
      "id": "p0171",
      "zh": "我就是那自有的，你当在心里"
    },
    {
      "id": "p0172",
      "zh": "认出我。我以诸天为衣，"
    },
    {
      "id": "p0173",
      "zh": "用大海环绕自己；对我而言，"
    },
    {
      "id": "p0174",
      "zh": "地是脚凳，空气倾注，"
    },
    {
      "id": "p0175",
      "zh": "围着我的身体；四面八方，"
    },
    {
      "id": "p0176",
      "zh": "群星的歌队围着我运行。"
    },
    {
      "id": "p0177",
      "zh": "我的名有九个字母，四个音节，"
    },
    {
      "id": "p0178",
      "zh": "你要认出我。前三个音节，"
    },
    {
      "id": "p0179",
      "zh": "各有两个字母，最后一个包含余下的，"
    },
    {
      "id": "p0180",
      "zh": "其中五个是辅音；整个数值的总和，"
    },
    {
      "id": "p0181",
      "zh": "是十六个百，加上三个三十，"
    },
    {
      "id": "p0182",
      "zh": "再加七。如今，你知道我是谁，"
    },
    {
      "id": "p0183",
      "zh": "就不可不通晓我的奥义。”"
    },
    {
      "id": "p0184",
      "zh": "祂如此说；挪亚听了，"
    },
    {
      "id": "p0185",
      "zh": "便大大战兢。随后，他在心里"
    },
    {
      "id": "p0186",
      "zh": "筹划好每一件事，便恳求"
    },
    {
      "id": "p0187",
      "zh": "众人，开始这样说："
    },
    {
      "id": "p0188",
      "zh": "“哦，你们这些贪得无厌、大大疯狂的人，"
    },
    {
      "id": "p0189",
      "zh": "无论作了什么，都不能"
    },
    {
      "id": "p0190",
      "zh": "逃过神的察看，因为祂知道万事；"
    },
    {
      "id": "p0191",
      "zh": "那不朽的救主监察一切，"
    },
    {
      "id": "p0192",
      "zh": "吩咐我警告你们，免得你们灭亡。"
    },
    {
      "id": "p0193",
      "zh": "你们要清醒，除去邪恶，不要"
    },
    {
      "id": "p0194",
      "zh": "怀着流血的心，彼此强暴争斗，"
    },
    {
      "id": "p0195",
      "zh": "也不要用人的鲜血浇灌大片土地。"
    },
    {
      "id": "p0196",
      "zh": "世人啊，要敬畏那至高、伟大，"
    },
    {
      "id": "p0197",
      "zh": "无所惧怕的天上创造主，"
    },
    {
      "id": "p0198",
      "zh": "就是不朽的神，祂的居所在天上；"
    },
    {
      "id": "p0199",
      "zh": "你们众人都要恳求祂，祂本为慈善，"
    },
    {
      "id": "p0200",
      "zh": "求祂保全城邑和全世界的生命，"
    },
    {
      "id": "p0201",
      "zh": "也保全四足走兽和空中飞鸟；"
    },
    {
      "id": "p0202",
      "zh": "求祂恩待一切。"
    },
    {
      "id": "p0203",
      "zh": "因为当那无边的人类世界，"
    },
    {
      "id": "p0204",
      "zh": "全被洪水毁灭时，你们要高声"
    },
    {
      "id": "p0205",
      "zh": "发出可怕的哀号。忽然，"
    },
    {
      "id": "p0206",
      "zh": "你们头上的天空要混乱，"
    },
    {
      "id": "p0207",
      "zh": "大能之神的烈怒，要从天"
    },
    {
      "id": "p0208",
      "zh": "临到你们。这事必要成就，"
    },
    {
      "id": "p0209",
      "zh": "若你们不求神息怒，"
    },
    {
      "id": "p0210",
      "zh": "那不朽的救主必向人发怒；"
    },
    {
      "id": "p0211",
      "zh": "所以，从今以后，你们要回转，"
    },
    {
      "id": "p0212",
      "zh": "不可再任意妄为，作出暴躁、"
    },
    {
      "id": "p0213",
      "zh": "邪恶的事，彼此相害；"
    },
    {
      "id": "p0214",
      "zh": "各人当以圣洁的生活保守自己。”"
    },
    {
      "id": "p0215",
      "zh": "他们听了，却各自嗤之以鼻，"
    },
    {
      "id": "p0216",
      "zh": "称他为疯子，是狂乱附身的人。"
    },
    {
      "id": "p0217",
      "zh": "挪亚于是再次扬声宣告："
    },
    {
      "id": "p0218",
      "zh": "“哦，你们这些极其可怜、心地卑劣的人，"
    },
    {
      "id": "p0219",
      "zh": "反复无常，丢弃廉耻，"
    },
    {
      "id": "p0220",
      "zh": "喜爱无耻，贪婪的主宰，"
    },
    {
      "id": "p0221",
      "zh": "凶暴的罪人，虚假、贪得无厌、为非作歹，"
    },
    {
      "id": "p0222",
      "zh": "毫无诚实，暗中行淫，"
    },
    {
      "id": "p0223",
      "zh": "言语轻浮，口吐污秽，"
    },
    {
      "id": "p0224",
      "zh": "不怕至高神的烈怒；你们被存留，"
    },
    {
      "id": "p0225",
      "zh": "直到第五代，才要偿还罪债！"
    },
    {
      "id": "p0226",
      "zh": "你们这些无情的人，竟全不哀哭，反倒发笑；"
    },
    {
      "id": "p0227",
      "zh": "等到我所说的临到，"
    },
    {
      "id": "p0228",
      "zh": "就是神那可怕的洪水来时，你们必笑得凄惨。"
    },
    {
      "id": "p0229",
      "zh": "那时，夏娃那污秽的后裔，"
    },
    {
      "id": "p0230",
      "zh": "虽然在大地上常年繁茂，茎干坚韧，"
    },
    {
      "id": "p0231",
      "zh": "也要在一夜之间，连根带枝消失；"
    },
    {
      "id": "p0232",
      "zh": "震动大地的主，要从深处"
    },
    {
      "id": "p0233",
      "zh": "将城邑、居民和一切冲散，拆毁城墙。"
    },
    {
      "id": "p0234",
      "zh": "那时，全世界无数的人，"
    },
    {
      "id": "p0235",
      "zh": "都要死亡。但我将怎样哭泣，怎样在"
    },
    {
      "id": "p0236",
      "zh": "木屋里哀号，将眼泪与波浪混合呢？"
    },
    {
      "id": "p0237",
      "zh": "神所命的洪水若来，"
    },
    {
      "id": "p0238",
      "zh": "地要漂浮，山要漂浮，连天也要漂浮；"
    },
    {
      "id": "p0239",
      "zh": "一切都要成为水，万物"
    },
    {
      "id": "p0240",
      "zh": "都要被洪水毁灭。众风"
    },
    {
      "id": "p0241",
      "zh": "要止息，另一个世代要来临。"
    },
    {
      "id": "p0242",
      "zh": "哦，弗吕家，你要最先"
    },
    {
      "id": "p0243",
      "zh": "从水面浮现，也要最先养育"
    },
    {
      "id": "p0244",
      "zh": "另一代人，从头开始，"
    },
    {
      "id": "p0245",
      "zh": "重新兴起；你要作众人的乳母。”"
    },
    {
      "id": "p0246",
      "zh": "他这样向无法无天的一代"
    },
    {
      "id": "p0247",
      "zh": "徒然讲说之后，至高者"
    },
    {
      "id": "p0248",
      "zh": "便显现，再次高声宣告："
    },
    {
      "id": "p0249",
      "zh": "“挪亚，如今时候到了，要将"
    },
    {
      "id": "p0250",
      "zh": "每一件事，就是那日我向你"
    },
    {
      "id": "p0251",
      "zh": "应许并证实的一切，都宣告、成全；"
    },
    {
      "id": "p0252",
      "zh": "因为这民不肯顺服，"
    },
    {
      "id": "p0253",
      "zh": "在无边的世界中，尽行从前"
    },
    {
      "id": "p0254",
      "zh": "各世代所惯行的，"
    },
    {
      "id": "p0255",
      "zh": "无数邪恶之事。"
    },
    {
      "id": "p0256",
      "zh": "至于你，要赶快进去，带着儿子们，"
    },
    {
      "id": "p0257",
      "zh": "以及你们的妻子。照我吩咐的数目，召来"
    },
    {
      "id": "p0258",
      "zh": "各类走兽、爬物和飞鸟；"
    },
    {
      "id": "p0259",
      "zh": "凡我命定存活的，"
    },
    {
      "id": "p0260",
      "zh": "我都要使它们甘愿前往。”"
    },
    {
      "id": "p0261",
      "zh": "祂这样说；［挪亚］便出去，高声"
    },
    {
      "id": "p0262",
      "zh": "呼喊召集。随后，妻子、儿子和儿媳们，"
    },
    {
      "id": "p0263",
      "zh": "都进入木屋；其余活物，"
    },
    {
      "id": "p0264",
      "zh": "凡神愿意收在里面的，"
    },
    {
      "id": "p0265",
      "zh": "也都进入。等到合适的门闩"
    },
    {
      "id": "p0266",
      "zh": "装在盖板上，在磨平的位置"
    },
    {
      "id": "p0267",
      "zh": "横向扣紧，天上神的旨意"
    },
    {
      "id": "p0268",
      "zh": "就立刻成就。"
    },
    {
      "id": "p0269",
      "zh": "祂聚集云团，遮住太阳明亮的圆盘，"
    },
    {
      "id": "p0270",
      "zh": "也遮住月亮、星辰和环绕的诸天，"
    },
    {
      "id": "p0271",
      "zh": "使四围昏暗；祂大声发雷，"
    },
    {
      "id": "p0272",
      "zh": "令人惊惧，又发出闪电；"
    },
    {
      "id": "p0273",
      "zh": "所有的风一同兴起，"
    },
    {
      "id": "p0274",
      "zh": "一切水脉都被释放，"
    },
    {
      "id": "p0275",
      "zh": "天上巨大的瀑流敞开，"
    },
    {
      "id": "p0276",
      "zh": "从地底洞穴和永不止息的深渊，"
    },
    {
      "id": "p0277",
      "zh": "涌出无数的水，将整个"
    },
    {
      "id": "p0278",
      "zh": "无边的大地淹没。"
    },
    {
      "id": "p0279",
      "zh": "那奇妙的房屋却浮在水上，"
    },
    {
      "id": "p0280",
      "zh": "被许多狂浪撕扯，被狂风"
    },
    {
      "id": "p0281",
      "zh": "猛力击打，可怕地冲荡；"
    },
    {
      "id": "p0282",
      "zh": "船底劈开大片泡沫，"
    },
    {
      "id": "p0283",
      "zh": "四周水声喧腾，浪涛拍击。"
    },
    {
      "id": "p0284",
      "zh": "神用大雨淹没全世界的时候，"
    },
    {
      "id": "p0285",
      "zh": "挪亚也开始思量，要察看"
    },
    {
      "id": "p0286",
      "zh": "不朽者的旨意；因为他如今"
    },
    {
      "id": "p0287",
      "zh": "已经受够了涅柔斯。他立刻"
    },
    {
      "id": "p0288",
      "zh": "从磨平的屋壁上打开开口，"
    },
    {
      "id": "p0289",
      "zh": "那处原以精巧的支架横向扣紧。"
    },
    {
      "id": "p0290",
      "zh": "挪亚向四面望去，看见"
    },
    {
      "id": "p0291",
      "zh": "浩荡无边的水，"
    },
    {
      "id": "p0292",
      "zh": "这些竟都让他亲眼看见！"
    },
    {
      "id": "p0293",
      "zh": "恐惧攫住他的心，使他大大震颤。"
    },
    {
      "id": "p0294",
      "zh": "随后，天空稍稍平静，"
    },
    {
      "id": "p0295",
      "zh": "因为多日使全世界浸湿，"
    },
    {
      "id": "p0296",
      "zh": "已经疲倦；云层散开，显出"
    },
    {
      "id": "p0297",
      "zh": "广大的天，苍白而血红，"
    },
    {
      "id": "p0298",
      "zh": "太阳明亮的圆盘也已疲惫；挪亚"
    },
    {
      "id": "p0299",
      "zh": "几乎失了勇气。随后，他将"
    },
    {
      "id": "p0300",
      "zh": "一只鸽子单独放到远处，要知道"
    },
    {
      "id": "p0301",
      "zh": "坚实的陆地是否显露。但它飞遍四方，"
    },
    {
      "id": "p0302",
      "zh": "翅膀疲倦，又飞了回来；"
    },
    {
      "id": "p0303",
      "zh": "因为水仍未消退，"
    },
    {
      "id": "p0304",
      "zh": "各处还积满深水。"
    },
    {
      "id": "p0305",
      "zh": "他安静等候了几日，"
    },
    {
      "id": "p0306",
      "zh": "再次放出鸽子，要知道"
    },
    {
      "id": "p0307",
      "zh": "众水是否止息。它飞去，"
    },
    {
      "id": "p0308",
      "zh": "不停飞翔，越过大地，"
    },
    {
      "id": "p0309",
      "zh": "轻轻将身体停在湿润的地面上，"
    },
    {
      "id": "p0310",
      "zh": "然后再次回到挪亚那里，衔着"
    },
    {
      "id": "p0311",
      "zh": "一根橄榄枝，是传报消息的重要记号。"
    },
    {
      "id": "p0312",
      "zh": "众人心中都充满勇气，极其喜乐，"
    },
    {
      "id": "p0313",
      "zh": "因为他们盼望能看见陆地。"
    },
    {
      "id": "p0314",
      "zh": "此后，他又赶快放出"
    },
    {
      "id": "p0315",
      "zh": "另一只黑翅的鸟；"
    },
    {
      "id": "p0316",
      "zh": "它凭着翅膀，欣然飞去，"
    },
    {
      "id": "p0317",
      "zh": "到了陆地，便留在那里。"
    },
    {
      "id": "p0318",
      "zh": "挪亚就知道，陆地如今更近了。"
    },
    {
      "id": "p0319",
      "zh": "那神圣的船，在汹涌的浪涛上，"
    },
    {
      "id": "p0320",
      "zh": "随着海浪四处漂浮，"
    },
    {
      "id": "p0321",
      "zh": "终于停稳在狭窄的岸边。"
    },
    {
      "id": "p0322",
      "zh": "弗吕家那幽暗的大陆上，"
    },
    {
      "id": "p0323",
      "zh": "有一座陡峭高山，名叫亚拉腊，"
    },
    {
      "id": "p0324",
      "zh": "因为在那里，众人都要蒙救，"
    },
    {
      "id": "p0325",
      "zh": "脱离死亡，心里怀着深切的渴望；"
    },
    {
      "id": "p0326",
      "zh": "大河马尔叙阿斯的众水，就发源于此。"
    },
    {
      "id": "p0327",
      "zh": "洪水止息时，方舟停在"
    },
    {
      "id": "p0328",
      "zh": "那高峰上；随后，天上又传来"
    },
    {
      "id": "p0329",
      "zh": "伟大神圣洁的声音，"
    },
    {
      "id": "p0330",
      "zh": "宣告说：“挪亚，你这蒙保守、忠信、公义的人，"
    },
    {
      "id": "p0331",
      "zh": "要放胆出来，带着儿子们和你的妻子，"
    },
    {
      "id": "p0332",
      "zh": "并三个儿媳，遍满全地，"
    },
    {
      "id": "p0333",
      "zh": "生养众多，彼此按公义"
    },
    {
      "id": "p0334",
      "zh": "相待，世世代代如此，"
    },
    {
      "id": "p0335",
      "zh": "直到全人类各族"
    },
    {
      "id": "p0336",
      "zh": "来到审判面前，因为众人都要受审判。”"
    },
    {
      "id": "p0337",
      "zh": "神圣的声音这样说。挪亚受了鼓舞，"
    },
    {
      "id": "p0338",
      "zh": "就从卧处起来，赶快登上陆地，"
    },
    {
      "id": "p0339",
      "zh": "儿子、妻子、儿媳也与他同行，"
    },
    {
      "id": "p0340",
      "zh": "爬物、飞鸟、四足走兽，"
    },
    {
      "id": "p0341",
      "zh": "以及其余的一切，都从木屋出来，"
    },
    {
      "id": "p0342",
      "zh": "聚集一处。挪亚随后出来，"
    },
    {
      "id": "p0343",
      "zh": "是第八个人，也是人中最公义的；他在水上，"
    },
    {
      "id": "p0344",
      "zh": "已经满了两个二十日，再加一日，"
    },
    {
      "id": "p0345",
      "zh": "这是照大能之神的旨意。"
    },
    {
      "id": "p0346",
      "zh": "随后，新的生命一族再次兴起，"
    },
    {
      "id": "p0347",
      "zh": "最初是黄金的一代，实为自第一个"
    },
    {
      "id": "p0348",
      "zh": "被造之人出现以来，最美好的第六代；"
    },
    {
      "id": "p0349",
      "zh": "这一代名为属天的，因为神"
    },
    {
      "id": "p0350",
      "zh": "必照管万物。哦，第六世代最初的一族！"
    },
    {
      "id": "p0351",
      "zh": "哦，那时我也分享了何等大的喜乐，"
    },
    {
      "id": "p0352",
      "zh": "因为我逃过了彻底毁灭，虽然"
    },
    {
      "id": "p0353",
      "zh": "被波浪多次抛掷，与丈夫、丈夫的弟兄们，"
    },
    {
      "id": "p0354",
      "zh": "以及继父、继母，和丈夫"
    },
    {
      "id": "p0355",
      "zh": "弟兄的妻子们，一同受了可怕的苦。"
    },
    {
      "id": "p0356",
      "zh": "如今我要歌唱合宜的事：无花果树上，"
    },
    {
      "id": "p0357",
      "zh": "要开出多彩的花；"
    },
    {
      "id": "p0358",
      "zh": "此后，克罗诺斯要得着"
    },
    {
      "id": "p0359",
      "zh": "王权和统治。那时，三位心志宏大的王，"
    },
    {
      "id": "p0360",
      "zh": "最公义的人，要分配各人的产业，"
    },
    {
      "id": "p0361",
      "zh": "治理多年，秉行公义，"
    },
    {
      "id": "p0362",
      "zh": "善待那些勤于劳作、行仁爱之事的人。"
    },
    {
      "id": "p0363",
      "zh": "大地要因许多自然生长的果实"
    },
    {
      "id": "p0364",
      "zh": "而欢腾，为人类出产丰盛的粮食。"
    },
    {
      "id": "p0365",
      "zh": "那些养育者，终身不衰老，"
    },
    {
      "id": "p0366",
      "zh": "远离使人寒战、可怕的疾病，"
    },
    {
      "id": "p0367",
      "zh": "死去如同睡着；"
    },
    {
      "id": "p0368",
      "zh": "他们要往阿刻戎河去，进入"
    },
    {
      "id": "p0369",
      "zh": "阴间的居所，在那里"
    },
    {
      "id": "p0370",
      "zh": "得着尊荣，因为他们是一群"
    },
    {
      "id": "p0371",
      "zh": "蒙福的人，是有福的英雄；"
    },
    {
      "id": "p0372",
      "zh": "万军之主赐他们高贵的心思，"
    },
    {
      "id": "p0373",
      "zh": "常与他们分享自己的谋略。"
    },
    {
      "id": "p0374",
      "zh": "他们即使进入阴间，"
    },
    {
      "id": "p0375",
      "zh": "仍然有福。随后，又有"
    },
    {
      "id": "p0376",
      "zh": "另一代生于地上的人，强悍、专横，"
    },
    {
      "id": "p0377",
      "zh": "作为第二代兴起，就是提坦。他们都在"
    },
    {
      "id": "p0378",
      "zh": "形体、身高、成长上出众；他们要有"
    },
    {
      "id": "p0379",
      "zh": "同一种语言，如同起初第一代，"
    },
    {
      "id": "p0380",
      "zh": "神所植在他们心中的。但即使这些人，"
    },
    {
      "id": "p0381",
      "zh": "也怀着高傲的心，冲向"
    },
    {
      "id": "p0382",
      "zh": "毁灭，最终决意争战，"
    },
    {
      "id": "p0383",
      "zh": "攻击布满星辰的诸天。那时，"
    },
    {
      "id": "p0384",
      "zh": "大洋的洪流，要将狂暴的水"
    },
    {
      "id": "p0385",
      "zh": "倾倒在他们身上。但大能的"
    },
    {
      "id": "p0386",
      "zh": "万军之主，虽在怒中，却要止住烈怒，"
    },
    {
      "id": "p0387",
      "zh": "因为祂曾应许，不再使洪水"
    },
    {
      "id": "p0388",
      "zh": "临到心灵邪恶的人。"
    },
    {
      "id": "p0389",
      "zh": "当那发出高天雷声的伟大神，"
    },
    {
      "id": "p0390",
      "zh": "使无边上涨的众水，"
    },
    {
      "id": "p0391",
      "zh": "就是波浪四处高涨的众水，"
    },
    {
      "id": "p0392",
      "zh": "止息怒涛，减低水量，"
    },
    {
      "id": "p0393",
      "zh": "引往海中别的深处，设下界限，"
    },
    {
      "id": "p0394",
      "zh": "以港湾和崎岖海岬环绕大地；"
    },
    {
      "id": "p0395",
      "zh": "那时，伟大神的儿子也要"
    },
    {
      "id": "p0396",
      "zh": "披戴肉身，来到人间，形像"
    },
    {
      "id": "p0397",
      "zh": "如同地上的世人；祂的名包含"
    },
    {
      "id": "p0398",
      "zh": "四个元音，还有两个辅音，"
    },
    {
      "id": "p0399",
      "zh": "同一个辅音发声两次；我要说出整个数值："
    },
    {
      "id": "p0400",
      "zh": "八个一，再有同样数目的十，"
    },
    {
      "id": "p0401",
      "zh": "加上八百，就要向贪得无厌的人"
    },
    {
      "id": "p0402",
      "zh": "显明这名。你当用自己的"
    },
    {
      "id": "p0403",
      "zh": "悟性辨明，基督"
    },
    {
      "id": "p0404",
      "zh": "是不朽、至高之神的儿子。"
    },
    {
      "id": "p0405",
      "zh": "祂要成全神的律法，并不废去，"
    },
    {
      "id": "p0406",
      "zh": "带着神本有的形像，将一切事"
    },
    {
      "id": "p0407",
      "zh": "教导人。祭司要将礼物带到祂面前，"
    },
    {
      "id": "p0408",
      "zh": "献上黄金、没药、乳香；"
    },
    {
      "id": "p0409",
      "zh": "因为这一切事，祂也都要成就。"
    },
    {
      "id": "p0410",
      "zh": "当一个声音经过旷野，"
    },
    {
      "id": "p0411",
      "zh": "将消息带给众人，呼召所有人"
    },
    {
      "id": "p0412",
      "zh": "修直道路，从心中"
    },
    {
      "id": "p0413",
      "zh": "除去邪恶，又用水光照"
    },
    {
      "id": "p0414",
      "zh": "全人类的身体，"
    },
    {
      "id": "p0415",
      "zh": "使他们重生，从此不再"
    },
    {
      "id": "p0416",
      "zh": "丝毫偏离公义——"
    },
    {
      "id": "p0417",
      "zh": "却有一个心思野蛮、受舞蹈牵制的人，"
    },
    {
      "id": "p0418",
      "zh": "要将那［声音］斩断，作为赏赐——"
    },
    {
      "id": "p0419",
      "zh": "那时，忽然有一个记号"
    },
    {
      "id": "p0420",
      "zh": "显给世人：一块蒙看顾的"
    },
    {
      "id": "p0421",
      "zh": "美石，要从埃及地出来，"
    },
    {
      "id": "p0422",
      "zh": "希伯来民要因它跌倒；"
    },
    {
      "id": "p0423",
      "zh": "列国却要在祂引导之下"
    },
    {
      "id": "p0424",
      "zh": "聚集，因为他们也要借着祂，认识"
    },
    {
      "id": "p0425",
      "zh": "在高处掌权的神，在共同的光中"
    },
    {
      "id": "p0426",
      "zh": "看见道路。祂要向蒙拣选的人"
    },
    {
      "id": "p0427",
      "zh": "显明永生，却要将历世不息的火，"
    },
    {
      "id": "p0428",
      "zh": "降在无法无天的人身上。"
    },
    {
      "id": "p0429",
      "zh": "那时，祂要医治病弱的，"
    },
    {
      "id": "p0430",
      "zh": "以及一切有罪、却信靠祂的人。"
    },
    {
      "id": "p0431",
      "zh": "那时，瞎子要看见，瘸子要行走，"
    },
    {
      "id": "p0432",
      "zh": "聋子要听见，哑巴要说话。"
    },
    {
      "id": "p0433",
      "zh": "祂要赶出鬼魔，死人"
    },
    {
      "id": "p0434",
      "zh": "也要复活；祂要行走"
    },
    {
      "id": "p0435",
      "zh": "在波浪上；又要在旷野，"
    },
    {
      "id": "p0436",
      "zh": "用食物使五千人饱足，"
    },
    {
      "id": "p0437",
      "zh": "就是五个饼和海里的一条鱼，"
    },
    {
      "id": "p0438",
      "zh": "并将剩下的零碎，作为众民的盼望，"
    },
    {
      "id": "p0439",
      "zh": "装满十二个篮子。"
    },
    {
      "id": "p0440",
      "zh": "那时，以色列醉了，不能辨明，"
    },
    {
      "id": "p0441",
      "zh": "也不肯听，受软弱的忧虑压制。"
    },
    {
      "id": "p0442",
      "zh": "至高者狂烈的怒气，"
    },
    {
      "id": "p0443",
      "zh": "要临到希伯来人，夺去"
    },
    {
      "id": "p0444",
      "zh": "他们的信，因为他们杀害了"
    },
    {
      "id": "p0445",
      "zh": "天上神的儿子；以色列要掌掴祂，"
    },
    {
      "id": "p0446",
      "zh": "又用污秽的嘴，吐出带毒的唾沫。"
    },
    {
      "id": "p0447",
      "zh": "他们要给祂苦胆作食物，给祂纯醋，"
    },
    {
      "id": "p0448",
      "zh": "让祂喝；他们胸中、心里"
    },
    {
      "id": "p0449",
      "zh": "被邪恶的疯狂击中，不敬虔地这样行；"
    },
    {
      "id": "p0450",
      "zh": "他们有眼却看不见，比鼹鼠更盲，"
    },
    {
      "id": "p0451",
      "zh": "比爬行的毒兽更可怕，"
    },
    {
      "id": "p0452",
      "zh": "被沉睡紧紧捆住。但当祂"
    },
    {
      "id": "p0453",
      "zh": "展开双手，量度万有，"
    },
    {
      "id": "p0454",
      "zh": "戴上荆棘冠冕，他们要用芦苇"
    },
    {
      "id": "p0455",
      "zh": "刺祂的肋旁；为此，浓重黑夜"
    },
    {
      "id": "p0456",
      "zh": "要在白昼中持续三个小时。"
    },
    {
      "id": "p0457",
      "zh": "那时，所罗门的殿也要"
    },
    {
      "id": "p0458",
      "zh": "为人完成一个大记号，"
    },
    {
      "id": "p0459",
      "zh": "因为祂要往阴间的居所去，"
    },
    {
      "id": "p0460",
      "zh": "向死人宣告复活。"
    },
    {
      "id": "p0461",
      "zh": "三日以后，祂要再次"
    },
    {
      "id": "p0462",
      "zh": "来到光中，向人显出形貌，"
    },
    {
      "id": "p0463",
      "zh": "教导一切，乘云上升，"
    },
    {
      "id": "p0464",
      "zh": "往天上的居所去，"
    },
    {
      "id": "p0465",
      "zh": "将福音的约留给世界。"
    },
    {
      "id": "p0466",
      "zh": "在祂的名里，一株新芽要从"
    },
    {
      "id": "p0467",
      "zh": "那些受大能者律法"
    },
    {
      "id": "p0468",
      "zh": "引导的列国中萌发。此后，"
    },
    {
      "id": "p0469",
      "zh": "又要有智慧的引路人；再后来，"
    },
    {
      "id": "p0470",
      "zh": "先知将要止息。"
    },
    {
      "id": "p0471",
      "zh": "此后，希伯来民收割"
    },
    {
      "id": "p0472",
      "zh": "自己的恶果时，有一位罗马王，"
    },
    {
      "id": "p0473",
      "zh": "要将许多金银尽行毁坏。"
    },
    {
      "id": "p0474",
      "zh": "随后，王国倾覆，别的王权"
    },
    {
      "id": "p0475",
      "zh": "不断兴起，"
    },
    {
      "id": "p0476",
      "zh": "压迫世人。但当这些人开始"
    },
    {
      "id": "p0477",
      "zh": "显出不义的骄横时，"
    },
    {
      "id": "p0478",
      "zh": "他们必大大跌落。等到圣地中的"
    },
    {
      "id": "p0479",
      "zh": "所罗门圣殿倾倒，"
    },
    {
      "id": "p0480",
      "zh": "被身穿铜甲的蛮族人推毁，"
    },
    {
      "id": "p0481",
      "zh": "希伯来人就要被逐出本地，"
    },
    {
      "id": "p0482",
      "zh": "漂泊流离，衰残耗尽；他们在麦子中，"
    },
    {
      "id": "p0483",
      "zh": "掺入许多稗子；全人类之间，"
    },
    {
      "id": "p0484",
      "zh": "必有邪恶的争竞；"
    },
    {
      "id": "p0485",
      "zh": "遭受暴虐的城邑，要彼此哀哭，"
    },
    {
      "id": "p0486",
      "zh": "在胸中承受伟大神的烈怒，"
    },
    {
      "id": "p0487",
      "zh": "因为他们行了邪恶的事。"
    }
  ],
  "references": [
    "基督教典外文献（共10册）_手机版.txt，第24章西卜神谕卷一，4157行起；逐段对照参考，英文诗行与编号控制译文。"
  ],
  "notes": [
    "塔耳塔洛斯在希腊传统中指幽冥深渊；与原文Hades“阴间”分别保留。",
    "诗行中的Erebus译厄瑞玻斯，也是希腊传统中的幽冥称谓；Nereus涅柔斯为希腊海神之名，在本诗中与洪水海域相联系。",
    "原文第121诗行every other are依语境修正为art（技艺）；第267诗行bid the sun依云团遮光语境修正为hid；第314诗行flow依飞鸟语境修正为flew；第395诗行does hear依名字字母语境修正为does bear。",
    "神名谜题原文数值为十六个百、三个三十与七，合计1697；保留原数，不据中文参考本不同的数字改写。",
    "叙述者自称与丈夫、丈夫弟兄等同在方舟，原文又用stepfather、stepmother，按字面译继父、继母；参考本作公公、婆婆，未替换底本称谓。",
    "洪水后的亚拉腊山在本卷位于弗吕家；居方舟日数为两个二十日加一日，均依本卷保留。",
    "有关基督的叙述，原文明确为五饼一鱼，刺肋旁之物为reeds（芦苇）；未按正典改成两鱼或枪。"
  ]
}
