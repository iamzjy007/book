      "id": "p0001",
      "zh": "第二十七章"
    },
    {
      "id": "p0002",
      "zh": "第二十七王朝：来自波斯的八位王。"
    },
    {
      "id": "p0003",
      "zh": "1. 冈比西斯，从在位第五年起，统治埃及人三年。"
    },
    {
      "id": "p0004",
      "zh": "2. 玛吉祭司，七个月。"
    },
    {
      "id": "p0005",
      "zh": "3. 大利乌，三十六年。"
    },
    {
      "id": "p0006",
      "zh": "4. 大利乌的儿子薛西斯，二十一年。"
    },
    {
      "id": "p0007",
      "zh": "5. 亚达薛西，四十年。"
    },
    {
      "id": "p0008",
      "zh": "6. 薛西斯二世，两个月。"
    },
    {
      "id": "p0009",
      "zh": "7. 索格狄亚努斯，七个月。"
    },
    {
      "id": "p0010",
      "zh": "8. 薛西斯的儿子大利乌，十九年。"
    },
    {
      "id": "p0011",
      "zh": "9. 这些王合共在位一百二十年四个月。"
    }
  ],
