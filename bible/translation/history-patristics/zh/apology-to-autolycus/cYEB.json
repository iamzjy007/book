{
  "book_id": "apology-to-autolycus",
  "unit_id": "cYEB",
  "source_sha256": "a4317e5b5ed299a1793310d8780afa5597d5102d09c4dad79c5cc9dd8157d5a5",
  "reviewed": true,
  "blocks": [
    {
      "id": "p0001",
      "zh": "第三十六章"
    },
    {
      "id": "p0002",
      "zh": "西卜是希腊人和其他民族中间的女先知；她在预言开头责备人类，说："
    },
    {
      "id": "p0003",
      "zh": "你们为何仍这样轻易自高，"
    },
    {
      "id": "p0004",
      "zh": "又这样不顾生命的终局，"
    },
    {
      "id": "p0005",
      "zh": "你们这些属血肉、必死而算不得什么的人？"
    },
    {
      "id": "p0006",
      "zh": "你们不战兢，也不敬畏至高神吗？"
    },
    {
      "id": "p0007",
      "zh": "祂监察你们，无所不知，无所不见，"
    },
    {
      "id": "p0008",
      "zh": "常常保守那些"
    },
    {
      "id": "p0009",
      "zh": "最初由祂亲手所造的人；"
    },
    {
      "id": "p0010",
      "zh": "祂把甘美的灵放进自己一切所造的，"
    },
    {
      "id": "p0011",
      "zh": "又赐下这灵，引导必死的人。"
    },
    {
      "id": "p0012",
      "zh": "惟有一位非受造的神，"
    },
    {
      "id": "p0013",
      "zh": "独自掌权，全能而至大，"
    },
    {
      "id": "p0014",
      "zh": "在祂面前没有什么能隐藏。祂看见万有，"
    },
    {
      "id": "p0015",
      "zh": "自己却不被任何凡人的眼睛看见。"
    },
    {
      "id": "p0016",
      "zh": "必死的人能看见不朽的神吗？"
    },
    {
      "id": "p0017",
      "zh": "肉身的眼睛，连正午的"
    },
    {
      "id": "p0018",
      "zh": "日光也要避开，"
    },
    {
      "id": "p0019",
      "zh": "又怎能仰望那住在"
    },
    {
      "id": "p0020",
      "zh": "诸天之上的主？"
    },
    {
      "id": "p0021",
      "zh": "所以，要敬拜祂，那自有的神，"
    },
    {
      "id": "p0022",
      "zh": "那非受生、统管世界的主；"
    },
    {
      "id": "p0023",
      "zh": "自亘古以来，惟独祂存在，"
    },
    {
      "id": "p0024",
      "zh": "直到永远，祂仍长存。"
    },
    {
      "id": "p0025",
      "zh": "你们必收取恶谋的果子，"
    },
    {
      "id": "p0026",
      "zh": "因为你们没有尊荣真神，"
    },
    {
      "id": "p0027",
      "zh": "也没有向祂献上神圣的百牲祭。"
    },
    {
      "id": "p0028",
      "zh": "你们把礼物送给住在阴间的，"
    },
    {
      "id": "p0029",
      "zh": "又向鬼魔献祭。"
    },
    {
      "id": "p0030",
      "zh": "你们在狂妄与骄傲中"
    },
    {
      "id": "p0031",
      "zh": "行走；"
    },
    {
      "id": "p0032",
      "zh": "离弃正路，四处飘荡，"
    },
    {
      "id": "p0033",
      "zh": "迷失在陷阱和荆棘之中。"
    },
    {
      "id": "p0034",
      "zh": "愚昧的人哪，为何这样流荡？"
    },
    {
      "id": "p0035",
      "zh": "停止在幽黑的"
    },
    {
      "id": "p0036",
      "zh": "暗夜里徒然游荡吧；"
    },
    {
      "id": "p0037",
      "zh": "为何随从黑暗和无尽的幽冥，"
    },
    {
      "id": "p0038",
      "zh": "看哪，那蒙福的光"
    },
    {
      "id": "p0039",
      "zh": "正照耀着你们？"
    },
    {
      "id": "p0040",
      "zh": "看哪，祂光明清澈，毫无瑕疵。"
    },
    {
      "id": "p0041",
      "zh": "所以，要转离黑暗，"
    },
    {
      "id": "p0042",
      "zh": "仰望白昼；"
    },
    {
      "id": "p0043",
      "zh": "要有智慧，把智慧珍藏"
    },
    {
      "id": "p0044",
      "zh": "在心中。"
    },
    {
      "id": "p0045",
      "zh": "惟有一位神，差遣"
    },
    {
      "id": "p0046",
      "zh": "风和雨，"
    },
    {
      "id": "p0047",
      "zh": "地震、闪电，"
    },
    {
      "id": "p0048",
      "zh": "还有瘟疫，"
    },
    {
      "id": "p0049",
      "zh": "饥荒、暴雪，"
    },
    {
      "id": "p0050",
      "zh": "还有坚冰，"
    },
    {
      "id": "p0051",
      "zh": "以及临到我们这悲苦族类的一切灾祸。"
    },
    {
      "id": "p0052",
      "zh": "不但这些，其余的一切，"
    },
    {
      "id": "p0053",
      "zh": "也都是祂所赐；"
    },
    {
      "id": "p0054",
      "zh": "祂以全能治理天地，"
    },
    {
      "id": "p0055",
      "zh": "从永远就自有。"
    },
    {
      "id": "p0056",
      "zh": "至于那些据说是生出来的［神］，她这样说："
    },
    {
      "id": "p0057",
      "zh": "一切生出来的，若也都要死，"
    },
    {
      "id": "p0058",
      "zh": "神就不可能由必死的人生出。"
    },
    {
      "id": "p0059",
      "zh": "惟有一位至高无上的主，"
    },
    {
      "id": "p0060",
      "zh": "创造了诸天，"
    },
    {
      "id": "p0061",
      "zh": "以及其中的星辰万象，"
    },
    {
      "id": "p0062",
      "zh": "太阳和月亮；也造了"
    },
    {
      "id": "p0063",
      "zh": "丰饶的大地，"
    },
    {
      "id": "p0064",
      "zh": "洋海的波浪和山冈，"
    },
    {
      "id": "p0065",
      "zh": "泉源与永不停流的江河；"
    },
    {
      "id": "p0066",
      "zh": "祂也创造了数不尽的"
    },
    {
      "id": "p0067",
      "zh": "海中生物，又使"
    },
    {
      "id": "p0068",
      "zh": "地上、海中一切爬物存活；"
    },
    {
      "id": "p0069",
      "zh": "祂造了善歌的群鸟，"
    },
    {
      "id": "p0070",
      "zh": "它们振翅划过长空，"
    },
    {
      "id": "p0071",
      "zh": "发出尖细的鸣啭，"
    },
    {
      "id": "p0072",
      "zh": "在清晨唱出温柔、"
    },
    {
      "id": "p0073",
      "zh": "清亮的歌。"
    },
    {
      "id": "p0074",
      "zh": "在群山幽深的林间，"
    },
    {
      "id": "p0075",
      "zh": "祂安置了"
    },
    {
      "id": "p0076",
      "zh": "凶猛的兽类；又为人"
    },
    {
      "id": "p0077",
      "zh": "使一切牲畜顺服，使那"
    },
    {
      "id": "p0078",
      "zh": "按神形像所造的人，统管万有，"
    },
    {
      "id": "p0079",
      "zh": "把许多难以领会的事物，"
    },
    {
      "id": "p0080",
      "zh": "置于人的权下。"
    },
    {
      "id": "p0081",
      "zh": "因为凡人有谁能知道"
    },
    {
      "id": "p0082",
      "zh": "这一切呢？"
    },
    {
      "id": "p0083",
      "zh": "惟有起初造它们的主知道；"
    },
    {
      "id": "p0084",
      "zh": "祂是创造者，不朽坏的主，"
    },
    {
      "id": "p0085",
      "zh": "永远居于高天；"
    },
    {
      "id": "p0086",
      "zh": "祂将极丰厚的赏赐赐给善人，"
    },
    {
      "id": "p0087",
      "zh": "却向邪恶、不义之人，"
    },
    {
      "id": "p0088",
      "zh": "兴起报应、忿怒和流血的战争，"
    },
    {
      "id": "p0089",
      "zh": "又有瘟疫和许多令人流泪的苦难。"
    },
    {
      "id": "p0090",
      "zh": "虚妄自高的人哪，说吧，为何这样"
    },
    {
      "id": "p0091",
      "zh": "彻底毁坏你自己？"
    },
    {
      "id": "p0092",
      "zh": "你把兽类当作神敬拜，"
    },
    {
      "id": "p0093",
      "zh": "难道不羞愧吗？"
    },
    {
      "id": "p0094",
      "zh": "你相信众神竟会偷走"
    },
    {
      "id": "p0095",
      "zh": "你的牲畜，"
    },
    {
      "id": "p0096",
      "zh": "或者需要你的器皿；这岂不是"
    },
    {
      "id": "p0097",
      "zh": "最无益、最愚昧的疯狂念头吗？"
    },
    {
      "id": "p0098",
      "zh": "你的众神并未住在金色诸天，"
    },
    {
      "id": "p0099",
      "zh": "你却看见它们成了"
    },
    {
      "id": "p0100",
      "zh": "虫子的食物，"
    },
    {
      "id": "p0101",
      "zh": "又被成群污秽、不洁的生物侵蚀。"
    },
    {
      "id": "p0102",
      "zh": "愚昧的人哪！你们敬拜蛇、狗，"
    },
    {
      "id": "p0103",
      "zh": "还有猫，"
    },
    {
      "id": "p0104",
      "zh": "飞鸟和地上、海里的"
    },
    {
      "id": "p0105",
      "zh": "爬物，"
    },
    {
      "id": "p0106",
      "zh": "人手所造的像、石头雕成的像，"
    },
    {
      "id": "p0107",
      "zh": "以及堆在路旁的垃圾。"
    },
    {
      "id": "p0108",
      "zh": "这些以及许多更虚妄的东西，"
    },
    {
      "id": "p0109",
      "zh": "你们都去事奉，"
    },
    {
      "id": "p0110",
      "zh": "敬拜那些连名字也羞于提起的东西。"
    },
    {
      "id": "p0111",
      "zh": "正是这些神，使虚妄的人走迷了路，"
    },
    {
      "id": "p0112",
      "zh": "从它们口中流出的，"
    },
    {
      "id": "p0113",
      "zh": "是致命毒液的溪流。"
    },
    {
      "id": "p0114",
      "zh": "但惟独在祂里面有生命，"
    },
    {
      "id": "p0115",
      "zh": "有生命和永不熄灭、永恒的光；"
    },
    {
      "id": "p0116",
      "zh": "祂向人的生命之杯倾注喜乐，"
    },
    {
      "id": "p0117",
      "zh": "尝起来比最甜的蜜更甜——"
    },
    {
      "id": "p0118",
      "zh": "向祂俯首，单单向祂，"
    },
    {
      "id": "p0119",
      "zh": "行在永远平安的道路上。"
    },
    {
      "id": "p0120",
      "zh": "你们却离弃祂，都偏向别处，"
    },
    {
      "id": "p0121",
      "zh": "在疯狂的愚妄中，喝尽了"
    },
    {
      "id": "p0122",
      "zh": "那毫不掺杂、公义之杯，纯净，"
    },
    {
      "id": "p0123",
      "zh": "强烈，势不可挡；"
    },
    {
      "id": "p0124",
      "zh": "你们仍不愿重新清醒，"
    },
    {
      "id": "p0125",
      "zh": "仍不愿回到清明的心，"
    },
    {
      "id": "p0126",
      "zh": "认识你们的神和王，"
    },
    {
      "id": "p0127",
      "zh": "那鉴察万有的主。"
    },
    {
      "id": "p0128",
      "zh": "因此，烈火必临到你们，"
    },
    {
      "id": "p0129",
      "zh": "你们必长久地日日在火焰中焚烧，"
    },
    {
      "id": "p0130",
      "zh": "长久因你们无用的众神蒙羞。"
    },
    {
      "id": "p0131",
      "zh": "那些敬拜永恒之神的人，"
    },
    {
      "id": "p0132",
      "zh": "必承受永远的生命，"
    },
    {
      "id": "p0133",
      "zh": "住在繁花盛开的福乐之境，"
    },
    {
      "id": "p0134",
      "zh": "享用甘美的食物，"
    },
    {
      "id": "p0135",
      "zh": "从星光灿烂的天上赐下。"
    },
    {
      "id": "p0136",
      "zh": "这些话真实、有益、公义，对所有人都有益处，是显而易见的。就连诗人，也曾论到恶人所受的刑罚。"
    }
  ],
  "references": [
    "bible/基督教典外文献（共10册）_手机版.txt：检索奥托吕、奥托利、提阿非罗、Theophilus、Autolycus；仅见他篇人名及第51686行对安提阿提阿非罗的间接提及，未见本书对应正文。依英文独立翻译。"
  ],
  "notes": [
    "第二卷第三十六章“百牲祭”（hecatombs）指以百牲为名的盛大祭献；原文如此，保留而不改写为作者其他段落的献祭立场。引诗依英文各行保留，不套用其他西卜版本。"
  ]
}
