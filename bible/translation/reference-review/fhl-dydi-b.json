  "changes": [
    {
      "book": "1-maccabees",
      "chapter": 3,
      "unit": "c960",
      "block": "p0044",
      "before": "便彼此说：“我们要重建百姓所遭的毁坏，为百姓和圣所争战！”",
      "after": "便彼此说：“我们要使我们遭毁坏的百姓重新兴起，为百姓和圣所争战！”",
      "reason": "raise up the ruin of our people指使遭毁坏的百姓复兴；保留毁坏与重建含义，不将民族整体处境收窄为物质废墟。"
    },
    {
      "book": "1-maccabees",
      "chapter": 4,
      "unit": "c968",
      "block": "p0020",
      "before": "犹大正说完这些话，就有一部分敌人从山上探望。",
      "after": "犹大正说完这些话，就有一部分敌人从山上向下瞭望。",
      "reason": "looking out指察看战场，探望通常指访人，造成动作误读。"
    },
    {
      "book": "1-maccabees",
      "chapter": 6,
      "unit": "c96S",
      "block": "p0003",
      "before": "其中的庙宇极其富有，藏着金盾、胸甲和兵器，都是马其顿王腓力的儿子亚历山大，就是首先在希腊人中作王的那位，留在那里的。",
      "after": "其中的庙宇极其富有，藏着金盾、胸甲和兵器，都是腓力的儿子、马其顿王亚历山大，就是首先在希腊人中作王的那位，留在那里的。",
      "reason": "Macedonian king同位修饰亚历山大，调整中文避免错接在腓力之前。"
    },
    {
      "book": "1-maccabees",
      "chapter": 9,
      "unit": "c97G",
      "block": "p0007",
